# ================================
# SafyaClinic Project .gitattributes
# ================================

# Default: enforce LF for all text files
* text=auto eol=lf

# ----------------
# Source code files
# ----------------
*.cs      text eol=lf
*.cshtml  text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.config  text eol=lf

# ----------------
# Frontend assets
# ----------------
*.css     text eol=lf
*.scss    text eol=lf
*.js      text eol=lf
*.ts      text eol=lf
*.html    text eol=lf

# ----------------
# Documentation
# ----------------
*.md      text eol=lf
*.txt     text eol=lf

# ----------------
# Windows-specific scripts
# ----------------
*.bat     text eol=crlf
*.cmd     text eol=crlf

# ----------------
# Shell scripts (Unix style)
# ----------------
*.sh      text eol=lf

# ----------------
# Binary files (no conversion)
# ----------------
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.dll     binary
*.exe     binary