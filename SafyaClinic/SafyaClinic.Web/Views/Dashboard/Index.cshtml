@using SafyaClinic.Application.DTOs.Reservation
@{
    ViewData["Title"] = "Dashboard";
    var todayReservations = (ViewBag.TodayReservations as IEnumerable<ReservationSummaryDto>) ?? Enumerable.Empty<ReservationSummaryDto>();
    var todayRevenue = ViewBag.TodayRevenue ?? 0m;
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-primary-soft">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Today's Reservations</div>
                    <div class="fs-3 fw-bold">@todayReservations.Count()</div>
                </div>
                <i class="bi bi-calendar2-week fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-teal-soft">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Today's Revenue</div>
                    <div class="fs-3 fw-bold">@todayRevenue.ToString("C")</div>
                </div>
                <i class="bi bi-cash-coin fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-amber-soft">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Pending</div>
                    <div class="fs-3 fw-bold">@todayReservations.Count(r => r.StatusName == "Pending")</div>
                </div>
                <i class="bi bi-hourglass-split fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-rose-soft">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="small opacity-75">Unpaid</div>
                    <div class="fs-3 fw-bold">@todayReservations.Count(r => !r.IsPaid)</div>
                </div>
                <i class="bi bi-exclamation-circle fs-1 opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar2-week me-2"></i>Today's Reservations</span>
        <a asp-controller="Reservations" asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Reservation
        </a>
    </div>
    <div class="card-body p-0">
        @if (!todayReservations.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>
                No reservations scheduled for today.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Paid</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in todayReservations.OrderBy(r => r.ReservationTime))
                        {
                            <tr>
                                <td>@r.ReservationTime.ToString(@"hh\:mm")</td>
                                <td>@r.PatientName</td>
                                <td>@r.DoctorName</td>
                                <td><span class="badge bg-secondary">@r.Category</span></td>
                                <td>
                                    <span class="badge" style="background-color:@r.StatusColor;color:#fff;">@r.StatusName</span>
                                </td>
                                <td>
                                    @if (r.IsPaid)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
