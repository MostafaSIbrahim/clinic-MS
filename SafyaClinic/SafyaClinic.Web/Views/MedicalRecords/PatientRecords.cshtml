@model IEnumerable<PatientRecordDto>
@{
    ViewData["Title"] = "Medical Records";
    var patientId = ViewBag.PatientId;
}

<div class="card">
    <div class="page-toolbar card-header d-flex justify-content-between align-items-center">
        @* Review fix: keep the heading outside phrasing-only span markup. *@
        <h1 class="mb-0"><i class="bi bi-file-medical me-2" aria-hidden="true"></i>Medical Records</h1>
        <a asp-action="Create" asp-route-patientId="@patientId" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Record
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-file-earmark-x fs-1 d-block mb-2 opacity-50"></i>
                No medical records yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr><th>Date</th><th>Doctor</th><th>Category</th><th>Diagnosis</th><th>Locked</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@r.DoctorName</td>
                                <td><span class="badge bg-secondary">@r.Category</span></td>
                                <td>@(r.Diagnosis ?? "—")</td>
                                <td>@(r.IsLocked ? "🔒" : "—")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>View Record
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
