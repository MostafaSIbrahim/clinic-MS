@model PatientRecordDto
@{
    ViewData["Title"] = "Medical Record";
}

<div class="page-toolbar d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="mb-0">Medical record #@Model.Id</h1>
        <span class="badge @(Model.IsLocked ? "bg-secondary" : "bg-success")">
            @(Model.IsLocked ? "Locked" : "Editable")
        </span>

      
        <small class="text-muted">@Model.PatientName • @Model.CreatedAt.ToString("dd MMM yyyy")</small>
    </div>
    <div class="page-actions d-flex flex-wrap gap-2 align-items-start">
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Patient
            </a>
            <a asp-controller="Reservations" asp-action="Queue"
               class="btn btn-outline-secondary">Back to Queue</a>

    
        @if (Model.ReservationId.HasValue)
        {
            <a asp-controller="Reservations" asp-action="Details"
               asp-route-id="@Model.ReservationId.Value"
               class="btn btn-sm btn-outline-primary">
                View Reservation
            </a>
        }

        @if (ViewBag.CanCompleteConsultation is bool canComplete && canComplete)
        {
        
            <form asp-action="CompleteConsultation" method="post" class="d-inline"
                  onsubmit="return confirm('Complete this consultation? The reservation will be marked completed.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-success">
                    <i class="bi bi-check-circle me-1"></i>Complete Consultation
                </button>
            </form>
        }

            @if(!Model.IsLocked)
            {
                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        More Actions
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                    
                            <li>
                                <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                            </li>
                    
                        @if (User.IsInRole("Admin") && !Model.IsLocked)
                        {
                            <li>
                                @* Lock form moved whole — NOT wrapped in another form *@
                                <form asp-action="Lock" asp-route-id="@Model.Id" method="post"
                                      onsubmit="return confirm('Lock this record? It cannot be edited afterwards.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="bi bi-lock me-1"></i>Lock Record
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            }
            @* Review fix: close only the Razor condition; do not render a stray parenthesis. *@
    
    </div>
</div>

<nav class="workspace-shortcuts" aria-label="Record sections">
    <a href="#record-clinical" class="btn btn-outline-secondary">
        <i class="bi bi-clipboard2-data me-1"></i>Clinical notes
    </a>
    <a href="#record-treatments" class="btn btn-outline-secondary">
        <i class="bi bi-bandaid me-1"></i>Treatments
    </a>
    <a href="#record-prescriptions" class="btn btn-outline-secondary">
        <i class="bi bi-capsule-pill me-1"></i>Prescriptions
    </a>
    <a href="#record-analyses" class="btn btn-outline-secondary">
        <i class="bi bi-clipboard2-pulse me-1"></i>Analyses
    </a>
</nav>

<div class="row g-3">
    <div class="col-md-7">
        <div class="card mb-3">
            <div class="card-header" id="record-clinical"><h2 class="h5 mb-0"><i class="bi bi-clipboard2-data me-2"></i>Clinical Notes</h2></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-4 text-muted">Category</dt>
                    <dd class="col-8"><span class="badge bg-secondary">@Model.Category</span></dd>
                    <dt class="col-4 text-muted">Chief Complaint</dt>
                    <dd class="col-8 clinical-text">@(Model.ChiefComplaint ?? "—")</dd>
                    <dt class="col-4 text-muted">History</dt>
                    <dd class="col-8 clinical-text">@(Model.PresentIllnessHistory ?? "—")</dd>
                    <dt class="col-4 text-muted">Diagnosis</dt>
                    <dd class="col-8 clinical-text">@(Model.Diagnosis ?? "—")</dd>
                    <dt class="col-4 text-muted">Differential Dx</dt>
                    <dd class="col-8 clinical-text">@(Model.DifferentialDiagnosis ?? "—")</dd>
                    <dt class="col-4 text-muted">Treatment Plan</dt>
                    <dd class="col-8 clinical-text">@(Model.TreatmentPlan ?? "—")</dd>
                    <dt class="col-4 text-muted">Notes</dt>
                    <dd class="col-8 clinical-text">@(Model.Notes ?? "—")</dd>
                    <dt class="col-4 text-muted">Follow-up Date</dt>
                    <dd class="col-8">@(Model.FollowUpDate?.ToString("dd MMM yyyy") ?? "—")</dd>
                </dl>
            </div>
        </div>

        <!-- ── Treatments ── -->
        <div class="card mb-3" id="record-treatments">
            <div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-bandaid me-2"></i>Treatments</h2></div>
            <div class="card-body">
                @if (!Model.Treatments.Any())
                {
                    <p class="text-muted small mb-3">No treatments recorded.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var t in Model.Treatments)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <div>
                                    <strong>@t.Description</strong>
                                    <div class="small text-muted">@t.PerformedDate.ToString("dd MMM yyyy") @(t.Cost != null ? $"• {t.Cost:C}" : "")</div>
                                </div>
                                @if (!Model.IsLocked)
                                {
                                    <form asp-action="RemoveTreatment" method="post" onsubmit="return confirm('Remove this treatment?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="treatmentId" value="@t.Id" />
                                        <input type="hidden" name="recordId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (!Model.IsLocked)
                {
                    <form asp-action="AddTreatment" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="recordId" value="@Model.Id" />
                        <div class="col-md-7">
                            <input type="text" name="Description" class="form-control form-control-sm" placeholder="Description" required />
                        </div>
                        <div class="col-md-3">
                            <input type="number" step="0.01" name="Cost" class="form-control form-control-sm" placeholder="Cost" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-outline-primary w-100"><i class="bi bi-plus"></i></button>
                        </div>
                    </form>
                }
            </div>
        </div>
        <!-- ── Prescriptions ── -->
        <div class="card mb-3" id="record-prescriptions">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 class="h5 mb-0"><i class="bi bi-capsule-pill me-2"></i>Prescriptions</h2>
                @if (!Model.IsLocked)
                {
                    <a asp-action="CreatePrescription" asp-route-recordId="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-plus-lg me-1"></i>New Prescription
                    </a>
                }
            </div>
            <div class="card-body">
                @{
                    var prescriptions = ViewBag.Prescriptions as IEnumerable<PrescriptionListDto>
                        ?? Enumerable.Empty<PrescriptionListDto>();
                }
                @if (!prescriptions.Any())
                {
                    <p class="text-muted small mb-0">No prescriptions added.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var p in prescriptions)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                                <div>
                                    <div class="fw-bold">Prescription #@p.Id</div>
                                    <div class="small text-muted">
                                        @p.PrescriptionDate.ToString("dd MMM yyyy") • @p.DrugCount drug(s)
                                        @if (!string.IsNullOrWhiteSpace(p.Notes))
                                        {
                                            <span>• @p.Notes</span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2 align-items-center">
                                    <a asp-action="PrescriptionDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                    <a asp-action="PrintPrescription" asp-route-prescriptionId="@p.Id" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-printer me-1"></i>Print
                                    </a>
                                    @if (p.IsPrinted)
                                    {
                                        <span class="badge bg-success">Printed</span>
                                    }
                                    else
                                    {
                                        <form asp-action="MarkPrescriptionPrinted" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="prescriptionId" value="@p.Id" />
                                            <input type="hidden" name="recordId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-link p-0"><i class="bi bi-check2"></i> Mark Printed</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header"><h2 class="h5 mb-0"><i class="bi bi-clipboard2-data me-2"></i>Order Analyses</h2></div>
            <div class="card-body">
                <a asp-controller="Analysis" asp-action="Request"
                   asp-route-patientId="@Model.PatientId" asp-route-recordId="@Model.Id"
                   class="btn btn-sm btn-outline-info w-100">
                   <i class="bi bi-plus-lg me-1"></i>Request Medical Analysis
                </a>
            </div>
        </div>

        @* Review fix: match the Analyses shortcut's fragment exactly. *@
        <div class="card" id="record-analyses">
            <div class="card-header"><i class="bi bi-clipboard2-data me-2"></i>Analyses from this Record</div>
            <div class="card-body">
                @{
                    var recordAnalyses = ViewBag.Analyses as IEnumerable<SafyaClinic.Application.DTOs.Analysis.MedicalAnalysisDto>
                        ?? Enumerable.Empty<SafyaClinic.Application.DTOs.Analysis.MedicalAnalysisDto>();
                }
                @if (!recordAnalyses.Any())
                {
                    <p class="text-muted small mb-0">No analyses requested from this record yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var a in recordAnalyses)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <span>@a.AnalysisTypeName <span class="badge bg-secondary ms-1">@a.Status</span></span>
                                <a asp-controller="Analysis" asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>Open Analysis
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AttachmentPreviewModal")

@section Scripts {
    <script src="~/js/medicine-autocomplete.js"></script>
    <script>
        (function () {
            const medInput = document.getElementById('medicationNameInput');
            const dosageInput = document.getElementById('dosageInput');
            if (medInput) {
                attachMedicineAutocomplete(medInput, {
                    minLength: 2,
                    onSelect: function (med) {
                        medInput.value = med.tradeName;
                        // Only prefill dosage if the doctor hasn't already typed one.
                        if (dosageInput && !dosageInput.value) {
                            dosageInput.value = med.strength || '';
                        }
                    }
                });
            }
        })();
    </script>
}
