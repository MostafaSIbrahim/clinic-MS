@model PatientRecordDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    ViewData["Title"] = "Medical Record";
    // P5b: the consultation workspace. One page with tabs (Notes · Treatments · Prescriptions · Lab);
    // the visit bar with Complete visit stays visible on every tab.
    var tab = ViewBag.Tab as string ?? SafyaClinic.Web.Models.VisitTabs.Notes;
    var canWrite = !Model.IsLocked && await Can.HasAsync(Permissions.Records.Write);
    var canComplete = ViewBag.CanCompleteConsultation is bool complete && complete;
    var prescriptions = (ViewBag.Prescriptions as IEnumerable<PrescriptionListDto> ?? Enumerable.Empty<PrescriptionListDto>()).ToList();
    var analyses = (ViewBag.Analyses as IEnumerable<SafyaClinic.Application.DTOs.Analysis.MedicalAnalysisDto>
        ?? Enumerable.Empty<SafyaClinic.Application.DTOs.Analysis.MedicalAnalysisDto>()).ToList();
    var treatments = Model.Treatments.ToList();
    var treatmentsTitle = $"{T["Treatments"].Value} ({treatments.Count})";
    var prescriptionsTitle = $"{T["Prescriptions"].Value} ({prescriptions.Count})";
    var labTitle = $"{T["Lab"].Value} ({analyses.Count})";
}

@await Component.InvokeAsync("PatientHeader", new { patientId = Model.PatientId })

<div class="visit-bar" role="region" aria-label="@T["Visit"]">
    <div class="visit-bar__title">
        <h1 class="h4 mb-0">@T["Medical record #{0}", Model.Id]</h1>
        <span class="badge @(Model.IsLocked ? "bg-secondary" : "bg-success")">@(Model.IsLocked ? T["Locked"] : T["Editable"])</span>
        <small class="text-muted">@Model.CreatedAt.ToString("dd MMM yyyy")</small>
    </div>
    <div class="visit-bar__actions">
        @if (canComplete)
        {
            <form asp-action="CompleteConsultation" method="post" class="d-inline"
                  data-confirm="@T["Complete this visit? The reservation will be marked completed."]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" value="@Model.Id" />
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1" aria-hidden="true"></i>@T["Complete visit"]
                </button>
            </form>
        }
        <a asp-controller="Reservations" asp-action="Queue" class="btn btn-outline-secondary">
            <i class="bi bi-list-ol me-1" aria-hidden="true"></i>@T["Back to queue"]
        </a>
        <div class="dropdown">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                @T["More actions"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId">
                        <i class="bi bi-person me-1" aria-hidden="true"></i>@T["Back to patient"]
                    </a>
                </li>
                @if (Model.ReservationId.HasValue)
                {
                    <li>
                        <a class="dropdown-item" asp-controller="Reservations" asp-action="Details" asp-route-id="@Model.ReservationId.Value">
                            <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>@T["View reservation"]
                        </a>
                    </li>
                }
                @if (!Model.IsLocked && await Can.HasAsync(Permissions.Records.Lock))
                {
                    <li>
                        <form asp-action="Lock" asp-route-id="@Model.Id" method="post"
                              data-confirm="@T["Lock this record? It cannot be edited afterwards."]">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item text-danger">
                                <i class="bi bi-lock me-1" aria-hidden="true"></i>@T["Lock record"]
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<app-tabs label="@T["Visit sections"]" id="visit" selected="@tab" data-tab-param="tab">
    <app-tab id="notes" title="@T["Notes"]">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <span class="badge bg-secondary">@Labels.Humanize(Model.Category)</span>
            @if (canWrite)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>@T["Edit notes"]
                </a>
            }
        </div>
        <dl class="visit-notes">
            <dt>@T["Chief complaint"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.ChiefComplaint ?? "—")</dd>
            <dt>@T["History"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.PresentIllnessHistory ?? "—")</dd>
            <dt>@T["Diagnosis"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.Diagnosis ?? "—")</dd>
            <dt>@T["Differential diagnosis"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.DifferentialDiagnosis ?? "—")</dd>
            <dt>@T["Treatment plan"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.TreatmentPlan ?? "—")</dd>
            <dt>@T["Notes"]</dt>
            <dd class="clinical-text" dir="auto">@(Model.Notes ?? "—")</dd>
            <dt>@T["Follow-up date"]</dt>
            <dd>@(Model.FollowUpDate?.ToString("dd MMM yyyy") ?? "—")</dd>
        </dl>
    </app-tab>

    <app-tab id="treatments" title="@treatmentsTitle">
        @if (treatments.Count == 0)
        {
            <p class="text-muted mb-3">@T["No treatments recorded."]</p>
        }
        else
        {
            <ul class="list-group list-group-flush mb-3">
                @foreach (var t in treatments)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                        <div>
                            <strong dir="auto">@t.Description</strong>
                            <div class="small text-muted">@t.PerformedDate.ToString("dd MMM yyyy") @(t.Cost != null ? $"• {t.Cost.Value.ToMoney()}" : "")</div>
                        </div>
                        @if (canWrite)
                        {
                            <form asp-action="RemoveTreatment" method="post" data-confirm="@T["Remove this treatment?"]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="treatmentId" value="@t.Id" />
                                <input type="hidden" name="recordId" value="@Model.Id" />
                                <button type="submit" class="btn btn-link text-danger" aria-label="@T["Remove"]"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
        @if (canWrite)
        {
            <form asp-action="AddTreatment" method="post" class="visit-add-row">
                @Html.AntiForgeryToken()
                <input type="hidden" name="recordId" value="@Model.Id" />
                <label class="visually-hidden" for="treatment-description">@T["Description"]</label>
                <input id="treatment-description" type="text" name="Description" class="form-control" placeholder="@T["Description"]" required />
                <label class="visually-hidden" for="treatment-cost">@T["Cost"]</label>
                <input id="treatment-cost" type="number" step="0.01" min="0" name="Cost" class="form-control" placeholder="@T["Cost"]" />
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T["Add treatment"]</button>
            </form>
        }
    </app-tab>

    <app-tab id="prescriptions" title="@prescriptionsTitle">
        @if (canWrite)
        {
            <a asp-action="CreatePrescription" asp-route-recordId="@Model.Id" class="btn btn-primary mb-3">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T["New prescription"]
            </a>
        }
        @if (prescriptions.Count == 0)
        {
            <p class="text-muted mb-0">@T["No prescriptions yet."]</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var p in prescriptions)
                {
                    <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center gap-2 px-0">
                        <div>
                            <div class="fw-bold">@T["Prescription #{0}", p.Id]</div>
                            <div class="small text-muted">
                                @p.PrescriptionDate.ToString("dd MMM yyyy") • @T["{0} drug(s)", p.DrugCount]
                                @if (!string.IsNullOrWhiteSpace(p.Notes))
                                {
                                    <span dir="auto">• @p.Notes</span>
                                }
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <a asp-action="PrescriptionDetails" asp-route-id="@p.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye me-1" aria-hidden="true"></i>@T["Details"]
                            </a>
                            <a asp-action="PrintPrescription" asp-route-prescriptionId="@p.Id" target="_blank" class="btn btn-outline-primary">
                                <i class="bi bi-printer me-1" aria-hidden="true"></i>@T["Print"]
                            </a>
                            @if (p.IsPrinted)
                            {
                                <span class="badge bg-success">@T["Printed"]</span>
                            }
                            else
                            {
                                <form asp-action="MarkPrescriptionPrinted" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="prescriptionId" value="@p.Id" />
                                    <input type="hidden" name="recordId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-link"><i class="bi bi-check2" aria-hidden="true"></i> @T["Mark printed"]</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </app-tab>

    <app-tab id="lab" title="@labTitle">
        @if (await Can.HasAsync(Permissions.Analyses.Manage))
        {
            <p class="text-muted small mb-2">@T["Lab tests open on their own page; when you finish, you come back to this visit."]</p>
            <a asp-controller="Analysis" asp-action="Request"
               asp-route-patientId="@Model.PatientId" asp-route-recordId="@Model.Id"
               class="btn btn-primary mb-3">
                <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T["Request lab tests"]
            </a>
        }
        @if (analyses.Count == 0)
        {
            <p class="text-muted mb-0">@T["No lab tests requested from this visit yet."]</p>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var a in analyses)
                {
                    <li class="list-group-item px-0 d-flex justify-content-between align-items-center gap-2">
                        <span>@a.AnalysisTypeName <span class="badge bg-secondary ms-1">@a.Status</span></span>
                        <a asp-controller="Analysis" asp-action="Details" asp-route-id="@a.Id" class="btn btn-outline-primary">
                            <i class="bi bi-eye me-1" aria-hidden="true"></i>@T["Open"]
                        </a>
                    </li>
                }
            </ul>
        }
    </app-tab>
</app-tabs>

@await Html.PartialAsync("_AttachmentPreviewModal")
