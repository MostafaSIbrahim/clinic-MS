@model PrescriptionPrintDto
@{
    ViewData["Title"] = "Print Prescription";
    Layout = null;

    string paperSize = ViewBag.PaperSize ?? "A4";
    string design = ViewBag.Design ?? "classic";

    // Physical page dimensions per paper size, used for @page and the on-screen preview.
    var pageDims = paperSize switch
    {
        "A5" => "148mm 210mm",
        "Letter" => "8.5in 11in",
        _ => "210mm 297mm" // A4 default
    };
    var pageWidth = paperSize switch
    {
        "A5" => "148mm",
        "Letter" => "8.5in",
        _ => "210mm"
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Prescription — @Model.PatientName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        @@page { size: @pageDims; margin: 12mm; }

        :root {
            --accent: #0d6efd;
            --font-body: Arial, Helvetica, sans-serif;
            --font-heading: Arial, Helvetica, sans-serif;
        }
        /* ── Design presets — swap colors/typography/borders only ── */
        .design-classic  { --accent: #14532d; --font-heading: Georgia, 'Times New Roman', serif; }
        .design-modern   { --accent: #0d6efd; --font-heading: 'Segoe UI', Arial, sans-serif; }
        .design-minimal  { --accent: #212529; --font-heading: Arial, sans-serif; }

        body {
            font-family: var(--font-body);
            background: #eee;
        }
        .sheet {
            width: @pageWidth;
            margin: 20px auto;
            background: #fff;
            padding: 14mm 12mm;
            box-shadow: 0 0 8px rgba(0,0,0,.15);
        }
        .rx-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 3px solid var(--accent);
            padding-bottom: 10px;
            margin-bottom: 16px;
        }
        .rx-header h2 { font-family: var(--font-heading); color: var(--accent); margin: 0; }
        .design-minimal .rx-header { border-bottom: 1px solid var(--accent); }
        .rx-symbol {
            font-family: var(--font-heading);
            font-size: 2.2rem;
            color: var(--accent);
            font-weight: bold;
            line-height: 1;
        }
        .patient-bar {
            display: flex;
            justify-content: space-between;
            background: #f4f8f4;
            background: color-mix(in srgb, var(--accent) 8%, white);
            border: 1px solid #cfe0cf;
            border: 1px solid color-mix(in srgb, var(--accent) 25%, white);
            border-radius: 4px;
            padding: 8px 12px;
            margin-bottom: 20px;
            font-size: .9rem;
        }
        .design-minimal .patient-bar { background: none; border: none; border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; border-radius: 0; }
        .rx-body { min-height: 45vh; font-size: 1.05rem; }
        .rx-footer {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            font-size: .85rem;
            border-top: 1px solid #ccc;
            padding-top: 8px;
            color: #666;
        }
        .signature-line {
            margin-top: 60px;
            width: 220px;
            border-top: 1px solid #333;
            text-align: center;
            font-size: .8rem;
            padding-top: 4px;
        }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .sheet { margin: 0 auto; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="no-print container py-3">
        <form method="get" class="row g-2 align-items-end mb-2">
            <input type="hidden" name="prescriptionId" value="@Model.Id" />
            <div class="col-auto">
                <label class="form-label small mb-0">Paper Size</label>
                <select name="paperSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="A4" selected="@(paperSize == "A4")">A4</option>
                    <option value="A5" selected="@(paperSize == "A5")">A5</option>
                    <option value="Letter" selected="@(paperSize == "Letter")">Letter</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-0">Design</label>
                <select name="design" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="classic" selected="@(design == "classic")">Classic</option>
                    <option value="modern" selected="@(design == "modern")">Modern</option>
                    <option value="minimal" selected="@(design == "minimal")">Minimal</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i>Print
                </button>
            </div>
        </form>
    </div>

    <div class="sheet design-@design">
        <div class="rx-header">
            <div>
                <h2>@ViewBag.ClinicName</h2>
                <div class="small text-muted">@ViewBag.ClinicTagline</div>
                <div class="small text-muted">@ViewBag.ClinicAddress</div>
                <div class="small text-muted">@ViewBag.ClinicPhone @(ViewBag.ClinicEmail != null ? $"• {ViewBag.ClinicEmail}" : "")</div>
            </div>
            <div class="text-end">
                <div class="rx-symbol">℞</div>
                <div class="small text-muted">@Model.CreatedAt.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <div class="patient-bar">
            <span><strong>Patient:</strong> @Model.PatientName</span>
            <span><strong>Age/Gender:</strong> @(Model.PatientAge?.ToString() ?? "—") / @(Model.PatientGender ?? "—")</span>
            <span><strong>Diagnosis:</strong> @(Model.Diagnosis ?? "—")</span>
        </div>

        <div class="rx-body">
            <h5 class="mb-2">@Model.MedicationName</h5>
            <table class="table table-borderless table-sm mb-3" style="max-width:500px;">
                <tr><td class="text-muted" style="width:130px;">Dosage</td><td>@(Model.Dosage ?? "—")</td></tr>
                <tr><td class="text-muted">Frequency</td><td>@(Model.Frequency ?? "—")</td></tr>
                <tr><td class="text-muted">Duration</td><td>@(Model.Duration ?? "—")</td></tr>
                <tr><td class="text-muted">Route</td><td>@(Model.RouteOfAdministration ?? "—")</td></tr>
            </table>
            @if (!string.IsNullOrWhiteSpace(Model.Instructions))
            {
                <p><strong>Instructions:</strong> @Model.Instructions</p>
            }
        </div>

        <div class="signature-line ms-auto">
            Dr. @Model.DoctorName
            @if (!string.IsNullOrWhiteSpace(Model.DoctorSpecialization))
            {
                <div>@Model.DoctorSpecialization</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DoctorLicenseNumber))
            {
                <div>Lic. #@Model.DoctorLicenseNumber</div>
            }
        </div>

        <div class="rx-footer">
            <span>Prescription #@Model.Id</span>
            <span>This prescription is valid only when signed by the prescribing physician.</span>
        </div>
    </div>
</body>
</html>
