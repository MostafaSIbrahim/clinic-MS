@model PrescriptionPrintDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using System.Globalization
@{
    ViewData["Title"] = "Print Prescription";
    Layout = null;

    // M3b: the printout is bilingual whatever the language of the person printing: each heading in English and
    // Arabic (Arabic from the resource file), drug names and instructions as the doctor wrote them.
    string Ar(string english, params object[] args)
    {
        var current = CultureInfo.CurrentUICulture;
        CultureInfo.CurrentUICulture = new CultureInfo("ar");
        try { return T[english, args].Value; }
        finally { CultureInfo.CurrentUICulture = current; }
    }
    string En(string english, params object[] args) => string.Format(CultureInfo.InvariantCulture, english, args);
    Microsoft.AspNetCore.Html.IHtmlContent Bi(string english, params object[] args) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            $"<span lang=\"en\">{System.Net.WebUtility.HtmlEncode(En(english, args))}</span> <span class=\"rx-ar\" lang=\"ar\" dir=\"rtl\">{System.Net.WebUtility.HtmlEncode(Ar(english, args))}</span>");
    string RouteText(string? stored) => SafyaClinic.Application.Clinical.AdministrationRoutes.Label(stored) is { } label
        ? (SafyaClinic.Application.Clinical.AdministrationRoutes.All.Any(r => r.Label == label) ? $"{label} / {Ar(label)}" : label)
        : "—";
    string GenderText(string? g) => g is null ? "—" : $"{g} / {Ar(g)}";

    string paperSize = ViewBag.PaperSize ?? "A4";
    string design = ViewBag.Design ?? "classic";

    // Physical page dimensions per paper size, used for @page and the on-screen preview.
    var pageDims = paperSize switch
    {
        "A5" => "148mm 210mm",
        "Letter" => "8.5in 11in",
        _ => "210mm 297mm" // A4 default
    };
    var pageWidth = paperSize switch
    {
        "A5" => "148mm",
        "Letter" => "8.5in",
        _ => "210mm"
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Prescription — @Model.PatientName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    @* Branding: add the shared letterhead without changing the selected prescription design. *@
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    <style>
        @@page { size: (A4,Letter); margin: 12mm; }

        :root {
            --accent: #0d6efd;
            --font-body: Arial, Helvetica, sans-serif;
            --font-heading: Arial, Helvetica, sans-serif;
        }
        /* ── Design presets — swap colors/typography/borders only ── */
        .design-classic  { --accent: #14532d; --font-heading: Georgia, 'Times New Roman', serif; }
        .design-modern   { --accent: #0d6efd; --font-heading: 'Segoe UI', Arial, sans-serif; }
        .design-minimal  { --accent: #212529; --font-heading: Arial, sans-serif; }

        body {
            font-family: var(--font-body);
            background: #eee;
        }
        .sheet {
            width: @pageWidth;
            margin: 20px auto;
            background: #fff;
            padding: 14mm 12mm;
            box-shadow: 0 0 8px rgba(0,0,0,.15);
        }
        .rx-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 3px solid var(--accent);
            padding-bottom: 10px;
            margin-bottom: 16px;
        }
        .rx-header h2 { font-family: var(--font-heading); color: var(--accent); margin: 0; }
        .design-minimal .rx-header { border-bottom: 1px solid var(--accent); }
        .rx-symbol {
            font-family: var(--font-heading);
            font-size: 2.2rem;
            color: var(--accent);
            font-weight: bold;
            line-height: 1;
        }
        .patient-bar {
            display: flex;
            justify-content: space-between;
            background: #f4f8f4;
            background: color-mix(in srgb, var(--accent) 8%, white);
            border: 1px solid #cfe0cf;
            border: 1px solid color-mix(in srgb, var(--accent) 25%, white);
            border-radius: 4px;
            padding: 8px 12px;
            margin-bottom: 20px;
            font-size: .9rem;
        }
        .design-minimal .patient-bar { background: none; border: none; border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; border-radius: 0; }
        .rx-body { min-height: 45vh; font-size: 1.05rem; }
        .rx-footer {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            font-size: .85rem;
            border-top: 1px solid #ccc;
            padding-top: 8px;
            color: #666;
        }
        .rx-ar { font-weight: normal; color: #555; }
        th .rx-ar, strong .rx-ar { display: block; font-size: .85em; }
        .signature-line {
            margin-top: 60px;
            width: 220px;
            border-top: 1px solid #333;
            text-align: center;
            font-size: .8rem;
            padding-top: 4px;
        }
        @@media print {
            .no-print { display: none !important; }
            body { background: #fff; }
            .sheet { margin: 0 auto; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="no-print container py-3">
        <form method="get" class="row g-2 align-items-end mb-2">
            <input type="hidden" name="prescriptionId" value="@Model.Id" />
            <div class="col-auto">
                <label for="paperSize" class="form-label small mb-0">@T["Paper size"]</label>
                <select id="paperSize" name="paperSize" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="A4" selected="@(paperSize == "A4")">A4</option>
                    <option value="A5" selected="@(paperSize == "A5")">A5</option>
                    <option value="Letter" selected="@(paperSize == "Letter")">Letter</option>
                </select>
            </div>
            <div class="col-auto">
                <label for="printDesign" class="form-label small mb-0">@T["Design"]</label>
                <select id="printDesign" name="design" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="classic" selected="@(design == "classic")">@T["Classic"]</option>
                    <option value="modern" selected="@(design == "modern")">@T["Modern"]</option>
                    <option value="minimal" selected="@(design == "minimal")">@T["Minimal"]</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1" aria-hidden="true"></i>@T["Print"]
                </button>
            </div>
        </form>
    </div>

    <div class="sheet design-@design">
        <div class="rx-header">
            <div>
                @* Branding: retain the configured clinic name, address and contact details below the logo. *@
                @await Html.PartialAsync("_ClinicLogo", "clinic-logo--print")
                <h2>@ViewBag.ClinicName</h2>
                <div class="small text-muted">@ViewBag.ClinicTagline</div>
                <div class="small text-muted">@ViewBag.ClinicAddress</div>
                <div class="small text-muted">@ViewBag.ClinicPhone @(ViewBag.ClinicEmail != null ? $"• {ViewBag.ClinicEmail}" : "")</div>
            </div>
            <div class="text-end">
                <div class="rx-symbol">℞</div>
                <div class="small text-muted">@Model.PrescriptionDate.ToString("dd MMM yyyy")</div>
            </div>
        </div>

        <div class="patient-bar">
            <span><strong>@Bi("Patient")</strong> <span dir="auto">@Model.PatientName</span></span>
            <span><strong>@Bi("Age")</strong> @(Model.PatientAge?.ToString() ?? "—") · <strong>@Bi("Gender")</strong> @GenderText(Model.PatientGender)</span>
            <span><strong>@Bi("Diagnosis")</strong> <span dir="auto">@(Model.Diagnosis ?? "—")</span></span>
        </div>

        <div class="rx-body">
            <table class="table table-borderless">
                <thead>
                    <tr class="border-bottom">
                        <th>#</th>
                        <th>@Bi("Medication")</th>
                        <th>@Bi("Dosage")</th>
                        <th>@Bi("Frequency")</th>
                        <th>@Bi("Duration")</th>
                        <th>@Bi("Route")</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int idx = 1;
                    }
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@idx</td>
                            <td><strong dir="auto">@item.MedicationName</strong></td>
                            <td dir="auto">@(item.Dosage ?? "—")</td>
                            <td dir="auto">@(item.Frequency ?? "—")</td>
                            <td dir="auto">@(item.Duration ?? "—")</td>
                            <td>@RouteText(item.RouteOfAdministration)</td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(item.Instructions))
                        {
                            <tr>
                                <td></td>
                                <td colspan="5" class="text-muted small" dir="auto">↳ @item.Instructions</td>
                            </tr>
                        }
                        idx++;
                    }
                </tbody>
            </table>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="mt-3 p-2 border-top">
                    <strong>@Bi("Notes")</strong> <span dir="auto">@Model.Notes</span>
                </div>
            }
        </div>

        <div class="signature-line ms-auto">
            <span dir="auto">@T["Dr. {0}", Model.DoctorName]</span>
            @if (!string.IsNullOrWhiteSpace(Model.DoctorSpecialization))
            {
                <div>@Model.DoctorSpecialization</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DoctorLicenseNumber))
            {
                <div>@Bi("Licence no. {0}", Model.DoctorLicenseNumber)</div>
            }
        </div>

        <div class="rx-footer">
            <span>@Bi("Prescription #{0}", Model.Id)</span>
            <span>@Bi("This prescription is valid only when signed by the prescribing physician.")</span>
        </div>
    </div>
</body>
</html>
