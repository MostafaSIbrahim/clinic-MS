@model UpdatePatientRecordRequest
@{
    ViewData["Title"] = "Edit Medical Record";
}

<div class="card" style="max-width:800px;">
    <div class="card-header"><i class="bi bi-pencil me-2"></i>Edit Medical Record</div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            @* Review fix: show property-binding errors as well as service errors. *@
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>

            <fieldset class="mb-4">
                <legend class="h5">Visit classification</legend>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FollowUpDate" class="form-label">Follow-up Date</label>
                        <input asp-for="FollowUpDate" type="date" class="form-control" />
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">Presenting complaint</legend>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="ChiefComplaint" class="form-label">Chief Complaint</label>
                        <textarea asp-for="ChiefComplaint" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="PresentIllnessHistory" class="form-label">Present Illness History</label>
                        <textarea asp-for="PresentIllnessHistory" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">Diagnosis</legend>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Diagnosis" class="form-label">Diagnosis</label>
                        <textarea asp-for="Diagnosis" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="DifferentialDiagnosis" class="form-label">Differential Diagnosis</label>
                        <textarea asp-for="DifferentialDiagnosis" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">Plan</legend>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="TreatmentPlan" class="form-label">Treatment Plan</label>
                        <textarea asp-for="TreatmentPlan" class="form-control" rows="4"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Notes</label>
                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                    </div>
                </div>
            </fieldset>

            <div class="form-actions mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
