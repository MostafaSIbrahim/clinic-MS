@model UpdatePatientRecordRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M3a: edit a medical record. Shared form fields, the patient header with allergies, English and Arabic.
    ViewData["Title"] = T["Edit medical record"].Value;
    var recordId = ViewContext.RouteData.Values["id"];
}
<div class="page-toolbar">
    <div><h1>@T["Edit medical record"]</h1></div>
</div>

@if (ViewBag.PatientId is int patientId)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId })
}

<div class="card record-form-card">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            @* Review fix: show property-binding errors as well as service errors. *@
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>

            <fieldset class="mb-4">
                <legend class="h5">@T["Visit"]</legend>
                <div class="row g-3">
                    <div class="col-md-6"><app-field asp-for="FollowUpDate" label="@T["Follow-up date"].Value" type="date" /></div>
                </div>
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">@T["Presenting complaint"]</legend>
                <app-field asp-for="ChiefComplaint" label="@T["Chief complaint"].Value" type="textarea" rows="4" hint="@T["In the patient's words."].Value" />
                <app-field asp-for="PresentIllnessHistory" label="@T["History of present illness"].Value" type="textarea" rows="4" />
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">@T["Diagnosis"]</legend>
                <app-field asp-for="Diagnosis" label="@T["Diagnosis"].Value" type="textarea" rows="4" />
                <app-field asp-for="DifferentialDiagnosis" label="@T["Differential diagnosis"].Value" type="textarea" rows="4" />
            </fieldset>

            <fieldset class="mb-4">
                <legend class="h5">@T["Plan"]</legend>
                <app-field asp-for="TreatmentPlan" label="@T["Treatment plan"].Value" type="textarea" rows="4" hint="@T["Medicines go on the record's Prescriptions tab."].Value" />
                <app-field asp-for="Notes" label="@T["Notes"].Value" type="textarea" rows="4" />
            </fieldset>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Save changes"]</button>
                <a asp-action="Details" asp-route-id="@recordId" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
