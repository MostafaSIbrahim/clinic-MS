@model CreatePrescriptionRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    ViewData["Title"] = "New Prescription";
}

@if (ViewData["PatientId"] is int patientId)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId })
}

<h4>New Prescription</h4>
<p class="text-muted">Record #@Model.RecordId</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="CreatePrescription" method="post" data-allergy-check>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="RecordId" />

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Prescription Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="General notes for this prescription..."></textarea>
    </div>

    <h5>Drugs</h5>
    <div id="drugs-container"></div>

    <button type="button" class="btn btn-sm btn-outline-secondary mb-3" onclick="addDrugRow()">
        <i class="bi bi-plus-lg"></i> Add Drug
    </button>

    <partial name="_AllergyConfirm" model="@(ViewData["AllergyMatches"] as IReadOnlyList<SafyaClinic.Application.Clinical.AllergyMatch>)" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save Prescription</button>
        <a asp-action="Details" asp-route-id="@Model.RecordId" asp-route-tab="prescriptions" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/medicine-autocomplete.js" asp-append-version="true"></script>
    <script>
        // P9a: the route is chosen from the list.
        const routeOptions = @Html.Raw(Json.Serialize(
            new[] { new { value = "", label = T["Route"].Value } }
                .Concat(SafyaClinic.Application.Clinical.AdministrationRoutes.All.Select(r => new { value = r.Value, label = T[r.Label].Value }))));
        const drugMessages = {
            noMatch: @Json.Serialize(T["No matching drug in the list. You can type the name."].Value),
            unavailable: @Json.Serialize(T["Drug suggestions are unavailable right now. You can type the name."].Value)
        };
    </script>
    <script>
        let drugIndex = 0;
        // P5a: after a refusal (e.g. an allergy warning) the drugs already entered are shown again.
        const enteredDrugs = @Json.Serialize(Model.Items);

        function addDrugRow(drug) {
            const container = document.getElementById('drugs-container');
            const html = `
                        <div class="card mb-2 drug-row" data-index="${drugIndex}">
                            <div class="card-body py-2">
                                <div class="row g-2">
                                    <div class="col-md-3 position-relative">
                                        <input type="text" name="Items[${drugIndex}].MedicationName" class="form-control form-control-sm med-input" placeholder="Medication" required />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="Items[${drugIndex}].Dosage" class="form-control form-control-sm dosage-input" placeholder="Dosage" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="Items[${drugIndex}].Frequency" class="form-control form-control-sm" placeholder="Frequency" />
                                    </div>
                                    <div class="col-md-2">
                                        <input type="text" name="Items[${drugIndex}].Duration" class="form-control form-control-sm" placeholder="Duration" />
                                    </div>
                                    <div class="col-md-2">
                                        <select name="Items[${drugIndex}].RouteOfAdministration" class="form-select form-select-sm" aria-label="@T["Route"]">
                                            ${routeOptions.map(o => `<option value="${o.value}">${o.label}</option>`).join('')}
                                        </select>
                                    </div>
                                    <div class="col-md-1">
                                        <button type="button" class="btn btn-sm btn-link text-danger" onclick="this.closest('.drug-row').remove()">
                                            <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Remove this drug</span>
                                        </button>
                                    </div>
                                </div>
                                <div class="mt-1">
                                    <input type="text" name="Items[${drugIndex}].Instructions" class="form-control form-control-sm" placeholder="Special instructions" />
                                </div>
                            </div>
                        </div>
                    `;
            container.insertAdjacentHTML('beforeend', html);

            const newRow = container.lastElementChild;
            if (drug) {
                ['medicationName', 'dosage', 'frequency', 'duration', 'routeOfAdministration', 'instructions'].forEach(function (key) {
                    const pascal = key.charAt(0).toUpperCase() + key.slice(1);
                    const field = newRow.querySelector('[name$=".' + pascal + '"]');
                    const value = drug[key] ?? drug[pascal];
                    if (field && value) field.value = value;
                });
            }
            const medInput = newRow.querySelector('.med-input');
            const dosageInput = newRow.querySelector('.dosage-input');
            attachMedicineAutocomplete(medInput, {
                minLength: 2,
                messages: drugMessages,
                onSelect: function (med) {
                    medInput.value = med.tradeName;
                    medInput.dispatchEvent(new Event('input', { bubbles: true }));   // P5a: re-check allergies
                    if (dosageInput && !dosageInput.value) {
                        dosageInput.value = med.strength || '';
                            }
                        }
                    });

                    drugIndex++;
                }

                if (enteredDrugs && enteredDrugs.length) enteredDrugs.forEach(function (d) { addDrugRow(d); });
                else addDrugRow();
    </script>
    <script src="~/js/allergy-check.js" asp-append-version="true"></script>
}