@model PagedResult<UserDto>
@{
    ViewData["Title"] = "Users";
    // F4d: users join permission groups; the clinician type decides who appears in doctor pickers.
    var allGroups = (ViewBag.AllGroups as IEnumerable<PermissionGroupSummary>
        ?? Enumerable.Empty<PermissionGroupSummary>()).ToList();
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-person-gear me-2"></i>System Users</span>
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-person-plus me-1"></i>Add User
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>
                No users found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Specialization</th>
                            <th>Groups</th>
                            <th>Clinician</th>
                            <th>Status</th>
                            <th>Last Login</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@u.FullName</td>
                                <td>@u.PhoneNumber</td>
                                <td>@(u.Email ?? "—")</td>
                                <td>@(u.Specialization ?? "—")</td>
                                <td>
                                    @foreach (var groupName in u.Groups)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">
                                            @groupName
                                            @if (allGroups.FirstOrDefault(g => g.Name == groupName) is { } memberGroup)
                                            {
                                                <form asp-action="RemoveFromGroup" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@u.Id" />
                                                    <input type="hidden" name="groupId" value="@memberGroup.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 ms-1"
                                                            style="font-size:.75rem;" aria-label="Remove from @groupName"
                                                            onclick="return confirm('Remove this user from the group?')">×</button>
                                                </form>
                                            }
                                        </span>
                                    }
                                    <div class="dropdown d-inline">
                                        <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="dropdown" aria-label="Add to a group">
                                            <i class="bi bi-plus-circle text-primary"></i>
                                        </button>
                                        <ul class="dropdown-menu p-2" style="min-width:200px;">
                                            @foreach (var g in allGroups.Where(g => !u.Groups.Contains(g.Name)))
                                            {
                                                <li>
                                                    <form asp-action="AddToGroup" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="userId" value="@u.Id" />
                                                        <input type="hidden" name="groupId" value="@g.Id" />
                                                        <button type="submit" class="dropdown-item small">@g.Name</button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                                <td>
                                    <form asp-action="SetClinicianType" method="post" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <label for="clinician-@u.Id" class="visually-hidden">Clinician type</label>
                                        <select id="clinician-@u.Id" name="clinicianType" class="form-select form-select-sm" style="min-width:8rem;"
                                                onchange="if (confirm('Change the clinician type? The user will be asked to sign in again.')) this.form.submit(); else this.form.reset();">
                                            @foreach (var type in Enum.GetValues<SafyaClinic.Domain.Enums.ClinicianType>())
                                            {
                                                <option value="@type" selected="@(u.ClinicianType == type)">@type</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="small text-muted">@(u.LastLoginAt is DateTime lastLogin ? Clock.ToClinicTime(lastLogin).ToString("dd MMM yyyy HH:mm") : "Never")</td>
                                <td class="text-end">
                                    <form asp-action="ToggleActive" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <input type="hidden" name="isActive" value="@(u.IsActive ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @if (u.IsActive)
                                            {
                                                <text><i class="bi bi-slash-circle"></i> Deactivate</text>
                                            }
                                            else
                                            {
                                                <text><i class="bi bi-check-circle"></i> Activate</text>
                                            }
                                        </button>
                                    </form>
                                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary ms-1">
                                        <i class="bi bi-key" aria-hidden="true"></i> Reset password
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
