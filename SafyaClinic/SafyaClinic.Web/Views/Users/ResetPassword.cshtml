@model ResetPasswordRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M5b: reset a user's password. Shared fields, English and Arabic. Rules unchanged (F4).
    ViewData["Title"] = T["Reset password"].Value;
    string userName = ViewBag.UserName as string ?? "";
}
<div class="page-toolbar">
    <div>
        <h1>@T["Reset password"]</h1>
        <p class="text-muted mb-0" dir="auto">@userName</p>
    </div>
</div>

<div class="card record-form-card">
    <div class="card-body">
        <p class="text-muted">@T["Set a temporary password and give it to the user. They must choose their own password at their next sign-in. This also unlocks the account."]</p>
        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>
            <app-field asp-for="NewPassword" label="@T["Temporary password"].Value" type="password" required="true" hint="@T["At least 10 characters."].Value" />
            <app-field asp-for="ConfirmPassword" label="@T["Confirm password"].Value" type="password" required="true" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Reset password"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
