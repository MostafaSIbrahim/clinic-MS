@model CreateUserRequest
@{
    ViewData["Title"] = "Add User";
    var allRoles = new[]
    {
        (Id: 1, Name: "Admin"),
        (Id: 2, Name: "Doctor"),
        (Id: 3, Name: "Reception"),
        (Id: 4, Name: "Patient"),
        (Id: 5, Name: "Nutritionist")
    };
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>Add System User</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Full Name *</label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone Number *</label>
                    <input asp-for="PhoneNumber" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Password *</label>
                    <input asp-for="Password" type="password" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Specialization" class="form-label">Specialization</label>
                    <input asp-for="Specialization" class="form-control" placeholder="e.g. Internal Medicine, Nutrition" />
                </div>
                <div class="col-md-6">
                    <label asp-for="LicenseNumber" class="form-label">License Number</label>
                    <input asp-for="LicenseNumber" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Roles *</label>
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var role in allRoles)
                        {
                            <div class="form-check">
                                <input type="checkbox" name="RoleIds" value="@role.Id" class="form-check-input" id="role_@role.Id" />
                                <label class="form-check-label" for="role_@role.Id">@role.Name</label>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create User</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
