@model IEnumerable<PatientEnrollmentDto>
@{
    ViewData["Title"] = "Nutrition Enrollments";
    var patientId = ViewBag.PatientId;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-capsule me-2"></i>Nutrition Enrollments</span>
        <a asp-action="Enroll" asp-route-patientId="@patientId" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Enroll in Package
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-capsule fs-1 d-block mb-2 opacity-50"></i>
                No enrollments yet.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr><th>Package</th><th>Doctor</th><th>Start</th><th>End</th><th>Final Price</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>@e.PackageName</td>
                            <td>@e.DoctorName</td>
                            <td>@e.StartDate.ToString("dd MMM yyyy")</td>
                            <td>@e.EndDate.ToString("dd MMM yyyy")</td>
                            <td>@e.FinalPrice.ToString("C")</td>
                            <td>
                                @{
                                    var cls = e.Status switch
                                    {
                                        "Active" => "bg-success",
                                        "Completed" => "bg-primary",
                                        "Cancelled" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @cls">@e.Status</span>
                            </td>
                            <td class="text-end">
                                <a asp-action="EnrollmentDetails" asp-route-id="@e.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
