@model WeeklyFollowUpDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M4b: one weekly follow-up. Shared layout, the patient header, English and Arabic. Edit and Delete are
    // shown to people who manage nutrition; Delete only on the latest week (the server checks again).
    ViewData["Title"] = T["Week {0} follow-up", Model.WeekNumber].Value;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var enrollment = ViewBag.Enrollment as PatientEnrollmentDto;
    var canManage = await Can.HasAsync(Permissions.Nutrition.Manage);
    var cancelled = enrollment?.Status == "Cancelled";
    var isLatest = enrollment == null || enrollment.WeeklyFollowUps.Max(f => (int?)f.WeekNumber) == Model.WeekNumber;
    string N(decimal? v, string unitKey) => v is decimal d ? T[unitKey, d.ToString("0.##", inv)].Value : "—";
}
<div class="page-toolbar">
    <div>
        <h1>@T["Week {0} follow-up", Model.WeekNumber]</h1>
        <p class="text-muted mb-0">
            @Model.FollowUpDate.ToString("dd MMM yyyy", inv)
            @if (enrollment != null)
            {
                <span> · </span><span dir="auto">@enrollment.PackageName</span>
            }
            @if (Model.IsCompleted)
            {
                <span> · </span><span class="app-status app-status--completed">@T["Completed"]</span>
            }
        </p>
    </div>
    <div class="page-actions">
        @if (canManage && !cancelled)
        {
            @if (!Model.IsCompleted)
            {
                <form asp-action="CompleteFollowUp" asp-route-id="@Model.Id" asp-route-enrollmentId="@Model.EnrollmentId" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">@T["Mark completed"]</button>
                </form>
            }
            <a asp-action="EditFollowUp" asp-route-id="@Model.Id" class="btn btn-outline-primary">@T["Edit"]</a>
            @if (isLatest)
            {
                <form asp-action="DeleteFollowUp" method="post" class="d-inline" data-confirm="@T["Delete the week {0} follow-up?", Model.WeekNumber]">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="enrollmentId" value="@Model.EnrollmentId" />
                    <button type="submit" class="btn btn-outline-danger">@T["Delete"]</button>
                </form>
            }
        }
        <a asp-action="EnrollmentDetails" asp-route-id="@Model.EnrollmentId" class="btn btn-outline-secondary">@T["Back to the enrollment"]</a>
    </div>
</div>

@if (enrollment != null)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId = enrollment.PatientId })
}

<div class="row g-3 followup-details">
    <div class="col-lg-6">
        <app-card id="followup-measurements" title="@T["Measurements"].Value" level="2" icon="bi-speedometer2">
            <dl class="row mb-0">
                <dt class="col-6">@T["Weight"]</dt><dd class="col-6">@N(Model.WeightKg, "{0} kg")</dd>
                <dt class="col-6">@T["Height"]</dt><dd class="col-6">@N(Model.HeightCm, "{0} cm")</dd>
                <dt class="col-6">@T["BMI"]</dt><dd class="col-6">@(Model.BMI?.ToString("0.0", inv) ?? "—")</dd>
                <dt class="col-6">@T["Body fat"]</dt><dd class="col-6">@(Model.BodyFatPercent is decimal bf ? bf.ToString("0.##", inv) + "%" : "—")</dd>
                <dt class="col-6">@T["Muscle mass"]</dt><dd class="col-6">@N(Model.MuscleMassKg, "{0} kg")</dd>
                <dt class="col-6">@T["Waist"]</dt><dd class="col-6">@N(Model.WaistCircumferenceCm, "{0} cm")</dd>
                <dt class="col-6">@T["Blood pressure"]</dt><dd class="col-6" dir="ltr">@(Model.BloodPressure ?? "—")</dd>
            </dl>
        </app-card>

        <app-card id="followup-notes" title="@T["Clinical notes"].Value" level="2" icon="bi-journal-text">
            <dl class="row mb-0">
                <dt class="col-sm-5">@T["Diet compliance"]</dt><dd class="col-sm-7">@(Model.DietCompliance is { } dc ? T[dc].Value : "—")</dd>
                <dt class="col-sm-5">@T["Side effects"]</dt><dd class="col-sm-7 clinical-text" dir="auto">@(Model.SideEffects ?? T["None reported"].Value)</dd>
                <dt class="col-sm-5">@T["Doctor's notes"]</dt><dd class="col-sm-7 clinical-text" dir="auto">@(Model.DoctorNotes ?? "—")</dd>
                <dt class="col-sm-5">@T["Next week's adjustments"]</dt><dd class="col-sm-7 clinical-text" dir="auto">@(Model.NextWeekAdjustments ?? "—")</dd>
            </dl>
        </app-card>
    </div>

    <div class="col-lg-6">
        <app-card id="followup-items" title="@T["Given this week"].Value" level="2" icon="bi-capsule">
            @if (!Model.AdministeredItems.Any())
            {
                <p class="text-muted small mb-0">@T["Nothing recorded."]</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var a in Model.AdministeredItems)
                    {
                        <li class="mb-2">
                            <strong dir="auto">@a.ItemName</strong> · @a.ActualQuantity.ToString("0.##", inv)
                            @if (!string.IsNullOrWhiteSpace(a.Notes))
                            {
                                <span class="text-muted" dir="auto"> · @a.Notes</span>
                            }
                            <div class="small text-muted">
                                <span dir="auto">@(string.IsNullOrEmpty(a.AdministeredByName) ? "—" : a.AdministeredByName)</span> ·
                                @Clock.ToClinicTime(DateTime.SpecifyKind(a.AdministeredAt, DateTimeKind.Utc)).ToString("dd MMM yyyy HH:mm", inv)
                            </div>
                        </li>
                    }
                </ul>
            }
        </app-card>

        <app-card id="followup-labs" title="@T["Lab results"].Value" level="2" icon="bi-clipboard2-pulse">
            @if (!string.IsNullOrWhiteSpace(Model.LabResultsSummary))
            {
                <p class="clinical-text" dir="auto">@Model.LabResultsSummary</p>
            }
            @if (!Model.LabResults.Any())
            {
                <p class="text-muted small mb-0">@T["No lab results recorded."]</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var l in Model.LabResults)
                    {
                        <li class="d-flex justify-content-between gap-2 mb-2">
                            <div>
                                <strong dir="auto">@l.AnalysisTypeName</strong>
                                <div class="small text-muted" dir="auto">
                                    @(l.ResultValue ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(l.ReferenceRange))
                                    {
                                        <span>(@T["reference {0}", l.ReferenceRange])</span>
                                    }
                                </div>
                            </div>
                            @if (l.IsNormal.HasValue)
                            {
                                <span class="app-status @(l.IsNormal == true ? "app-status--completed" : "app-status--due")">@(l.IsNormal == true ? T["Normal"] : T["Abnormal"])</span>
                            }
                        </li>
                    }
                </ul>
            }
        </app-card>
    </div>
</div>
