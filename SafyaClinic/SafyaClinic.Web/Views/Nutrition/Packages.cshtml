@model IEnumerable<NutritionPackageDto>
@{
    ViewData["Title"] = "Nutrition Packages";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-capsule me-2"></i>Nutrition Packages</span>
        @if (User.IsInRole("Admin"))
        {
            <div class="d-flex gap-2">
                <a asp-action="InjectionTypes" class="btn btn-sm btn-outline-secondary"><i class="bi bi-syringe me-1"></i>Injection Types</a>
                <a asp-action="VitaminTypes" class="btn btn-sm btn-outline-secondary"><i class="bi bi-capsule me-1"></i>Vitamin Types</a>
                <a asp-action="CreatePackage" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>New Package</a>
            </div>
        }
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-capsule fs-1 d-block mb-2 opacity-50"></i>
                No active packages.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var p in Model)
                {
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h6 class="fw-bold">@p.PackageName</h6>
                                <p class="small text-muted">@(p.Description ?? "")</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fs-5 fw-bold text-primary">@p.BasePrice.ToString("C")</span>
                                    <span class="badge bg-light text-dark border">Max @p.MaxDiscountPercent% off</span>
                                </div>
                                <div class="small text-muted mt-1">@p.DurationWeeks weeks • @p.SessionsPerWeek session/week</div>
                                <a asp-action="PackageDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary w-100 mt-3">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
