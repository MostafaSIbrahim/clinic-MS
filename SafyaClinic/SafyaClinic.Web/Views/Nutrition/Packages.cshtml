@model IEnumerable<NutritionPackageDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@{
    // M4c: the active nutrition packages. Shared layout, table (cards on phones), English and Arabic.
    ViewData["Title"] = T["Nutrition packages"].Value;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var canManage = await Can.HasAsync(Permissions.Nutrition.ManagePackages);
    var canCatalogues = await Can.HasAsync(Permissions.Settings.Lookups);
    var none = new EmptyStateModel(T["No active packages."].Value, Icon: "bi-capsule",
        ActionText: canManage ? T["New package"].Value : null, ActionUrl: canManage ? Url.Action("CreatePackage") : null);
}
<div class="page-toolbar">
    <div>
        <h1>@T["Nutrition packages"]</h1>
        <p class="text-muted mb-0">@T["Four weekly follow-ups each. Patients are enrolled from their Nutrition tab."]</p>
    </div>
    <div class="page-actions">
        @if (canCatalogues)
        {
            <a asp-controller="Lookups" asp-action="Catalogue" asp-route-kind="Injection" class="btn btn-outline-secondary">@T["Injection types"]</a>
            <a asp-controller="Lookups" asp-action="Catalogue" asp-route-kind="Vitamin" class="btn btn-outline-secondary">@T["Vitamin types"]</a>
        }
        @if (canManage)
        {
            <a asp-action="CreatePackage" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> @T["New package"]</a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <partial name="_AppEmpty" model="none" />
}
else
{
    <app-table caption="@T["Nutrition packages"].Value" caption-hidden="true" stack="true">
        <thead>
            <tr>
                <th scope="col">@T["Package"]</th>
                <th scope="col" class="app-table__num">@T["Price"]</th>
                <th scope="col" class="app-table__num">@T["Maximum discount"]</th>
                <th scope="col">@T["Items"]</th>
                <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <th scope="row" data-label="@T["Package"]" dir="auto">
                        <a asp-action="PackageDetails" asp-route-id="@p.Id">@p.PackageName</a>
                        @if (!string.IsNullOrWhiteSpace(p.Description))
                        {
                            <div class="small text-muted fw-normal">@p.Description</div>
                        }
                    </th>
                    <td data-label="@T["Price"]" class="app-table__num">@p.BasePrice.ToMoney()</td>
                    <td data-label="@T["Maximum discount"]" class="app-table__num">@p.MaxDiscountPercent.ToString("0.##", inv)%</td>
                    <td data-label="@T["Items"]">@T["{0} item(s) over {1} weeks", p.Items.Count, p.DurationWeeks]</td>
                    <td class="app-table__actions">
                        <a asp-action="PackageDetails" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">@T["Open"]<span class="visually-hidden"> @p.PackageName</span></a>
                    </td>
                </tr>
            }
        </tbody>
    </app-table>
}
