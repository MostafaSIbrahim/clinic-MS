@model PatientEnrollmentDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Domain.Enums
@using SafyaClinic.Application.Services
@{
    // M4a: one nutrition enrollment. Shared layout, the patient header, English and Arabic. Only the status
    // changes the rules allow are offered (EnrollmentRules); the server checks them again. Actions are shown
    // only to people who may use them.
    ViewData["Title"] = Model.PackageName;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string D(DateTime d) => d.ToString("dd MMM yyyy", inv);
    var status = Enum.TryParse<EnrollmentStatus>(Model.Status, out var parsed) ? parsed : EnrollmentStatus.Active;
    var canManage = await Can.HasAsync(Permissions.Nutrition.Manage);
    var canCollect = await Can.HasAsync(Permissions.Payments.Collect);
    const int Weeks = 4;   // packages run four weekly follow-ups (the server's rule)
    var byWeek = Model.WeeklyFollowUps.GroupBy(f => f.WeekNumber).ToDictionary(g => g.Key, g => g.First());
    var nextWeek = byWeek.Count == 0 ? 1 : byWeek.Keys.Max() + 1;
    var canRecord = canManage && status == EnrollmentStatus.Active && nextWeek <= Weeks;
    string ActionLabel(EnrollmentStatus s) => s switch
    {
        EnrollmentStatus.OnHold => T["Put on hold"].Value,
        EnrollmentStatus.Active => T["Resume"].Value,
        EnrollmentStatus.Cancelled => T["Cancel enrollment"].Value,
        _ => T[Labels.Humanize(s.ToString())].Value,
    };
}
<div class="page-toolbar">
    <div>
        <h1 dir="auto">@Model.PackageName</h1>
        <p class="text-muted mb-0">
            <span dir="auto">@T["Dr. {0}", Model.DoctorName]</span> · @D(Model.StartDate) – @D(Model.EndDate) ·
            <partial name="_StatusBadge" model="Model.Status" />
        </p>
    </div>
    <div class="page-actions">
        @if (canRecord)
        {
            <a asp-action="RecordFollowUp" asp-route-enrollmentId="@Model.Id" class="btn btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> @T["Record week {0}", nextWeek]
            </a>
        }
        @if (canManage)
        {
            @foreach (var next in EnrollmentRules.NextStatuses(status))
            {
                <form asp-action="UpdateEnrollmentStatus" method="post" class="d-inline"
                      data-confirm="@(next == EnrollmentStatus.Cancelled ? T["Cancel this enrollment? Any unpaid balance will no longer be owed. This can't be undone."].Value : null)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="patientId" value="@Model.PatientId" />
                    <input type="hidden" name="status" value="@next" />
                    <button type="submit" class="btn @(next == EnrollmentStatus.Cancelled ? "btn-outline-danger" : "btn-outline-secondary")">@ActionLabel(next)</button>
                </form>
            }
        }
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="nutrition" class="btn btn-outline-secondary">@T["All enrollments"]</a>
    </div>
</div>

@await Component.InvokeAsync("PatientHeader", new { patientId = Model.PatientId })

@if (EnrollmentRules.IsFinal(status))
{
    <p class="alert alert-info" role="status">
        @(status == EnrollmentStatus.Cancelled
            ? T["This enrollment is cancelled. Nothing more is owed on it. To continue, enroll the patient again."]
            : T["This enrollment is completed. To continue, enroll the patient again."])
    </p>
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md">
        <div class="stat-card bg-primary-soft">
            <div class="small">@T["Package price"]</div>
            <div class="fs-5 fw-bold">@Model.BasePrice.ToMoney()</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-card bg-amber-soft">
            <div class="small">@T["Discount"]</div>
            <div class="fs-5 fw-bold">@Model.DiscountPercent.ToString("0.##", inv)%</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-card bg-teal-soft">
            <div class="small">@T["Final price"]</div>
            <div class="fs-5 fw-bold">@Model.FinalPrice.ToMoney()</div>
        </div>
    </div>
    <div class="col-6 col-md">
        <div class="stat-card bg-teal-soft">
            <div class="small">@T["Paid"]</div>
            <div class="fs-5 fw-bold">@Model.TotalPaid.ToMoney()</div>
        </div>
    </div>
    <div class="col-12 col-md">
        <div class="stat-card @(Model.AmountDue > 0 ? "bg-rose-soft" : "bg-teal-soft")">
            <div class="small">@T["Amount due"]</div>
            <div class="fs-5 fw-bold">@Model.AmountDue.ToMoney()</div>
            @if (Model.AmountDue > 0 && canCollect)
            {
                <a asp-controller="Payments" asp-action="Collect" asp-route-patientId="@Model.PatientId" asp-route-enrollmentId="@Model.Id"
                   class="btn btn-sm btn-success mt-2">@T["Collect"]</a>
            }
        </div>
    </div>
</div>

<app-card id="enrollment-weeks" title="@T["Weekly follow-ups"].Value" level="2" icon="bi-calendar-check">
    <ol class="enrollment-weeks list-unstyled mb-0">
        @for (var week = 1; week <= Weeks; week++)
        {
            <li class="enrollment-week">
                <div class="enrollment-week__title">@T["Week {0}", week]</div>
                @if (byWeek.TryGetValue(week, out var f))
                {
                    <div class="small text-muted">@D(f.FollowUpDate)</div>
                    @if (f.WeightKg != null)
                    {
                        <div>@T["{0} kg", f.WeightKg.Value.ToString("0.#", inv)]</div>
                    }
                    @if (f.IsCompleted)
                    {
                        <span class="app-status app-status--completed">@T["Completed"]</span>
                    }
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        <a asp-action="FollowUpDetails" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary">@T["Open"]<span class="visually-hidden"> @T["Week {0}", week]</span></a>
                        @if (canManage && status != EnrollmentStatus.Cancelled)
                        {
                            <a asp-action="EditFollowUp" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary">@T["Edit"]<span class="visually-hidden"> @T["Week {0}", week]</span></a>
                            @* M4b: only the latest week can be deleted, so weeks stay 1–4 with no gaps. *@
                            if (week == nextWeek - 1)
                            {
                            <form asp-action="DeleteFollowUp" method="post" class="d-inline" data-confirm="@T["Delete the week {0} follow-up?", week]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@f.Id" />
                                <input type="hidden" name="enrollmentId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">@T["Delete the week {0} follow-up", week]</span>
                                </button>
                            </form>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="small text-muted">@T["Not recorded yet"]</div>
                }
            </li>
        }
    </ol>
</app-card>
