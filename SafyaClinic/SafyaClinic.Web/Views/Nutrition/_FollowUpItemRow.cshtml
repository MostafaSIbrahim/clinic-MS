@model SafyaClinic.Web.Models.FollowUpItemRow
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M4b: one package item on the follow-up form: ticked when given, with the quantity given and a note.
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var i = Model.Index;
    var item = Model.Item;
    var qty = (Model.Given?.ActualQuantity ?? item.Quantity).ToString("0.00", inv);
}
<div class="followup-item">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="item-@i" name="AdministeredItems[@i].PackageItemId" value="@item.Id" checked="@(Model.Given != null)" />
        <label class="form-check-label" for="item-@i">
            <span dir="auto">@(item.InjectionName ?? item.VitaminName ?? "—")</span>
            <span class="text-muted small d-block">@Model.Kind · @T["Planned: {0} {1}", item.Quantity.ToString("0.##", inv), item.Unit ?? ""] · @T["Week {0}", item.WeekNumber]</span>
        </label>
    </div>
    <div>
        <label class="form-label small mb-1" for="item-@i-qty">@T["Quantity given"]</label>
        <input type="number" step="0.01" min="0" class="form-control form-control-sm" id="item-@i-qty" name="AdministeredItems[@i].ActualQuantity" value="@qty" />
    </div>
    <div>
        <label class="form-label small mb-1" for="item-@i-notes">@T["Notes"]</label>
        <input type="text" class="form-control form-control-sm" id="item-@i-notes" name="AdministeredItems[@i].Notes" value="@Model.Given?.Notes" dir="auto" />
    </div>
</div>
