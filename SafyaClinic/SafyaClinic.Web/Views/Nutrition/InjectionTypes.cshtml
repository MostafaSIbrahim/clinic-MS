@model IEnumerable<InjectionTypeDto>
@{
    ViewData["Title"] = "Injection Types";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-syringe me-2"></i>Injection Types</span>
        <a asp-action="CreateInjectionType" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Injection Type
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-syringe fs-1 d-block mb-2 opacity-50"></i>
                No injection types yet.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr><th>Name</th><th>Unit</th><th>Default Dosage</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@i.InjectionName</td>
                            <td>@i.Unit</td>
                            <td>@(i.DefaultDosage ?? "—")</td>
                            <td>
                                @if (i.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                @if (i.IsInUse)
                                {
                                    <span class="badge bg-info text-dark ms-1">In use</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="EditInjectionType" asp-route-id="@i.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="DeleteInjectionType" asp-route-id="@i.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this injection type?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
