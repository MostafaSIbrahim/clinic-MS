@model CreateNutritionPackageDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M4c: a new nutrition package. Shared fields, English and Arabic. Each weekly item row has visible labels
    // and one Item list (injections and vitamins grouped) instead of two lists where exactly one had to be
    // chosen. Rows entered come back if the server refuses, and typing is kept across a language switch.
    ViewData["Title"] = T["New package"].Value;
    var injections = ViewBag.InjectionTypes as IEnumerable<InjectionTypeDto> ?? Enumerable.Empty<InjectionTypeDto>();
    var vitamins = ViewBag.VitaminTypes as IEnumerable<VitaminTypeDto> ?? Enumerable.Empty<VitaminTypeDto>();
    var catalogue = new
    {
        injections = injections.Select(i => new { id = i.Id, name = i.InjectionName, unit = i.Unit }),
        vitamins = vitamins.Select(v => new { id = v.Id, name = v.VitaminName, unit = v.Unit }),
    };
    var labels = new
    {
        week = T["Week"].Value, weekN = T["Week {0}", "{0}"].Value, item = T["Item"].Value, choose = T["Choose an item"].Value,
        injections = T["Injections"].Value, vitamins = T["Vitamins"].Value, quantity = T["Quantity"].Value,
        unit = T["Unit"].Value, notes = T["Notes"].Value, remove = T["Remove this item"].Value, row = T["Item {0}", "{0}"].Value,
    };
    var restoreDraft = Context.Request.Method == "GET" ? "true" : "false";
}
<div class="page-toolbar">
    <div>
        <h1>@T["New package"]</h1>
        <p class="text-muted mb-0">@T["A package runs four weekly follow-ups. Add what is given each week."]</p>
    </div>
    @if (await Can.HasAsync(Permissions.Settings.Lookups))
    {
        <div class="page-actions">
            <a asp-action="InjectionTypes" class="btn btn-outline-secondary">@T["Injection types"]</a>
            <a asp-action="VitaminTypes" class="btn btn-outline-secondary">@T["Vitamin types"]</a>
        </div>
    }
</div>

<form asp-action="CreatePackage" method="post" class="followup-form" data-draft-key="package-new" data-draft-restore="@restoreDraft" data-draft-prepare="ensureItemRows">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>

    <app-card id="package-details" title="@T["Package"].Value" level="2" icon="bi-capsule">
        <div class="row g-3">
            <div class="col-md-6"><app-field asp-for="PackageName" label="@T["Package name"].Value" required="true" /></div>
            <div class="col-6 col-md-3"><app-field asp-for="BasePrice" label="@T["Price"].Value" type="number" required="true" /></div>
            <div class="col-6 col-md-3"><app-field asp-for="MaxDiscountPercent" label="@T["Maximum discount %"].Value" type="number" /></div>
        </div>
        <app-field asp-for="Description" label="@T["Description"].Value" type="textarea" rows="2" />
    </app-card>

    <app-card id="package-items" title="@T["Weekly items"].Value" level="2" icon="bi-calendar-week">
        @if (!injections.Any() && !vitamins.Any())
        {
            <div class="alert alert-warning" role="status">@T["No injection or vitamin types are set up yet. Add them first under Injection types or Vitamin types."]</div>
        }
        <p class="text-muted small">@T["Each row is one injection or vitamin in one week."]</p>
        <div id="item-rows"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addItemRow()">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> @T["Add item"]
        </button>
    </app-card>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@T["Create package"]</button>
        <a asp-action="Packages" class="btn btn-outline-secondary" data-draft-discard="package-new">@T["Cancel"]</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const catalogue = @Html.Raw(Json.Serialize(catalogue));
        const itemLabels = @Html.Raw(Json.Serialize(labels));
        const enteredItems = @Html.Raw(Json.Serialize(Model.Items));
        const escItem = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        let itemIndex = 0;

        // One Item list; the choice fills the hidden InjectionId or VitaminId the server reads.
        function itemOptions() {
            const group = (label, list, kind) => list.length
                ? `<optgroup label="${escItem(label)}">${list.map(x => `<option value="${kind}:${x.id}" data-unit="${escItem(x.unit)}">${escItem(x.name)}</option>`).join('')}</optgroup>` : '';
            return `<option value="">${escItem(itemLabels.choose)}</option>` +
                group(itemLabels.injections, catalogue.injections, 'inj') + group(itemLabels.vitamins, catalogue.vitamins, 'vit');
        }

        function addItemRow(item) {
            const i = itemIndex++;
            const id = n => `pkg-${i}-${n}`;
            const weeks = [1, 2, 3, 4].map(w => `<option value="${w}">${escItem(itemLabels.weekN.replace('{0}', w))}</option>`).join('');
            document.getElementById('item-rows').insertAdjacentHTML('beforeend', `
                <fieldset class="package-item" data-index="${i}">
                    <legend class="visually-hidden">${escItem(itemLabels.row.replace('{0}', i + 1))}</legend>
                    <div><label class="form-label small mb-1" for="${id('week')}">${escItem(itemLabels.week)}</label>
                        <select class="form-select form-select-sm" id="${id('week')}" name="Items[${i}].WeekNumber">${weeks}</select></div>
                    <div><label class="form-label small mb-1" for="${id('item')}">${escItem(itemLabels.item)}</label>
                        <select class="form-select form-select-sm package-item__choice" id="${id('item')}" name="Items[${i}].Choice" required>${itemOptions()}</select>
                        <input type="hidden" name="Items[${i}].InjectionId" /><input type="hidden" name="Items[${i}].VitaminId" /></div>
                    <div><label class="form-label small mb-1" for="${id('qty')}">${escItem(itemLabels.quantity)}</label>
                        <input type="number" step="0.01" min="0.01" class="form-control form-control-sm" id="${id('qty')}" name="Items[${i}].Quantity" value="1.00" /></div>
                    <div><label class="form-label small mb-1" for="${id('unit')}">${escItem(itemLabels.unit)}</label>
                        <input class="form-control form-control-sm" id="${id('unit')}" name="Items[${i}].Unit" /></div>
                    <div><label class="form-label small mb-1" for="${id('notes')}">${escItem(itemLabels.notes)}</label>
                        <input class="form-control form-control-sm" id="${id('notes')}" name="Items[${i}].Notes" dir="auto" /></div>
                    <div class="followup-lab__remove">
                        <button type="button" class="btn btn-sm btn-link text-danger" onclick="removeItemRow(this)">
                            <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">${escItem(itemLabels.remove)}</span></button></div>
                </fieldset>`);
            const row = document.getElementById('item-rows').lastElementChild;
            const choice = row.querySelector('.package-item__choice');
            choice.addEventListener('change', function () { syncChoice(row, true); });
            if (item) {
                row.querySelector('[name$=".WeekNumber"]').value = String(item.weekNumber || 1);
                choice.value = item.injectionId ? `inj:${item.injectionId}` : item.vitaminId ? `vit:${item.vitaminId}` : '';
                if (item.quantity) row.querySelector('[name$=".Quantity"]').value = Number(item.quantity).toFixed(2);
                row.querySelector('[name$=".Unit"]').value = item.unit || '';
                row.querySelector('[name$=".Notes"]').value = item.notes || '';
            }
            syncChoice(row, false);
        }

        function syncChoice(row, fillUnit) {
            const choice = row.querySelector('.package-item__choice');
            const [kind, value] = (choice.value || ':').split(':');
            row.querySelector('[name$=".InjectionId"]').value = kind === 'inj' ? value : '';
            row.querySelector('[name$=".VitaminId"]').value = kind === 'vit' ? value : '';
            const unit = row.querySelector('[name$=".Unit"]');
            const chosen = choice.selectedOptions[0];
            if (fillUnit && chosen && chosen.dataset.unit && !unit.value) unit.value = chosen.dataset.unit;
        }

        // The server reads Items[0], [1]… and stops at a gap, so rows are renumbered after one is removed.
        function removeItemRow(button) {
            button.closest('.package-item').remove();
            const rows = document.querySelectorAll('#item-rows .package-item');
            rows.forEach(function (row, n) {
                row.dataset.index = n;
                row.querySelector('legend').textContent = itemLabels.row.replace('{0}', n + 1);
                row.querySelectorAll('[name], [id], label[for]').forEach(function (el) {
                    if (el.name) el.name = el.name.replace(/^Items\[\d+\]/, 'Items[' + n + ']');
                    if (el.id) el.id = el.id.replace(/^pkg-\d+-/, 'pkg-' + n + '-');
                    if (el.htmlFor) el.htmlFor = el.htmlFor.replace(/^pkg-\d+-/, 'pkg-' + n + '-');
                });
            });
            itemIndex = rows.length;
            document.querySelector('form[data-draft-key]').dispatchEvent(new Event('input', { bubbles: true }));
        }

        // form-draft.js: make the kept rows exist before their values are put back, then re-read the choices.
        function ensureItemRows(names) {
            let highest = -1;
            names.forEach(function (n) { const m = /^Items\[(\d+)\]\./.exec(n); if (m) highest = Math.max(highest, Number(m[1])); });
            while (itemIndex <= highest) addItemRow();
            setTimeout(function () { document.querySelectorAll('#item-rows .package-item').forEach(r => syncChoice(r, false)); }, 0);
        }

        if (enteredItems && enteredItems.length) enteredItems.forEach(function (it) { addItemRow(it); });
        else addItemRow();
    </script>
    <script src="~/js/form-draft.js" asp-append-version="true"></script>
}
