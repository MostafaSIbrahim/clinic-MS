@model RecordFollowUpDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // M4b: record or edit a weekly follow-up. Edit saves to the same week (it added a new week before).
    // Lab results are chosen from the analysis list. Shared fields, the patient header, English and Arabic.
    // M4d: "Given this week" starts from the patient's plan (or the package), planned items ticked; items can be
    // added from the injection and vitamin lists or typed by name; the plan for the coming weeks is edited here
    // and pre-fills those weeks' forms. The rows are built by followup-items.js.
    var isEdit = ViewBag.IsEdit == true;
    var followUpId = ViewBag.FollowUpId as int?;
    var week = ViewBag.WeekNumber as int? ?? 1;
    var enrollment = ViewBag.Enrollment as PatientEnrollmentDto;
    var enrollmentId = Model.FollowUpId;   // this form carries the enrollment's number in FollowUpId
    var form = ViewBag.Form as FollowUpFormDto ?? new FollowUpFormDto();
    var analyses = (ViewBag.AnalysisTypes as IEnumerable<SafyaClinic.Application.DTOs.Analysis.AnalysisTypeDto>
        ?? Enumerable.Empty<SafyaClinic.Application.DTOs.Analysis.AnalysisTypeDto>()).ToList();
    ViewData["Title"] = isEdit ? T["Edit week {0} follow-up", week].Value : T["Record week {0} follow-up", week].Value;
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    var diet = new[] { "Excellent", "Good", "Fair", "Poor" }
        .Select(d => new SelectListItem(T[d].Value, d, d == Model.DietCompliance)).ToList();
    var labRows = Model.LabResults.Where(l => l.AnalysisTypeId.HasValue || !string.IsNullOrWhiteSpace(l.ResultValue)).ToList();
    var draftKey = isEdit ? $"followup-edit-{followUpId}" : $"followup-new-{enrollmentId}";
    var restoreDraft = Context.Request.Method == "GET" ? "true" : "false";
    var backUrl = isEdit
        ? Url.Action("FollowUpDetails", new { id = followUpId })
        : Url.Action("EnrollmentDetails", new { id = enrollmentId });
    var itemText = new
    {
        kinds = new Dictionary<string, string> { ["injection"] = T["Injection"].Value, ["vitamin"] = T["Vitamin"].Value, ["other"] = T["Other drug"].Value },
        outside = T["Outside the package"].Value, plannedWeek = T["Planned for week {0}", "{0}"].Value,
        drugName = T["Drug name"].Value, givenLabel = T["Given"].Value, quantityGiven = T["Quantity given"].Value,
        quantity = T["Quantity"].Value, unit = T["Unit"].Value, notes = T["Notes"].Value, remove = T["Remove"].Value,
        choose = T["Choose an item"].Value, otherDrug = T["Other drug (type the name)"].Value, add = T["Add"].Value,
        addThisWeek = T["Add an item given this week"].Value, addToWeek = T["Add an item to week {0}", "{0}"].Value,
        week = T["Week {0}", "{0}"].Value,
    };
    var labOptions = analyses.Select(a => new { value = a.Id.ToString(), label = a.TypeName }).ToList();
}
<div class="page-toolbar">
    <div>
        <h1>@ViewData["Title"]</h1>
        @if (enrollment != null)
        {
            <p class="text-muted mb-0" dir="auto">@enrollment.PackageName</p>
        }
    </div>
</div>

@if (enrollment != null)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId = enrollment.PatientId })
}

<form method="post" action="@(isEdit ? Url.Action("EditFollowUp", new { id = followUpId }) : Url.Action("RecordFollowUp", new { enrollmentId }))"
      class="followup-form" data-draft-key="@draftKey" data-draft-restore="@restoreDraft" data-draft-prepare="prepareFollowUp">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>
    <input type="hidden" asp-for="FollowUpId" />

    <app-card id="followup-measurements" title="@T["Measurements"].Value" level="2" icon="bi-speedometer2">
        <div class="row g-3">
            <div class="col-md-4"><app-field asp-for="FollowUpDate" label="@T["Follow-up date"].Value" type="date" required="true" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="WeightKg" label="@T["Weight (kg)"].Value" type="number" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="HeightCm" label="@T["Height (cm)"].Value" type="number" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="BodyFatPercent" label="@T["Body fat %"].Value" type="number" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="MuscleMassKg" label="@T["Muscle mass (kg)"].Value" type="number" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="WaistCircumferenceCm" label="@T["Waist (cm)"].Value" type="number" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="BloodPressureSys" label="@T["Blood pressure, systolic"].Value" type="number" step="1" /></div>
            <div class="col-6 col-md-4"><app-field asp-for="BloodPressureDia" label="@T["Blood pressure, diastolic"].Value" type="number" step="1" /></div>
        </div>
    </app-card>

    <app-card id="followup-notes" title="@T["Clinical notes"].Value" level="2" icon="bi-journal-text">
        <div class="row g-3">
            <div class="col-md-6"><app-field asp-for="DietCompliance" label="@T["Diet compliance"].Value" type="select" asp-items="diet" option-label="—" /></div>
            <div class="col-md-6"><app-field asp-for="SideEffects" label="@T["Side effects"].Value" /></div>
        </div>
        <app-field asp-for="DoctorNotes" label="@T["Doctor's notes"].Value" type="textarea" rows="2" />
        <app-field asp-for="NextWeekAdjustments" label="@T["Next week's adjustments"].Value" type="textarea" rows="2" />
    </app-card>

    <app-card id="followup-items" title="@T["Given this week"].Value" level="2" icon="bi-capsule">
        <p class="text-muted small">@T["Planned items start ticked. Untick what wasn't given, and check the quantity."]</p>
        <div id="given-rows"></div>
    </app-card>

    @if (form.PlanWeeks.Any())
    {
        <app-card id="followup-plan" title="@T["Plan for the coming weeks"].Value" level="2" icon="bi-calendar-week">
            <p class="text-muted small">@T["This patient's plan only; the package doesn't change. Each week's form starts from it."]</p>
            <div id="plan-weeks"></div>
        </app-card>
    }

    <app-card id="followup-labs" title="@T["Lab results"].Value" level="2" icon="bi-clipboard2-pulse">
        <app-field asp-for="LabResultsSummary" label="@T["Lab results summary"].Value" type="textarea" rows="2" />
        <div id="lab-rows"></div>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="addLabRow()">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> @T["Add lab result"]
        </button>
    </app-card>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">@(isEdit ? T["Save changes"] : T["Save follow-up"])</button>
        <a href="@backUrl" class="btn btn-outline-secondary" data-draft-discard="@draftKey">@T["Cancel"]</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/followup-items.js" asp-append-version="true"></script>
    <script>
        const labOptions = @Html.Raw(Json.Serialize(labOptions));
        const labText = @Html.Raw(Json.Serialize(new
        {
            analysis = T["Analysis"].Value, result = T["Result"].Value, range = T["Reference range"].Value,
            normal = T["Normal?"].Value, yes = T["Normal"].Value, no = T["Abnormal"].Value,
            remove = T["Remove this lab result"].Value, row = T["Lab result {0}", "{0}"].Value
        }));
        const enteredLabs = @Html.Raw(Json.Serialize(labRows));
        const escHtml = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
        let labIndex = 0;

        function addLabRow(lab) {
            const i = labIndex++;
            const id = n => `lab-${i}-${n}`;
            const opts = labOptions.map(o => `<option value="${escHtml(o.value)}">${escHtml(o.label)}</option>`).join('');
            document.getElementById('lab-rows').insertAdjacentHTML('beforeend', `
                <fieldset class="followup-lab" data-index="${i}">
                    <legend class="visually-hidden">${escHtml(labText.row.replace('{0}', i + 1))}</legend>
                    <div><label class="form-label small mb-1" for="${id('type')}">${escHtml(labText.analysis)}</label>
                        <select class="form-select form-select-sm" id="${id('type')}" name="LabResults[${i}].AnalysisTypeId"><option value="">—</option>${opts}</select></div>
                    <div><label class="form-label small mb-1" for="${id('value')}">${escHtml(labText.result)}</label>
                        <input class="form-control form-control-sm" id="${id('value')}" name="LabResults[${i}].ResultValue" dir="auto" /></div>
                    <div><label class="form-label small mb-1" for="${id('range')}">${escHtml(labText.range)}</label>
                        <input class="form-control form-control-sm" id="${id('range')}" name="LabResults[${i}].ReferenceRange" dir="auto" /></div>
                    <div><label class="form-label small mb-1" for="${id('normal')}">${escHtml(labText.normal)}</label>
                        <select class="form-select form-select-sm" id="${id('normal')}" name="LabResults[${i}].IsNormal">
                            <option value="">—</option><option value="true">${escHtml(labText.yes)}</option><option value="false">${escHtml(labText.no)}</option></select></div>
                    <div class="followup-lab__remove">
                        <button type="button" class="btn btn-sm btn-link text-danger" onclick="removeLabRow(this)">
                            <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">${escHtml(labText.remove)}</span></button></div>
                </fieldset>`);
            if (lab) {
                const row = document.getElementById('lab-rows').lastElementChild;
                const set = (name, v) => { if (v !== null && v !== undefined) row.querySelector(`[name$=".${name}"]`).value = String(v); };
                set('AnalysisTypeId', lab.analysisTypeId); set('ResultValue', lab.resultValue);
                set('ReferenceRange', lab.referenceRange); set('IsNormal', lab.isNormal);
            }
        }

        // The server reads LabResults[0], [1]… and stops at a gap, so rows are renumbered after one is removed.
        function removeLabRow(button) {
            button.closest('.followup-lab').remove();
            const rows = document.querySelectorAll('#lab-rows .followup-lab');
            rows.forEach(function (row, n) {
                row.dataset.index = n;
                row.querySelector('legend').textContent = labText.row.replace('{0}', n + 1);
                row.querySelectorAll('[name], [id], label[for]').forEach(function (el) {
                    if (el.name) el.name = el.name.replace(/^LabResults\[\d+\]/, 'LabResults[' + n + ']');
                    if (el.id) el.id = el.id.replace(/^lab-\d+-/, 'lab-' + n + '-');
                    if (el.htmlFor) el.htmlFor = el.htmlFor.replace(/^lab-\d+-/, 'lab-' + n + '-');
                });
            });
            labIndex = rows.length;
            document.querySelector('form[data-draft-key]').dispatchEvent(new Event('input', { bubbles: true }));
        }

        // form-draft.js: make the kept lab rows and item rows exist before their values are put back.
        function prepareFollowUp(names, values) {
            let highest = -1;
            names.forEach(function (n) { const m = /^LabResults\[(\d+)\]\./.exec(n); if (m) highest = Math.max(highest, Number(m[1])); });
            while (labIndex <= highest) addLabRow();
            FollowUpItems.prepare(names, values || {});
        }

        FollowUpItems.init(@Html.Raw(Json.Serialize(form)), @Html.Raw(Json.Serialize(itemText)));

        if (enteredLabs.length) enteredLabs.forEach(function (l) { addLabRow(l); });
        else addLabRow();
    </script>
    <script src="~/js/form-draft.js" asp-append-version="true"></script>
}
