@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Patient Registered</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5 text-center">
        <div class="card mx-auto" style="max-width:400px;">
            <div class="card-body">
                <h5 class="text-success"><i class="bi bi-check-circle-fill"></i> Patient Registered</h5>
                <p class="mb-0"><strong>@ViewBag.NewPatientName</strong></p>
                <p class="text-muted small">ID: @ViewBag.NewPatientId</p>
                <button type="button" class="btn btn-primary btn-sm" onclick="sendAndClose()">Close & Return</button>
            </div>
        </div>
    </div>
    <script>
            const createdPatient = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
                {
                    id = ViewBag.NewPatientId,
                        fullName = ViewBag.NewPatientName,
                        primaryPhone = ViewBag.NewPatientPhone
                }));
            function sendAndClose() {
                if (window.opener) {
                    window.opener.postMessage({ type: 'NEW_PATIENT_CREATED', patient: createdPatient },
                        window.location.origin);
                }
                window.close();
            }
            setTimeout(sendAndClose, 3000);
    </script>

</body>
</html>