@model UpdatePatientBasicRequest
@using SafyaClinic.Application.DTOs.Settings
@{
    ViewData["Title"] = "Edit Basic Info";
    var sources = ViewBag.Sources as IEnumerable<PatientSourceDto> ?? Enumerable.Empty<PatientSourceDto>();
}

<div class="page-toolbar">
    <h1 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Basic Information</h1>
    <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Patient
    </a>
</div>

<div class="card" style="max-width:600px;">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            @* Review fix: report individual field errors instead of silently redisplaying the form. *@
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" required />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" required />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="NationalId" class="form-label">National ID</label>
                    <input asp-for="NationalId" class="form-control" />
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="PatientSourceId" class="form-label">Patient Source</label>
                    <select asp-for="PatientSourceId" class="form-select">
                        <option value="">— Select Source —</option>
                        @foreach (var s in sources)
                        {
                            <option value="@s.Id">@s.Name (@s.DefaultDeductionPercentage.ToString("0.##")%)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-actions d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
