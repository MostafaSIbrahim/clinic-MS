@model PatientDashboardDto
@{
    var patient = Model.Patient;
    var lastVisit = Model.LastCompletedVisit;
    var nextAppointment = Model.NextAppointment;

    ViewData["Title"] = patient.FullName;
}

<header class="workspace-header">
    <div class="workspace-heading">
        <a asp-action="Index" class="workspace-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Patients
        </a>

        <h1 class="workspace-title">@patient.FullName</h1>

        <div class="workspace-meta">
            <span>Patient #@patient.Id</span>

            @if (!string.IsNullOrWhiteSpace(patient.NationalId))
            {
                <span>National ID: @patient.NationalId</span>
            }
        </div>
    </div>

    <div class="workspace-actions">
        <a asp-controller="Reservations"
           asp-action="Create"
           asp-route-patientId="@patient.Id"
           class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>
            Book Reservation
        </a>

        @if (IsDoctor() || IsAdmin())
        {
            <a asp-action="Timeline"
               asp-route-id="@patient.Id"
               target="_blank"
               rel="noopener"
               class="btn btn-outline-primary">
                <i class="bi bi-clock-history me-1" aria-hidden="true"></i>
                Timeline
                <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                <span class="visually-hidden">(opens in a new tab)</span>
            </a>
        }

        <div class="dropdown">
            <button type="button"
                    class="btn btn-outline-secondary dropdown-toggle"
                    id="patientActionsMenu"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                More Actions
            </button>

            <ul class="dropdown-menu dropdown-menu-end"
                aria-labelledby="patientActionsMenu">
                <li>
                    <a class="dropdown-item"
                       asp-action="EditBasic"
                       asp-route-id="@patient.Id">
                        Edit Basic Information
                    </a>
                </li>

                @if (IsDoctor() || IsAdmin())
                {
                    <li>
                        <a class="dropdown-item"
                           asp-action="EditMedical"
                           asp-route-id="@patient.Id">
                            Edit Medical Information
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Reservations"
                           asp-action="PatientReservationHistoryReport"
                           asp-route-patientId="@patient.Id"
                           target="_blank"
                           rel="noopener">
                            Reservation History Report
                            <i class="bi bi-box-arrow-up-right ms-1"
                               aria-hidden="true"></i>
                            <span class="visually-hidden">
                                (opens in a new tab)
                            </span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</header>

<nav class="workspace-shortcuts" aria-label="Patient workspace">
    @if (IsDoctor() || IsAdmin())
    {
        <a asp-controller="MedicalRecords"
           asp-action="PatientRecords"
           asp-route-patientId="@patient.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-file-medical me-1" aria-hidden="true"></i>
            Medical Records
        </a>

        <a asp-controller="Analysis"
           asp-action="PatientAnalyses"
           asp-route-patientId="@patient.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-clipboard2-pulse me-1" aria-hidden="true"></i>
            Analyses
        </a>
    }

    @if (IsAdmin() || IsNutritionist())
    {
        <a asp-controller="Nutrition"
           asp-action="PatientEnrollments"
           asp-route-patientId="@patient.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-capsule me-1" aria-hidden="true"></i>
            Nutrition Enrollments
        </a>
    }

    @if (IsAdmin() || User.IsInRole("Reception"))
    {
        <a asp-controller="Payments"
           asp-action="PatientSummary"
           asp-route-patientId="@patient.Id"
           class="btn btn-outline-secondary">
            <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>
            Payments
        </a>
    }
</nav>
<!-- ── Patient Info Cards ── -->
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-clock-history me-2"></i>Last Completed Visit
            </div>
            <div class="card-body">
                @if (lastVisit is null)
                {
                    <p class="text-muted mb-0">No completed visits yet.</p>
                }
                else
                {
                    <div class="fw-semibold">
                        @lastVisit.ReservationDate.ToString("dd MMM yyyy")
                        at @(lastVisit.ReservationTime.ToString(@"hh\:mm"))
                    </div>
                    <div>@lastVisit.DoctorName</div>
                    <div class="text-muted">@lastVisit.ClinicName</div>
                    <div class="small mt-1">@lastVisit.TreatmentTypeName</div>

                    <a asp-controller="Reservations"
                       asp-action="Details"
                       asp-route-id="@lastVisit.Id"
                       class="btn btn-sm btn-outline-primary mt-3">
                        View Reservation
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-calendar-event me-2"></i>Next Appointment
            </div>
            <div class="card-body">
                @if (nextAppointment is null)
                {
                    <p class="text-muted mb-0">No upcoming appointments.</p>
                }
                else
                {
                    <div class="fw-semibold">
                        @nextAppointment.ReservationDate.ToString("dd MMM yyyy")
                        at @(nextAppointment.ReservationTime.ToString(@"hh\:mm"))
                    </div>
                    <div>@nextAppointment.DoctorName</div>
                    <div class="text-muted">@nextAppointment.ClinicName</div>
                    <div class="small mt-1">@nextAppointment.TreatmentTypeName</div>
                    <span class="badge bg-light text-dark border mt-2">
                        @nextAppointment.StatusName
                    </span>

                    <div>
                        <a asp-controller="Reservations"
                           asp-action="Details"
                           asp-route-id="@nextAppointment.Id"
                           class="btn btn-sm btn-outline-primary mt-3">
                            View Reservation
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <!-- ── Medical Info ── -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-heart-pulse me-2"></i>General Information</div>
            <div class="card-body">
                <h2 class="h6 me-3">Patient Information</h2>
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Patient Source</dt>
                    <dd class="col-7">@(patient.PatientSourceName ?? "—")</dd>

                    <dt class="col-5 text-muted">Date of Birth</dt>
                    <dd class="col-7">@(patient.DateOfBirth?.ToString("dd MMM yyyy") ?? "—") @(patient.Age != null ? $"({patient.Age} yrs)" : "")</dd>

                    <dt class="col-5 text-muted">Gender</dt>
                    <dd class="col-7">@(patient.Gender ?? "—")</dd>
                </dl>
                <h2 class="h6 mt-3">Medical Information</h2>
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">Blood Type</dt>
                    <dd class="col-7">@(patient.BloodType ?? "—")</dd>

                    <dt class="col-5 text-muted">Height</dt>
                    <dd class="col-7">@(patient.HeightCm != null ? $"{patient.HeightCm} cm" : "—")</dd>

                    <dt class="col-5 text-muted">Weight</dt>
                    <dd class="col-7">@(patient.Weight != null ? $"{patient.Weight} kg" : "—")</dd>

                    <dt class="col-5 text-muted">Allergies</dt>
                    <dd class="col-7 clinical-text">@(patient.Allergies ?? "Not recorded")</dd>

                    <dt class="col-5 text-muted">Chronic Diseases</dt>
                    <dd class="col-7 clinical-text">@(patient.ChronicDiseases ?? "Not recorded")</dd>

                    <dt class="col-5 text-muted">Notes</dt>
                    <dd class="col-7 clinical-text">@(patient.Notes ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- ── Contact Info ── -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-telephone me-2"></i>Contact Information</div>
            <div class="card-body">
                <h6 class="text-muted small text-uppercase">Phone Numbers</h6>
                @if (!patient.Phones.Any())
                {
                    <p class="text-muted small">No phone numbers added.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var ph in patient.Phones)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
                                <span class="contact-value">
                                    @ph.PhoneNumber
                                    <span class="badge bg-light text-dark border ms-1">@ph.PhoneType</span>
                                    @if (ph.IsPrimary)
                                    {
                                        <span class="badge bg-primary ms-1">Primary</span>
                                    }
                                </span>
                                <form asp-action="RemovePhone" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="patientId" value="@patient.Id" />
                                    <input type="hidden" name="phoneId" value="@ph.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this phone?')">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Remove phone
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addPhoneModal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                    Add Phone
                </button>

                <hr />

                <h6 class="text-muted small text-uppercase">Addresses</h6>
                @if (!patient.Addresses.Any())
                {
                    <p class="text-muted small">No addresses added.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var a in patient.Addresses)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
                                <span class="small contact-value">@a.Street, @a.City @(a.Governorate != null ? $", {a.Governorate}" : "")</span>
                                <form asp-action="RemoveAddress" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="patientId" value="@patient.Id" />
                                    <input type="hidden" name="addressId" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this address?')">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Remove address
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <button type="button" class="btn btn-outline-primary"
                        data-bs-toggle="modal" data-bs-target="#addAddressModal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Add Address
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="addPhoneModal"
     tabindex="-1"
     aria-labelledby="addPhoneTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddPhone" method="post" id="addPhoneForm" data-contact-modal="true">
                @Html.AntiForgeryToken()
                <input type="hidden" name="patientId" value="@patient.Id" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="addPhoneTitle">
                        Add Phone
                    </h2>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="text-muted">@patient.FullName</p>

                    <div id="addPhoneError"
                         class="alert alert-danger"
                         role="alert"
                         tabindex="-1"
                         hidden data-modal-error="true"></div>

                    <div class="mb-3">
                        <label for="newPhoneNumber" class="form-label">
                            Phone number
                        </label>
                        <input id="newPhoneNumber"
                               name="PhoneNumber"
                               type="tel"
                               autocomplete="tel"
                               maxlength="20"
                               required
                               class="form-control" data-modal-focus="true"/>
                    </div>

                    <div>
                        <label for="newPhoneType" class="form-label">
                            Type
                        </label>
                        <select id="newPhoneType"
                                name="PhoneType"
                                class="form-select">
                            <option value="Mobile">Mobile</option>
                            <option value="Home">Home</option>
                            <option value="Work">Work</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Save Phone
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="addAddressModal" tabindex="-1"
     aria-labelledby="addAddressTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="AddAddress" method="post" data-contact-modal>
                @Html.AntiForgeryToken()
                <input type="hidden" name="patientId" value="@patient.Id" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="addAddressTitle">Add Address</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@patient.FullName</p>
                    <div class="alert alert-danger" role="alert" tabindex="-1"
                         data-modal-error hidden></div>
                    <div class="mb-3">
                        <label for="addressStreet" class="form-label">Street</label>
                        <input id="addressStreet" name="Street" class="form-control"
                               maxlength="200" autocomplete="street-address" data-modal-focus />
                    </div>
                    <div class="mb-3">
                        <label for="addressCity" class="form-label">City (required)</label>
                        <input id="addressCity" name="City" class="form-control"
                               maxlength="50" autocomplete="address-level2" required />
                    </div>
                    <div>
                        <label for="addressGovernorate" class="form-label">Governorate</label>
                        <input id="addressGovernorate" name="Governorate" class="form-control"
                               maxlength="50" autocomplete="address-level1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Address</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    bool IsDoctor()       => ViewContext.HttpContext.User.IsInRole("Doctor");
    bool IsAdmin()        => ViewContext.HttpContext.User.IsInRole("Admin");
    bool IsNutritionist() => ViewContext.HttpContext.User.IsInRole("Nutritionist");
}
@section Scripts {
    <script src="~/js/contact-modal-forms.js" asp-append-version="true"></script>
}

