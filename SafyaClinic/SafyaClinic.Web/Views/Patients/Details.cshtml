@model SafyaClinic.Web.Models.PatientWorkspaceModel
@using SafyaClinic.Web.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M1: the patient workspace. The header stays; the tabs below it each load on their own.
    var patient = Model.Dashboard.Patient;

    ViewData["Title"] = patient.FullName;
}

<header class="workspace-header">
    <div class="workspace-heading">
        <a asp-action="Index" class="workspace-back">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            @T["Patients"]
        </a>

        <h1 class="workspace-title" dir="auto">@patient.FullName</h1>

        <div class="workspace-meta">
            <span>@T["Patient #{0}", patient.Id]</span>

            @if (!string.IsNullOrWhiteSpace(patient.NationalId))
            {
                <span>@T["National ID: {0}", patient.NationalId]</span>
            }
        </div>
    </div>

    <div class="workspace-actions">
        @* P3: book for this patient on the Appointments screen (pick a free time; the patient is filled in). *@
        <a asp-controller="Appointments"
           asp-action="Index"
           asp-route-patientId="@patient.Id"
           class="btn btn-primary">
            <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>
            @T["Book appointment"]
        </a>

        @* M1d: the timeline is a tab now, not a page in a new browser tab. *@
        <div class="dropdown">
            <button type="button"
                    class="btn btn-outline-secondary dropdown-toggle"
                    id="patientActionsMenu"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                @T["More actions"]
            </button>

            <ul class="dropdown-menu dropdown-menu-end"
                aria-labelledby="patientActionsMenu">
                <li>
                    <a class="dropdown-item"
                       asp-action="EditBasic"
                       asp-route-id="@patient.Id">
                        @T["Edit basic information"]
                    </a>
                </li>

                @if (await Can.HasAsync(Permissions.Patients.EditMedical))
                {
                    <li>
                        <a class="dropdown-item"
                           asp-action="EditMedical"
                           asp-route-id="@patient.Id">
                            @T["Edit medical information"]
                        </a>
                    </li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Reservations"
                           asp-action="PatientReservationHistoryReport"
                           asp-route-patientId="@patient.Id"
                           target="_blank"
                           rel="noopener">
                            @T["Reservation history report"]
                            <i class="bi bi-box-arrow-up-right ms-1" aria-hidden="true"></i>
                            <span class="visually-hidden">(@T["opens in a new tab"])</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</header>

@* M1c: Records, Lab, Nutrition and Payments are tabs now; the row of section buttons is gone. *@

@* M1a: the workspace tabs. Each is a link to its own page load (?tab=…), marked as the current page. *@
<nav class="app-tabs__list patient-tabs" aria-label="@T["Patient sections"]">
    @foreach (var tab in Model.Tabs)
    {
        <a class="app-tabs__tab" asp-action="Details" asp-route-id="@patient.Id" asp-route-tab="@tab.Key"
           aria-current="@(tab.Key == Model.ActiveTab ? "page" : null)">@T[tab.Label]</a>
    }
</nav>

@if (PatientTabs.IsClinical(Model.ActiveTab))
{
    @* M1b: on clinical tabs the allergies are always in view. *@
    @await Component.InvokeAsync("PatientHeader", new { patientId = patient.Id })
}

@if (Model.ActiveTab == PatientTabs.Visits)
{
    <partial name="_PatientVisits" model="Model" />
}
else if (Model.ActiveTab == PatientTabs.Records)
{
    <partial name="_PatientRecords" model="Model" />
}
else if (Model.ActiveTab == PatientTabs.Lab)
{
    <partial name="_PatientLab" model="Model" />
}
else if (Model.ActiveTab == PatientTabs.Nutrition)
{
    <partial name="_PatientNutrition" model="Model" />
}
else if (Model.ActiveTab == PatientTabs.Timeline)
{
    <partial name="_PatientTimeline" model="Model" />
}
else if (Model.ActiveTab == PatientTabs.Payments)
{
    @if (Model.Payments is not null)
    {
        <partial name="_PatientPayments" model="Model.Payments" />
    }
    else
    {
        <p class="text-danger" role="alert">@T["Could not load the payment summary. Reload the page to try again."]</p>
    }
}
else
{
    <partial name="_PatientOverview" model="Model.Dashboard" />
}

@section Scripts {
    <script src="~/js/contact-modal-forms.js" asp-append-version="true"></script>
    <script src="~/js/payment-audit.js" asp-append-version="true"></script>
}

