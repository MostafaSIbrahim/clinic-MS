@model CreatePatientRequest
@using SafyaClinic.Application.DTOs.Settings
@{
    ViewData["Title"] = "Register Patient";
    var sources = ViewBag.Sources as IEnumerable<PatientSourceDto> ?? Enumerable.Empty<PatientSourceDto>();
}

<div class="card">
    <div class="card-header"><i class="bi bi-person-plus me-2"></i>Register New Patient</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label">First Name *</label>
                    <input asp-for="FirstName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label">Last Name *</label>
                    <input asp-for="LastName" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="PatientSourceId" class="form-label">Patient Source</label>
                    <select asp-for="PatientSourceId" class="form-select">
                        <option value="">— Select Source —</option>
                        @foreach (var s in sources)
                        {
                            <option value="@s.Id">@s.Name (@s.DefaultDeductionPercentage.ToString("0.##")%)</option>
                        }
                    </select>
                    <small class="text-muted">Where this patient came from (Vezeeta, Instagram, Marketing…). Used to calculate the first-visit deduction.</small>
                </div>

                <div class="col-md-4">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">— Select —</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="BloodType" class="form-label">Blood Type</label>
                    <select asp-for="BloodType" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var bt in new[] { "APositive","ANegative","BPositive","BNegative","ABPositive","ABNegative","OPositive","ONegative" })
                        {
                            <option value="@bt">@bt</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label asp-for="NationalId" class="form-label">National ID</label>
                    <input asp-for="NationalId" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="HeightCm" class="form-label">Height (cm)</label>
                    <input asp-for="HeightCm" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Weight" class="form-label">Weight (KG)</label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control" />
                </div>

                <div class="col-12">
                    <label asp-for="Allergies" class="form-label">Allergies</label>
                    <textarea asp-for="Allergies" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="ChronicDiseases" class="form-label">Chronic Diseases</label>
                    <textarea asp-for="ChronicDiseases" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="text-muted text-uppercase small mb-3">Phone Number</h6>
            <div class="row g-2 mb-4">
                <div class="col-md-6">
                    <input type="text" name="Phones[0].PhoneNumber" class="form-control" placeholder="Phone number" />
                </div>
                <div class="col-md-4">
                    <select name="Phones[0].PhoneType" class="form-select">
                        <option value="Mobile">Mobile</option>
                        <option value="Home">Home</option>
                        <option value="Work">Work</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-check">
                        <input type="checkbox" name="Phones[0].IsPrimary" value="true" class="form-check-input" checked />
                        <label class="form-check-label small">Primary</label>
                    </div>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small mb-3">Address</h6>
            <div class="row g-2 mb-4">
                <div class="col-md-3"><input type="text" name="Addresses[0].Street" class="form-control" placeholder="Street" /></div>
                <div class="col-md-3"><input type="text" name="Addresses[0].City" class="form-control" placeholder="City" /></div>
                <div class="col-md-3"><input type="text" name="Addresses[0].Governorate" class="form-control" placeholder="Governorate" /></div>
                <div class="col-md-3"><input type="text" name="Addresses[0].PostalCode" class="form-control" placeholder="Postal code" /></div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Register Patient
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
