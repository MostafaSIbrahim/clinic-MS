@model PatientTimelineDto
@{
    ViewData["Title"] = "Patient Timeline";
    var timeline = Model.Timeline;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h4 class="mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i>Patient Timeline
        </h4>
        <div class="text-muted">
            @Model.PatientName
            <span class="ms-2">Patient #@Model.PatientId</span>
        </div>
    </div>
    <a asp-action="Details"
       asp-route-id="@Model.PatientId"
       class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-person me-1"></i>Patient Details
    </a>
</div>

<div class="card mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between gap-2">
        <span>
            <strong>@timeline.TotalCount</strong> events
            <span class="text-muted ms-2">Reservations and medical records</span>
        </span>
        <span class="small text-muted">
            Newest first · Event timestamps in UTC
        </span>
    </div>
</div>

@if (!timeline.Items.Any())
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-clock-history fs-1 text-muted"></i>
            <h5 class="mt-3">No activity yet</h5>
            <p class="text-muted mb-0">
                Reservations and medical records will appear here when created.
            </p>
        </div>
    </div>
}
else
{
    @foreach (var item in timeline.Items)
    {
        var isReservation =
            item.EventType == PatientTimelineEventType.Reservation;
        var icon = isReservation ? "bi-calendar-event" : "bi-file-medical";
        var color = isReservation ? "text-primary" : "text-success";
        var controller = isReservation ? "Reservations" : "MedicalRecords";

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex gap-3">
                    <div class="rounded-circle bg-light p-3 align-self-start">
                        <i class="bi @icon @color fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <div>
                                <div class="small text-muted mb-1">
                                    @item.OccurredAt.ToString("dd MMM yyyy · HH:mm") UTC
                                </div>
                                <h6 class="mb-2">@item.Title</h6>
                            </div>
                            <span class="badge bg-light text-dark border align-self-start">
                                @item.Status
                            </span>
                        </div>

                        <p class="text-muted mb-3">@item.Description</p>

                        <a asp-controller="@controller"
                           asp-action="Details"
                           asp-route-id="@item.EntityId"
                           class="btn btn-sm btn-outline-primary">
                            @(isReservation ? "View Reservation" : "View Medical Record")
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }

    <nav aria-label="Timeline pages"
         class="d-flex justify-content-between align-items-center mt-4">
        <div>
            @if (timeline.HasPrev)
            {
                <a asp-action="Timeline"
                   asp-route-id="@Model.PatientId"
                   asp-route-page="@(timeline.Page - 1)"
                   asp-route-pageSize="@timeline.PageSize"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-chevron-left me-1"></i>Previous
                </a>
            }
        </div>

        <span class="small text-muted">
            Page @timeline.Page of @timeline.TotalPages
        </span>

        <div>
            @if (timeline.HasNext)
            {
                <a asp-action="Timeline"
                   asp-route-id="@Model.PatientId"
                   asp-route-page="@(timeline.Page + 1)"
                   asp-route-pageSize="@timeline.PageSize"
                   class="btn btn-outline-primary btn-sm">
                    Next<i class="bi bi-chevron-right ms-1"></i>
                </a>
            }
        </div>
    </nav>
}