@model PatientFinancialSummaryDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@* M1c: the Payments tab of the patient workspace. M2c: in English and Arabic, shared tables. Figures and actions
   unchanged; links name the Payments controller because the page is served by Patients. *@
@{
    var canWriteOff = await Can.HasAsync(Permissions.Payments.WriteOff);
    string D(DateTime d) => d.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var noPayments = new EmptyStateModel(T["No payments recorded."].Value, Icon: "bi-receipt-cutoff");
}
<section aria-labelledby="payments-heading">
    <h2 id="payments-heading" class="h5">@T["Payments"]</h2>

    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card bg-primary-soft">
                <div class="small opacity-75">@T["Total charged"]</div>
                <div class="fs-3 fw-bold">@Model.TotalCharged.ToMoney()</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card bg-teal-soft">
                <div class="small opacity-75">@T["Total paid"]</div>
                <div class="fs-3 fw-bold">@Model.TotalPaid.ToMoney()</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card bg-amber-soft">
                <div class="small opacity-75">@T["Written off"]</div>
                <div class="fs-3 fw-bold">@Model.TotalWrittenOff.ToMoney()</div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card @(Model.CollectibleBalance > 0 ? "bg-rose-soft" : "bg-teal-soft")">
                <div class="small opacity-75">@T["Collectible balance"]</div>
                @if (Model.UnallocatedCoverage > 0)
                {
                    <div class="fw-semibold mt-2">@T["Needs reconciliation"]</div>
                    <div class="small mt-1">@T["Existing payments need to be linked before collecting more."]</div>
                }
                else
                {
                    <div class="fs-3 fw-bold">@Model.CollectibleBalance.ToMoney()</div>
                }
            </div>
        </div>
    </div>

    <app-card id="ready-for-collection" title="@T["Ready for collection"].Value" level="3" icon="bi-cash-coin">
        @if (Model.UnallocatedCoverage > 0)
        {
            <div class="alert alert-warning mb-0">
                @T["This patient has {0} in payments or write-offs that are not linked to a reservation or nutrition enrollment. Reconcile these records before collecting more.", Model.UnallocatedCoverage.ToMoney()]
            </div>
        }
        else if (Model.PendingPayments.Count == 0)
        {
            <p class="text-muted mb-0"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>@T["No collectible balance at this time."]</p>
        }
        else
        {
            <app-table caption="@T["Ready for collection"].Value" caption-hidden="true" stack="true">
                <thead>
                    <tr>
                        <th scope="col">@T["Date"]</th>
                        <th scope="col">@T["Service"]</th>
                        <th scope="col">@T["Clinic"]</th>
                        <th scope="col" class="app-table__num">@T["Remaining amount"]</th>
                        <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.PendingPayments)
                    {
                        <tr>
                            <th scope="row" data-label="@T["Date"]">@D(item.Date)</th>
                            <td data-label="@T["Service"]" dir="auto">@item.Description</td>
                            <td data-label="@T["Clinic"]" dir="auto">@(item.ClinicName ?? T["Chosen when collecting"].Value)</td>
                            <td data-label="@T["Remaining amount"]" class="app-table__num fw-semibold">@item.AmountDue.ToMoney()</td>
                            <td class="app-table__actions">
                                <a asp-controller="Payments" asp-action="Collect"
                                   asp-route-patientId="@Model.PatientId"
                                   asp-route-reservationId="@item.ReservationId"
                                   asp-route-enrollmentId="@item.EnrollmentId"
                                   class="btn btn-sm btn-success">@T["Collect"]</a>
                                @* P6b: excuse the balance (or part of it), with a reason. *@
                                @if (item.ReservationId.HasValue && canWriteOff)
                                {
                                    <a asp-controller="Payments" asp-action="WriteOff"
                                       asp-route-patientId="@Model.PatientId"
                                       asp-route-reservationId="@item.ReservationId"
                                       class="btn btn-sm btn-outline-warning">@T["Write off"]</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </app-table>
        }
    </app-card>

    <app-card id="payment-history" title="@T["Payment history"].Value" level="3" icon="bi-receipt">
        @if (!Model.Payments.Any())
        {
            <partial name="_AppEmpty" model="noPayments" />
        }
        else
        {
            <app-table caption="@T["Payment history"].Value" caption-hidden="true" stack="true">
                <thead>
                    <tr>
                        <th scope="col">@T["Date"]</th>
                        <th scope="col" class="app-table__num">@T["Amount"]</th>
                        <th scope="col">@T["Method"]</th>
                        <th scope="col">@T["Clinic"]</th>
                        <th scope="col">@T["Source"]</th>
                        <th scope="col">@T["Deduction"]</th>
                        <th scope="col" class="app-table__num">@T["Clinic net"]</th>
                        <th scope="col">@T["Status"]</th>
                        <th scope="col">@T["Collected by"]</th>
                        <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        var when = Clock.ToClinicTime(p.PaymentDate).ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture);
                        <tr class="@(p.Status == "Cancelled" ? "payment-row--void" : "")">
                            <th scope="row" data-label="@T["Date"]">@when</th>
                            <td data-label="@T["Amount"]" class="app-table__num fw-semibold">
                                @p.Amount.ToMoney()
                                @if (p.OriginalAmount.HasValue && p.OriginalAmount.Value != p.Amount)
                                {
                                    <div class="small text-muted">@T["was {0}", p.OriginalAmount.Value.ToMoney()]</div>
                                }
                            </td>
                            <td data-label="@T["Method"]">@T[Labels.Humanize(p.PaymentMethod)]</td>
                            <td data-label="@T["Clinic"]" dir="auto">@(p.ClinicName ?? "—")</td>
                            <td data-label="@T["Source"]" dir="auto">@(p.PatientSourceName ?? "—")</td>
                            <td data-label="@T["Deduction"]">
                                @if (p.IsFirstVisitDeduction)
                                {
                                    <span>@p.DeductionPercentage% (@p.SourceDeductionAmount.ToMoney())</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td data-label="@T["Clinic net"]" class="app-table__num">@p.ClinicNetAmount.ToMoney()</td>
                            <td data-label="@T["Status"]">
                                @if (p.Status == "Active")
                                {
                                    <span class="app-status app-status--paid">@T["Active"]</span>
                                }
                                else if (p.Status == "WrittenOff")
                                {
                                    @* P6: an excused balance; covers the visit, not revenue. *@
                                    <span class="app-status app-status--write-off">@T["Written off"]</span>
                                    @if (p.WriteOffReason is not null)
                                    {
                                        <div class="small text-muted">@T[Labels.Humanize(p.WriteOffReason)]</div>
                                    }
                                }
                                else
                                {
                                    @* P6: a void; doesn't cover the visit. *@
                                    <span class="app-status app-status--cancelled">@T["Cancelled (void)"]</span>
                                    @if (!string.IsNullOrWhiteSpace(p.CancellationReason))
                                    {
                                        <div class="small text-muted" dir="auto">@p.CancellationReason</div>
                                    }
                                }
                            </td>
                            <td data-label="@T["Collected by"]" dir="auto">@p.CollectorName</td>
                            <td class="app-table__actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary js-payment-audit"
                                        data-audit-url="@Url.Action("Audit", "Payments", new { paymentId = p.Id })">
                                    <i class="bi bi-clock-history" aria-hidden="true"></i> @T["History"]<span class="visually-hidden"> @when</span>
                                </button>
                                @if (p.Status == "WrittenOff" && canWriteOff)
                                {
                                    <a asp-controller="Payments" asp-action="CancelWriteOff" asp-route-paymentId="@p.Id" class="btn btn-sm btn-outline-danger">
                                        @T["Undo write-off"]<span class="visually-hidden"> @when</span>
                                    </a>
                                }
                                @if (p.Status == "Active")
                                {
                                    <a asp-controller="Payments" asp-action="ChangeAmount" asp-route-paymentId="@p.Id" class="btn btn-sm btn-outline-primary">
                                        @T["Change amount"]<span class="visually-hidden"> @when</span>
                                    </a>
                                    <a asp-controller="Payments" asp-action="Cancel" asp-route-paymentId="@p.Id" class="btn btn-sm btn-outline-danger">
                                        @T["Cancel payment"]<span class="visually-hidden"> @when</span>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </app-table>
        }
    </app-card>
</section>

<div class="modal fade" id="paymentAuditModal" tabindex="-1" aria-labelledby="paymentAuditTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="paymentAuditTitle">@T["Payment history"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body" id="paymentAuditBody" aria-live="polite"
                 data-loading="@T["Loading…"]" data-error="@T["Could not load the payment history."]"
                 data-expired="@T["Your session expired or you don't have access. Reload the page and sign in again."]"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@T["Close"]</button>
            </div>
        </div>
    </div>
</div>
