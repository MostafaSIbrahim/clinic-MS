@model SafyaClinic.Web.Models.PatientWorkspaceModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@using SafyaClinic.Domain.Enums
@{
    // M1a: every reservation of the patient, newest first (upcoming visits are at the top), with the same
    // actions and rules as Appointments and the dashboard.
    var patient = Model.Dashboard.Patient;
    var visits = Model.Visits;
    var canCheckIn = await Can.HasAsync(Permissions.Reservations.CheckIn);
    var canCollect = await Can.HasAsync(Permissions.Payments.Collect);
    var canMove = await Can.HasAsync(Permissions.Reservations.Manage);
    var here = Context.Request.Path + Context.Request.QueryString;
    var today = Clock.Today;
    var none = new EmptyStateModel(T["No visits yet."].Value, Icon: "bi-calendar-x");
}
<section aria-labelledby="visits-heading">
    <h2 id="visits-heading" class="h5">@T["Visits"]</h2>
    @if (visits is null || visits.TotalCount == 0)
    {
        <partial name="_AppEmpty" model="none" />
    }
    else
    {
        <app-table caption="@T["Visits"].Value" caption-hidden="true" stack="true">
            <thead>
                <tr>
                    <th scope="col">@T["Date"]</th>
                    <th scope="col">@T["Doctor"]</th>
                    <th scope="col">@T["Visit"]</th>
                    <th scope="col">@T["Status"]</th>
                    <th scope="col">@T["Payment coverage"]</th>
                    <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in visits.Items)
                {
                    var closed = r.StatusName is "Completed" or "Cancelled" or "NoShow";
                    var notArrived = r.QueueStatus == PatientQueueStatus.NotCheckedIn;
                    var when = $"{r.ReservationDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)} {r.ReservationTime.ToString(@"hh\:mm")}";
                    <tr>
                        <th scope="row" data-label="@T["Date"]">
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id">@when</a>
                        </th>
                        <td data-label="@T["Doctor"]" dir="auto">@r.DoctorName</td>
                        <td data-label="@T["Visit"]" dir="auto">@r.TreatmentTypeName</td>
                        <td data-label="@T["Status"]">
                            <partial name="_StatusBadge" model="r.StatusName" />
                            @if (!notArrived)
                            {
                                <partial name="_StatusBadge" model="r.QueueStatus.ToString()" />
                            }
                        </td>
                        <td data-label="@T["Payment coverage"]">
                            @if (r.StatusName != "Cancelled")
                            {
                                <partial name="_StatusBadge" model="@(r.IsPaid ? "Covered" : "Not fully covered")" />
                            }
                        </td>
                        <td class="app-table__actions">
                            @if (canCheckIn && !closed && notArrived && r.ReservationDate.Date == today)
                            {
                                <form asp-controller="Reservations" asp-action="CheckIn" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <input type="hidden" name="returnUrl" value="@here" />
                                    <button type="submit" class="btn btn-sm btn-success">@T["Check in"]<span class="visually-hidden"> @when</span></button>
                                </form>
                            }
                            @if (canCollect && r.HasCollectibleBalance)
                            {
                                <a asp-controller="Payments" asp-action="Collect" asp-route-patientId="@patient.Id" asp-route-reservationId="@r.Id"
                                   class="btn btn-sm btn-outline-success">@T["Collect"]<span class="visually-hidden"> @when</span></a>
                            }
                            @if (canMove && !closed && notArrived && r.ReservationDate.Date >= today)
                            {
                                <a asp-controller="Appointments" asp-action="Move" asp-route-id="@r.Id"
                                   class="btn btn-sm btn-outline-secondary">@T["Move"]<span class="visually-hidden"> @when</span></a>
                            }
                            <a asp-controller="Reservations" asp-action="Details" asp-route-id="@r.Id"
                               class="btn btn-sm btn-outline-secondary">@T["Open"]<span class="visually-hidden"> @when</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </app-table>
        var pager = new PagerModel(visits.Page, visits.PageSize, visits.TotalCount, nameof(SafyaClinic.Web.Controllers.PatientsController.Details));
        <partial name="_AppPagination" model="pager" />
    }
</section>
