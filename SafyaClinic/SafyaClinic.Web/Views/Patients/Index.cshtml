@model PagedResult<PatientSummaryDto>
@using SafyaClinic.Web.Components
@{
    ViewData["Title"] = "Patients";
    var startHint = new EmptyStateModel(
        "Find a patient to get started",
        Icon: "bi-search",
        Hint: "Enter a name, phone number or national ID, then select Search.");
    var noMatch = new EmptyStateModel(
        "No patients match this search",
        Icon: "bi-person-x",
        Hint: "Check the spelling or try the phone number.",
        ActionText: "Register patient",
        ActionUrl: Url.Action("Create"));
}

<div class="card">
    @* Review fix: wrap the actions on small screens and expose the page title as a heading. *@
    <div class="card-header page-toolbar mb-0">
        <div>
            <h1 class="mb-1"><i class="bi bi-person-badge me-2" aria-hidden="true"></i>Patients</h1>
            <p class="text-muted mb-2">Find a patient or register a new patient.</p>
        </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Register Patient
        </a>
    </div>
    </div>

    <div class="card-body">
        @* F8c: filter bar, data table, empty state and pagination components. *@
        <app-filter-bar label="Find patients" action="@Url.Action("Index")" clear-url="@Url.Action("Index")">
            <div class="app-filter-bar__field">
                <label for="patientSearch" class="form-label">Name, phone or national ID</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       id="patientSearch" autocomplete="off" />
            </div>
        </app-filter-bar>

        @* Search-first: distinguish initial guidance, invalid searches and genuine no-match results. *@
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (!ViewData.ModelState.IsValid)
        {
            <p class="text-muted py-3">Check the search above and try again.</p>
        }
        else if (ViewBag.HasSearch != true)
        {
            <partial name="_AppEmpty" model="startHint" />
        }
        else if (Model == null || !Model.Items.Any())
        {
            <partial name="_AppEmpty" model="noMatch" />
        }
        else
        {
            <app-table caption="Patient results" caption-hidden="true" stack="true">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col">National ID</th>
                        <th scope="col">Phone</th>
                        <th scope="col" class="app-table__num">Age</th>
                        <th scope="col">Gender</th>
                        <th scope="col">Registered</th>
                        <th scope="col" class="app-table__actions"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Items)
                    {
                        <tr>
                            <th scope="row" dir="auto">@p.FullName</th>
                            <td data-label="National ID">@(p.NationalId ?? "—")</td>
                            <td data-label="Phone">@(p.PrimaryPhone ?? "—")</td>
                            <td data-label="Age" class="app-table__num">@(p.Age?.ToString() ?? "—")</td>
                            <td data-label="Gender">@(p.Gender ?? "—")</td>
                            <td data-label="Registered">@p.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="app-table__actions">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye" aria-hidden="true"></i> View<span class="visually-hidden"> @p.FullName</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </app-table>
        }

        @if (Model != null && ViewBag.HasSearch == true)
        {
            <partial name="_AppPagination" model="PagerModel.From(Model!)" />
        }
    </div>
</div>
