@model PagedResult<PatientSummaryDto>
@{
    ViewData["Title"] = "Patients";
}

<div class="card">
    @* Review fix: wrap the actions on small screens and expose the page title as a heading. *@
    <div class="card-header page-toolbar mb-0">
        <div>
            <h1 class="mb-1"><i class="bi bi-person-badge me-2" aria-hidden="true"></i>Patients</h1>
            <p class="text-muted mb-2">Find a patient or register a new patient.</p>
        </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Register Patient
        </a>
    </div>
    </div>

    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-3 filter-panel" asp-action="Index">
            <div class="col-md-4">
                <label for="patientSearch" class="form-label">Name, phone or national ID</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       id="patientSearch" placeholder="Search by Phone Number or name or national ID..." />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-search me-1"></i>Search
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            </div>
        </form>

        @* Search-first: distinguish initial guidance, invalid searches and genuine no-match results. *@
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (!ViewData.ModelState.IsValid)
        {
            <p class="text-muted py-3">Check the search above and try again.</p>
        }
        else if (ViewBag.HasSearch != true)
        {
            <div class="empty-state" role="status">Enter a name, phone number or national ID, then select Search to load patients.</div>
        }
        else if (Model == null || !Model.Items.Any())
        {
            <div class="text-center text-muted py-5" tabindex="0" role="region" aria-label="Patient results">
                <i class="bi bi-person-x fs-1 d-block mb-2 opacity-50"></i>
                No patients match these filters.
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Patient results">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">National ID</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Age</th>
                            <th scope="col">Gender</th>
                            <th scope="col">Registered</th>
                            <th scope="col" ><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@p.FullName</td>
                                <td>@(p.NationalId ?? "—")</td>
                                <td>@(p.PrimaryPhone ?? "—")</td>
                                <td>@(p.Age?.ToString() ?? "—")</td>
                                <td>@(p.Gender ?? "—")</td>
                                <td>@p.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model != null && Model.TotalPages > 1)
        {
            ViewData["PaginationAction"] = "Index";
            var paginationModel = new PagedResult<object>
            {
                TotalCount = Model.TotalCount,
                Page = Model.Page,
                PageSize = Model.PageSize
            };
            @await Html.PartialAsync("_Pagination", paginationModel)
        }
    </div>
</div>
