@model PatientDashboardDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M1a: the Overview tab of the patient workspace. M1d: in English and Arabic.
    var patient = Model.Patient;
    var lastVisit = Model.LastCompletedVisit;
    var nextAppointment = Model.NextAppointment;
    var dash = "—";
    var notRecorded = T["Not recorded"].Value;
    string When(ReservationSummaryDto r) =>
        T["{0} at {1}", r.ReservationDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture),
            r.ReservationTime.ToString(@"hh\:mm")].Value;
}
<div class="row g-3 mb-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-clock-history me-2" aria-hidden="true"></i>@T["Last completed visit"]
            </div>
            <div class="card-body">
                @if (lastVisit is null)
                {
                    <p class="text-muted mb-0">@T["No completed visits yet."]</p>
                }
                else
                {
                    <div class="fw-semibold">@When(lastVisit)</div>
                    <div dir="auto">@lastVisit.DoctorName</div>
                    <div class="text-muted" dir="auto">@lastVisit.ClinicName</div>
                    <div class="small mt-1" dir="auto">@lastVisit.TreatmentTypeName</div>

                    <a asp-controller="Reservations"
                       asp-action="Details"
                       asp-route-id="@lastVisit.Id"
                       class="btn btn-sm btn-outline-primary mt-3">
                        @T["View reservation"]
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>@T["Next appointment"]
            </div>
            <div class="card-body">
                @if (nextAppointment is null)
                {
                    <p class="text-muted mb-0">@T["No upcoming appointments."]</p>
                }
                else
                {
                    <div class="fw-semibold">@When(nextAppointment)</div>
                    <div dir="auto">@nextAppointment.DoctorName</div>
                    <div class="text-muted" dir="auto">@nextAppointment.ClinicName</div>
                    <div class="small mt-1" dir="auto">@nextAppointment.TreatmentTypeName</div>
                    <div class="mt-2"><partial name="_StatusBadge" model="nextAppointment.StatusName" /></div>

                    <div>
                        <a asp-controller="Reservations"
                           asp-action="Details"
                           asp-route-id="@nextAppointment.Id"
                           class="btn btn-sm btn-outline-primary mt-3">
                            @T["View reservation"]
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-heart-pulse me-2" aria-hidden="true"></i>@T["General information"]</div>
            <div class="card-body">
                <h2 class="h6 me-3">@T["Patient information"]</h2>
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">@T["Patient source"]</dt>
                    <dd class="col-7" dir="auto">@(patient.PatientSourceName ?? dash)</dd>

                    <dt class="col-5 text-muted">@T["Date of birth"]</dt>
                    <dd class="col-7">
                        @(patient.DateOfBirth?.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) ?? dash)
                        @if (patient.Age is int age)
                        {
                            <span>(@T["{0} y", age])</span>
                        }
                    </dd>

                    <dt class="col-5 text-muted">@T["Gender"]</dt>
                    <dd class="col-7">@(patient.Gender is { } gender ? T[gender].Value : dash)</dd>
                </dl>
                <h2 class="h6 mt-3">@T["Medical information"]</h2>
                <dl class="row mb-0">
                    <dt class="col-5 text-muted">@T["Blood type"]</dt>
                    <dd class="col-7">@(patient.BloodType ?? dash)</dd>

                    <dt class="col-5 text-muted">@T["Height"]</dt>
                    <dd class="col-7">@(patient.HeightCm != null ? T["{0} cm", patient.HeightCm].Value : dash)</dd>

                    <dt class="col-5 text-muted">@T["Weight"]</dt>
                    <dd class="col-7">@(patient.Weight != null ? T["{0} kg", patient.Weight].Value : dash)</dd>

                    <dt class="col-5 text-muted">@T["Allergies"]</dt>
                    <dd class="col-7 clinical-text" dir="auto">@(patient.Allergies ?? notRecorded)</dd>

                    <dt class="col-5 text-muted">@T["Chronic diseases"]</dt>
                    <dd class="col-7 clinical-text" dir="auto">@(patient.ChronicDiseases ?? notRecorded)</dd>

                    <dt class="col-5 text-muted">@T["Notes"]</dt>
                    <dd class="col-7 clinical-text" dir="auto">@(patient.Notes ?? dash)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-telephone me-2" aria-hidden="true"></i>@T["Contact information"]</div>
            <div class="card-body">
                <h2 class="h6 text-muted">@T["Phone numbers"]</h2>
                @if (!patient.Phones.Any())
                {
                    <p class="text-muted small">@T["No phone numbers added."]</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var ph in patient.Phones)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
                                <span class="contact-value">
                                    <span dir="ltr">@ph.PhoneNumber</span>
                                    <span class="badge bg-light text-dark border ms-1">@T[ph.PhoneType]</span>
                                    @if (ph.IsPrimary)
                                    {
                                        <span class="badge bg-primary ms-1">@T["Primary"]</span>
                                    }
                                </span>
                                <form asp-action="RemovePhone" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="patientId" value="@patient.Id" />
                                    <input type="hidden" name="phoneId" value="@ph.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="@T["Remove this phone?"]">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>@T["Remove phone"]
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <button type="button"
                        class="btn btn-sm btn-outline-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#addPhoneModal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
                    @T["Add phone"]
                </button>

                <hr />

                <h2 class="h6 text-muted">@T["Addresses"]</h2>
                @if (!patient.Addresses.Any())
                {
                    <p class="text-muted small">@T["No addresses added."]</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var a in patient.Addresses)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0 flex-wrap gap-2">
                                <span class="small contact-value" dir="auto">@a.Street, @a.City @(a.Governorate != null ? $", {a.Governorate}" : "")</span>
                                <form asp-action="RemoveAddress" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="patientId" value="@patient.Id" />
                                    <input type="hidden" name="addressId" value="@a.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="@T["Remove this address?"]">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>@T["Remove address"]
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                }
                <button type="button" class="btn btn-outline-primary"
                        data-bs-toggle="modal" data-bs-target="#addAddressModal">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>@T["Add address"]
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade"
     id="addPhoneModal"
     tabindex="-1"
     aria-labelledby="addPhoneTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddPhone" method="post" id="addPhoneForm" data-contact-modal="true">
                @Html.AntiForgeryToken()
                <input type="hidden" name="patientId" value="@patient.Id" />

                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="addPhoneTitle">@T["Add phone"]</h2>
                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@T["Close"]"></button>
                </div>

                <div class="modal-body">
                    <p class="text-muted" dir="auto">@patient.FullName</p>

                    <div id="addPhoneError"
                         class="alert alert-danger"
                         role="alert"
                         tabindex="-1"
                         hidden data-modal-error="true"></div>

                    <div class="mb-3">
                        <label for="newPhoneNumber" class="form-label">@T["Phone number"]</label>
                        <input id="newPhoneNumber"
                               name="PhoneNumber"
                               type="tel"
                               autocomplete="tel"
                               maxlength="20"
                               required
                               dir="ltr"
                               class="form-control" data-modal-focus="true"/>
                    </div>

                    <div>
                        <label for="newPhoneType" class="form-label">@T["Type"]</label>
                        <select id="newPhoneType"
                                name="PhoneType"
                                class="form-select">
                            <option value="Mobile">@T["Mobile"]</option>
                            <option value="Home">@T["Home"]</option>
                            <option value="Work">@T["Work"]</option>
                        </select>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">@T["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@T["Save phone"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="addAddressModal" tabindex="-1"
     aria-labelledby="addAddressTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="AddAddress" method="post" data-contact-modal>
                @Html.AntiForgeryToken()
                <input type="hidden" name="patientId" value="@patient.Id" />
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="addAddressTitle">@T["Add address"]</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted" dir="auto">@patient.FullName</p>
                    <div class="alert alert-danger" role="alert" tabindex="-1"
                         data-modal-error hidden></div>
                    <div class="mb-3">
                        <label for="addressStreet" class="form-label">@T["Street"]</label>
                        <input id="addressStreet" name="Street" class="form-control"
                               maxlength="200" autocomplete="street-address" data-modal-focus />
                    </div>
                    <div class="mb-3">
                        <label for="addressCity" class="form-label">@T["City (required)"]</label>
                        <input id="addressCity" name="City" class="form-control"
                               maxlength="50" autocomplete="address-level2" required />
                    </div>
                    <div>
                        <label for="addressGovernorate" class="form-label">@T["Governorate"]</label>
                        <input id="addressGovernorate" name="Governorate" class="form-control"
                               maxlength="50" autocomplete="address-level1" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">@T["Cancel"]</button>
                    <button type="submit" class="btn btn-primary">@T["Save address"]</button>
                </div>
            </form>
        </div>
    </div>
</div>
