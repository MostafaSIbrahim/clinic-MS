@model UpdatePatientMedicalRequest
@{
    ViewData["Title"] = "Edit Medical Info";
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-heart-pulse me-2"></i>Edit Medical Information</div>
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Gender" class="form-label">Gender</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">— Select —</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="BloodType" class="form-label">Blood Type</label>
                    <select asp-for="BloodType" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var bt in new[] { "APositive","ANegative","BPositive","BNegative","ABPositive","ABNegative","OPositive","ONegative" })
                        {
                            <option value="@bt">@bt</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="HeightCm" class="form-label">Height (cm)</label>
                    <input asp-for="HeightCm" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Weight" class="form-label">Weight (kg)</label>
                    <input asp-for="Weight" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Allergies" class="form-label">Allergies</label>
                    <textarea asp-for="Allergies" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="ChronicDiseases" class="form-label">Chronic Diseases</label>
                    <textarea asp-for="ChronicDiseases" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
