@model IEnumerable<MedicalAnalysisDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    ViewData["Title"] = "Analysis Request Slip";
    Layout = null;
    var first = Model.First();
    var patient = ViewBag.Patient as PatientDto;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Analysis Request Slip</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    @* Branding: retain the logo when printing the standalone analysis slip. *@
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    <style>
        body { padding: 30px; }
        @@media print {
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="no-print mb-3 d-flex gap-2">
        <button class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        @if (first.RecordId is int visitRecordId)
        {
            @* P5b: lab tests requested from a visit return to that visit's Lab tab. *@
            <a class="btn btn-success" asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@visitRecordId" asp-route-tab="lab">
                <i class="bi bi-arrow-return-left"></i> @T["Back to the visit"]
            </a>
        }
        <a class="btn btn-outline-secondary" href="/Analysis/PatientAnalyses?patientId=@first.PatientId">Back to Patient Analyses</a>
    </div>

    <div class="border-bottom pb-2 mb-3">
        @* Branding: the logo identifies the clinic; the heading identifies the document. *@
        @await Html.PartialAsync("_ClinicLogo", "clinic-logo--print")
        <h4 class="mb-0">Laboratory Analysis Request</h4>
        <small class="text-muted">Printed @DateTime.Now.ToString("dd MMM yyyy, HH:mm")</small>
    </div>

    <dl class="row">
        <dt class="col-2">Patient</dt>
        <dd class="col-4">@first.PatientName (#@first.PatientId)</dd>
        <dt class="col-2">Age / Gender</dt>
        <dd class="col-4">@(patient?.Age?.ToString() ?? "—") / @(patient?.Gender ?? "—")</dd>

        <dt class="col-2">Doctor</dt>
        <dd class="col-4">@first.DoctorName</dd>
        <dt class="col-2">Phone</dt>
        <dd class="col-4">@(patient?.Phones.FirstOrDefault(p => p.IsPrimary)?.PhoneNumber ?? patient?.Phones.FirstOrDefault()?.PhoneNumber ?? "—")</dd>

        <dt class="col-2">Date</dt>
        <dd class="col-4">@first.RequestDate.ToString("dd MMM yyyy")</dd>
        <dt class="col-2">National ID</dt>
        <dd class="col-4">@(patient?.NationalId ?? "—")</dd>
    </dl>

    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>#</th>
                <th>Analysis</th>
                <th>Urgent</th>
                <th>Preparation Instructions</th>
            </tr>
        </thead>
        <tbody>
            @{ int i = 1; }
            @foreach (var a in Model)
            {
                <tr>
                    <td>@(i++)</td>
                    <td>@a.AnalysisTypeName</td>
                    <td>@(a.IsUrgent ? "Yes" : "—")</td>
                    <td>@(string.IsNullOrWhiteSpace(a.PreparationInstructions) ? "—" : a.PreparationInstructions)</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="small text-muted mt-4">Please bring this slip to the laboratory to complete the requested analyses.</p>
</body>
</html>
