@model MedicalAnalysisDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M3c: one lab request. Shared layout, the patient header, status badge, English and Arabic. The update form
    // starts from the saved result date and notes, so changing only the status no longer clears them.
    // Lab rules are unchanged (D9).
    ViewData["Title"] = Model.AnalysisTypeName;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var requested = Clock.ToClinicTime(DateTime.SpecifyKind(Model.RequestDate, DateTimeKind.Utc)).ToString("dd MMM yyyy", inv);
    var statuses = new[] { "Requested", "InProgress", "Completed", "Cancelled" };
    var canManage = await Can.HasAsync(Permissions.Analyses.Manage);
    var canDelete = await Can.HasAsync(Permissions.Attachments.Delete);
}
<div class="page-toolbar">
    <div>
        <h1 dir="auto">@Model.AnalysisTypeName</h1>
        <p class="text-muted mb-0">@T["Requested on {0}", requested] · <partial name="_StatusBadge" model="Model.Status" />
            @if (Model.IsUrgent)
            {
                <span class="app-status app-status--due ms-1">@T["Urgent"]</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a asp-action="PrintRequestSlip" asp-route-ids="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-secondary">
            <i class="bi bi-printer" aria-hidden="true"></i> @T["Print request form"]<span class="visually-hidden"> (@T["opens in a new tab"])</span>
        </a>
        @if (Model.RecordId is int recordId)
        {
            <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@recordId" asp-route-tab="lab" class="btn btn-outline-secondary">@T["Back to the record"]</a>
        }
        <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="lab" class="btn btn-outline-secondary">@T["All lab requests"]</a>
    </div>
</div>

@await Component.InvokeAsync("PatientHeader", new { patientId = Model.PatientId })

<div class="row g-3">
    <div class="col-lg-7">
        <app-card id="analysis-details" title="@T["Details"].Value" level="2" icon="bi-info-circle">
            <dl class="row mb-0">
                <dt class="col-sm-4">@T["Doctor"]</dt>
                <dd class="col-sm-8" dir="auto">@T["Dr. {0}", Model.DoctorName]</dd>
                <dt class="col-sm-4">@T["Status"]</dt>
                <dd class="col-sm-8"><partial name="_StatusBadge" model="Model.Status" /></dd>
                <dt class="col-sm-4">@T["Urgent"]</dt>
                <dd class="col-sm-8">@(Model.IsUrgent ? T["Yes"] : T["No"])</dd>
                <dt class="col-sm-4">@T["Preparation"]</dt>
                <dd class="col-sm-8" dir="auto">@(string.IsNullOrWhiteSpace(Model.PreparationInstructions) ? "—" : Model.PreparationInstructions)</dd>
                <dt class="col-sm-4">@T["Result date"]</dt>
                <dd class="col-sm-8">@(Model.ResultDate?.ToString("dd MMM yyyy", inv) ?? "—")</dd>
                <dt class="col-sm-4">@T["Result notes"]</dt>
                <dd class="col-sm-8 clinical-text" dir="auto">@(string.IsNullOrWhiteSpace(Model.ResultNotes) ? "—" : Model.ResultNotes)</dd>
            </dl>
        </app-card>

        <app-card id="analysis-attachments" title="@T["Results files"].Value" level="2" icon="bi-paperclip">
            @if (!Model.Attachments.Any())
            {
                <p class="text-muted small mb-2">@T["No attachments."]</p>
            }
            else
            {
                <ul class="list-unstyled mb-2">
                    @foreach (var a in Model.Attachments)
                    {
                        <li class="d-flex justify-content-between align-items-center gap-2 mb-1">
                            <button type="button" class="btn btn-link p-0 text-start" dir="auto"
                                    onclick="showAttachmentPreview('@Url.Action("ViewAttachment", new { attachmentId = a.Id })', '@Url.Action("DownloadAttachment", new { attachmentId = a.Id })', '@a.FileName')">
                                @a.FileName
                            </button>
                            @if (canDelete)
                            {
                                <form asp-action="DeleteAttachment" method="post" class="d-inline" data-confirm="@T["Delete this attachment?"]">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="attachmentId" value="@a.Id" />
                                    <input type="hidden" name="analysisId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">@T["Delete {0}", a.FileName]</span>
                                    </button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            }
            @if (canManage)
            {
                <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="analysisId" value="@Model.Id" />
                    <input type="file" name="file" class="form-control form-control-sm" accept=".pdf,.jpg,.jpeg,.png" aria-label="@T["Attachment (PDF, JPG or PNG)"]" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">@T["Upload"]</button>
                </form>
            }
        </app-card>
    </div>

    @if (canManage)
    {
        <div class="col-lg-5">
            <app-card id="analysis-update" title="@T["Status and result"].Value" level="2" icon="bi-arrow-repeat">
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label for="analysis-status" class="form-label">@T["Status"]</label>
                        <select id="analysis-status" name="Status" class="form-select">
                            @foreach (var s in statuses)
                            {
                                <option value="@s" selected="@(Model.Status == s)">@T[Labels.Humanize(s)]</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label for="analysis-result-date" class="form-label">@T["Result date"]</label>
                        <input type="date" id="analysis-result-date" name="ResultDate" class="form-control" value="@Model.ResultDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label for="analysis-result-notes" class="form-label">@T["Result notes"]</label>
                        <textarea id="analysis-result-notes" name="ResultNotes" class="form-control" rows="4" dir="auto">@Model.ResultNotes</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">@T["Save"]</button>
                </form>
            </app-card>
        </div>
    }
</div>

@section Scripts {
    @await Html.PartialAsync("_AttachmentPreviewModal")
}
