@model IEnumerable<MedicalAnalysisDto>
@{
    ViewData["Title"] = "Medical Analyses";
    var patientId = ViewBag.PatientId;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-clipboard2-pulse me-2"></i>Medical Analyses</span>
        <div class="d-flex gap-2">
            @if (Model.Any(a => a.Status == "Requested"))
            {
                <a asp-action="PrintPatientRequests" asp-route-patientId="@patientId" target="_blank" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-printer me-1"></i>Print Request Form
                </a>
            }
            <a asp-action="Request" asp-route-patientId="@patientId" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Request Analysis
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-clipboard-x fs-1 d-block mb-2 opacity-50"></i>
                No analyses requested.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr><th>Type</th><th>Status</th><th>Urgent</th><th>Requested</th><th>Result Date</th><th>Record</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.AnalysisTypeName</td>
                            <td>
                                @{
                                    var cls = a.Status switch
                                    {
                                        "Completed" => "bg-success",
                                        "InProgress" => "bg-warning text-dark",
                                        "Cancelled" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @cls">@a.Status</span>
                            </td>
                            <td>@(a.IsUrgent ? "🔴" : "—")</td>
                            <td>@a.RequestDate.ToString("dd MMM yyyy")</td>
                            <td>@(a.ResultDate?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>
                                @if (a.RecordId != null)
                                {
                                    <a asp-controller="MedicalRecords" asp-action="Details" asp-route-id="@a.RecordId" class="small">
                                        <i class="bi bi-file-medical"></i> #@a.RecordId
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
