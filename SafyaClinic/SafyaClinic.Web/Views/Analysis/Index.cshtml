@model PagedResult<MedicalAnalysisDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@{
    // M3c: the lab list. Shared filter bar, table (cards on phones), status badges, English and Arabic.
    // Search first and the lab rules are unchanged (D9).
    ViewData["Title"] = T["Lab requests"].Value;
    var statuses = new[] { "Requested", "InProgress", "Completed", "Cancelled" };
    string D(DateTime utc) => Clock.ToClinicTime(DateTime.SpecifyKind(utc, DateTimeKind.Utc)).ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var startHint = new EmptyStateModel(T["Find lab requests"].Value, Icon: "bi-search",
        Hint: T["Enter a patient name or analysis, or choose a status, then select Search."].Value);
    var noMatch = new EmptyStateModel(T["No lab requests match this search."].Value, Icon: "bi-clipboard-x");
}
<div class="page-toolbar">
    <div>
        <h1>@T["Lab requests"]</h1>
        <p class="text-muted mb-0">@T["Search every patient's lab requests and results."]</p>
    </div>
</div>

<app-filter-bar label="@T["Find lab requests"].Value" submit-text="@T["Search"].Value" action="@Url.Action("Index")" clear-url="@Url.Action("Index")">
    <div class="app-filter-bar__field">
        <label for="analysisSearch" class="form-label">@T["Patient name or analysis"]</label>
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" id="analysisSearch" autocomplete="off" />
    </div>
    <div class="app-filter-bar__field">
        <label for="analysisStatus" class="form-label">@T["Status"]</label>
        <select name="status" id="analysisStatus" class="form-select">
            <option value="">@T["All statuses"]</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(ViewBag.Status == s)">@T[Labels.Humanize(s)]</option>
            }
        </select>
    </div>
</app-filter-bar>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (!ViewData.ModelState.IsValid)
{
    <p class="text-muted">@T["Check the search above and try again."]</p>
}
else if (ViewBag.HasSearch != true)
{
    <partial name="_AppEmpty" model="startHint" />
}
else if (Model == null || !Model.Items.Any())
{
    <partial name="_AppEmpty" model="noMatch" />
}
else
{
    <app-table caption="@T["Lab requests"].Value" caption-hidden="true" stack="true">
        <thead>
            <tr>
                <th scope="col">@T["Patient"]</th>
                <th scope="col">@T["Analysis"]</th>
                <th scope="col">@T["Status"]</th>
                <th scope="col">@T["Requested on"]</th>
                <th scope="col">@T["Result date"]</th>
                <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Items)
            {
                <tr>
                    <th scope="row" data-label="@T["Patient"]" dir="auto">
                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@a.PatientId" asp-route-tab="lab">@a.PatientName</a>
                    </th>
                    <td data-label="@T["Analysis"]" dir="auto">
                        @a.AnalysisTypeName
                        @if (a.IsUrgent)
                        {
                            <span class="app-status app-status--due ms-1">@T["Urgent"]</span>
                        }
                    </td>
                    <td data-label="@T["Status"]"><partial name="_StatusBadge" model="a.Status" /></td>
                    <td data-label="@T["Requested on"]">@D(a.RequestDate)</td>
                    <td data-label="@T["Result date"]">@(a.ResultDate is DateTime done ? done.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture) : "—")</td>
                    <td class="app-table__actions">
                        <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary">@T["Open"]<span class="visually-hidden"> @a.AnalysisTypeName, @a.PatientName</span></a>
                    </td>
                </tr>
            }
        </tbody>
    </app-table>
}

@if (Model != null)
{
    <partial name="_AppPagination" model="SafyaClinic.Web.Components.PagerModel.From(Model)" />
}
