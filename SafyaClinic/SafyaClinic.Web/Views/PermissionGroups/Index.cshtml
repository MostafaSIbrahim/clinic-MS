@model IReadOnlyList<PermissionGroupSummary>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M5b: permission groups. Shared layout, a table that becomes cards on phones, English and Arabic. Rules unchanged (F4).
    ViewData["Title"] = T["Permission Groups"].Value;
}
<div class="page-toolbar">
    <div>
        <h1>@T["Permission Groups"]</h1>
        <p class="text-muted mb-0">@T["What each group of users may see and do. A user's access is everything their groups allow."]</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary">@T["Users"]</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> @T["New group"]</a>
    </div>
</div>

<app-table caption="@T["Permission Groups"].Value" caption-hidden="true" stack="true">
    <thead>
        <tr>
            <th scope="col">@T["Group"]</th>
            <th scope="col">@T["Description"]</th>
            <th scope="col" class="app-table__num">@T["Permissions"]</th>
            <th scope="col" class="app-table__num">@T["Members"]</th>
            <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var g in Model)
        {
            <tr>
                <th scope="row" data-label="@T["Group"]" dir="auto">
                    @T[g.Name]
                    @if (g.SystemKey is not null)
                    {
                        <span class="app-status app-status--booked ms-1">@T["Built-in"]</span>
                    }
                </th>
                <td data-label="@T["Description"]" class="clinical-text" dir="auto">@(g.Description is { } d ? T[d].Value : "—")</td>
                <td data-label="@T["Permissions"]" class="app-table__num">@g.PermissionCount</td>
                <td data-label="@T["Members"]" class="app-table__num">@g.MemberCount</td>
                <td class="app-table__actions">
                    <a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-sm btn-outline-primary">@T["Open"]<span class="visually-hidden"> @T[g.Name]</span></a>
                </td>
            </tr>
        }
    </tbody>
</app-table>
