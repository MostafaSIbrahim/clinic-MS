@model SafyaClinic.Web.Models.PermissionGroupFormModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M5b: a new permission group. Shared fields, English and Arabic. Rules unchanged (F4).
    ViewData["Title"] = T["New permission group"].Value;
}
<div class="page-toolbar">
    <div>
        <h1>@T["New permission group"]</h1>
        <p class="text-muted mb-0">@T["Name the group; you choose its permissions and members next."]</p>
    </div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">@T["Back to groups"]</a></div>
</div>

<div class="card record-form-card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>
            <app-field asp-for="Name" label="@T["Group name"].Value" required="true" />
            <app-field asp-for="Description" label="@T["Description"].Value" type="textarea" rows="3" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Create group"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>
