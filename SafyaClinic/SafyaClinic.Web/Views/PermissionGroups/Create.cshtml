@model SafyaClinic.Web.Models.PermissionGroupFormModel
@{
    ViewData["Title"] = "New Permission Group";
}
<div class="page-toolbar">
    <div><h1>New permission group</h1><p class="text-muted mb-0">Name the group; you choose its permissions and members next.</p></div>
    <div class="page-actions"><a asp-action="Index" class="btn btn-outline-secondary">Back to groups</a></div>
</div>
<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="100" required />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" maxlength="300" rows="3"></textarea>
            </div>
            <div class="form-actions"><button type="submit" class="btn btn-primary">Create group</button></div>
        </form>
    </div>
</div>
