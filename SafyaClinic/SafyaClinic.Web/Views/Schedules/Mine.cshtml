@model IReadOnlyList<SafyaClinic.Application.Scheduling.ScheduleSummaryDto>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@{
    ViewData["Title"] = T["My schedule"].Value;
    var notClinician = new EmptyStateModel(T["Only doctors and nutritionists have a calendar."].Value, Icon: "bi-calendar-x");
    var noClinics = new EmptyStateModel(T["No active clinics yet."].Value, Icon: "bi-calendar-x");
}
<h1>@T["My schedule"]</h1>
<p class="text-muted">@T["Your calendar in each clinic. Without a calendar you can be booked at any time the clinic is open."]</p>

@if (ViewBag.IsClinician != true)
{
    <partial name="_AppEmpty" model="notClinician" />
}
else if (Model.Count == 0)
{
    <partial name="_AppEmpty" model="noClinics" />
}
else
{
    ViewData["ShowDoctor"] = false;
    <partial name="_ScheduleList" model="Model" />
}
