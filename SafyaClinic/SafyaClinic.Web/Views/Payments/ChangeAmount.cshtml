@model ChangePaymentAmountRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M2c: change a collected payment's amount, with a reason. In English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Change payment amount"].Value;
    var payment = ViewBag.Payment as PaymentDto;
}
<div class="page-toolbar">
    <div>
        <h1>@T["Change payment amount"]</h1>
        @if (payment is not null)
        {
            <p class="text-muted mb-0">@T["Payment #{0}", payment.Id]</p>
        }
    </div>
</div>

@if (payment is not null)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId = payment.PatientId })
}

<div class="card payment-form-card">
    <div class="card-body">
        @if (payment is not null)
        {
            <div class="alert alert-info">
                @T["Current amount: {0}. If a first-visit source or clinic deduction was applied, it is recalculated in proportion to the new amount.", payment.Amount.ToMoney()]
            </div>
        }
        <form asp-action="ChangeAmount" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="PaymentId" />

            <app-field asp-for="NewAmount" label="@T["New amount"].Value" type="number" required="true" />
            <app-field asp-for="Reason" label="@T["Reason for the change"].Value" type="textarea" rows="3" required="true" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Save change"]</button>
                @if (payment is not null)
                {
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@payment.PatientId" asp-route-tab="payments" class="btn btn-outline-secondary">@T["Back to payments"]</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
