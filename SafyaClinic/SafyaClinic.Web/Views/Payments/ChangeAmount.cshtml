@model ChangePaymentAmountRequest
@{
    ViewData["Title"] = "Change Payment Amount";
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><i class="bi bi-pencil-square me-2"></i>Change Payment Amount</div>
    <div class="card-body">
        <div class="alert alert-info">
            Current amount: <strong>@(((decimal)ViewBag.CurrentAmount).ToString("C"))</strong>.
            If a first-visit source/clinic deduction was applied, it will be recalculated proportionally
            against the new amount.
        </div>
        <form asp-action="ChangeAmount" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="PaymentId" />

            <div class="mb-3">
                <label asp-for="NewAmount" class="form-label">New Amount *</label>
                <input asp-for="NewAmount" type="number" step="0.01" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label">Reason for Change *</label>
                <textarea asp-for="Reason" class="form-control" rows="3" required></textarea>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Change</button>
            <a asp-action="Report" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
