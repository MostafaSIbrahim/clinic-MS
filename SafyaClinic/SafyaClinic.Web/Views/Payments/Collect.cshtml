@model CollectPaymentRequest
@using SafyaClinic.Application.DTOs.Settings
@{
    ViewData["Title"] = "Collect Payment";
    var clinics = ViewBag.Clinics as IEnumerable<ClinicDto> ?? Enumerable.Empty<ClinicDto>();
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><i class="bi bi-cash-coin me-2"></i>Collect Payment</div>
    <div class="card-body">
        <form asp-action="Collect" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="ReservationId" />
            <input type="hidden" asp-for="EnrollmentId" />

            <div class="mb-3">
                <label asp-for="ClinicId" class="form-label">Clinic *</label>
                <select asp-for="ClinicId" class="form-select" required>
                    <option value="">— Select Clinic —</option>
                    @foreach (var c in clinics)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <small class="text-muted">
                    If this is the patient's first visit, the clinic + patient source agreement will
                    automatically determine the deduction applied to this payment.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label">Amount *</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
                <small class="text-muted">
                    Pre-filled with the current due balance — adjust it for a partial or flexible payment.
                </small>
            </div>

            <div class="mb-3">
                <label asp-for="PaymentMethod" class="form-label">Payment Method</label>
                <select asp-for="PaymentMethod" class="form-select">
                    <option value="Cash">Cash</option>
                    <option value="CreditCard">Credit Card</option>
                    <option value="BankTransfer">Bank Transfer</option>
                    <option value="Insurance">Insurance</option>
                    <option value="MobilePayment">Mobile Payment</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="ReferenceNumber" class="form-label">Reference Number</label>
                <input asp-for="ReferenceNumber" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>

            <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Collect Payment</button>
            <a asp-action="PatientSummary" asp-route-patientId="@Model.PatientId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
