@model CollectPaymentRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Application.DTOs.Settings
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // M2c: collect a payment. Shared form fields, the patient header, in English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Collect payment"].Value;
    var clinics = (ViewBag.Clinics as IEnumerable<ClinicDto> ?? Enumerable.Empty<ClinicDto>())
        .Select(c => new SelectListItem(c.Name, c.Id.ToString(), c.Id == Model.ClinicId)).ToList();
    var methods = new[] { "Cash", "CreditCard", "BankTransfer", "Insurance", "MobilePayment" }
        .Select(m => new SelectListItem(T[Labels.Humanize(m)].Value, m, m == Model.PaymentMethod)).ToList();
}
<div class="page-toolbar">
    <div>
        <h1>@T["Collect payment"]</h1>
        <p class="text-muted mb-0">
            @if (Model.ReservationId.HasValue)
            {
                @T["For reservation #{0}", Model.ReservationId]
            }
            else if (Model.EnrollmentId.HasValue)
            {
                @T["For nutrition enrollment #{0}", Model.EnrollmentId]
            }
        </p>
    </div>
</div>

@await Component.InvokeAsync("PatientHeader", new { patientId = Model.PatientId })

<div class="card payment-form-card">
    <div class="card-body">
        <form asp-action="Collect" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="ReservationId" />
            <input type="hidden" asp-for="EnrollmentId" />

            <app-field asp-for="ClinicId" label="@T["Clinic"].Value" type="select" asp-items="clinics" option-label="@T["Choose…"].Value" required="true"
                       hint="@T["On a patient's first visit, the clinic and patient source agreement sets the deduction for this payment."].Value" />
            <app-field asp-for="Amount" label="@T["Amount"].Value" type="number" required="true"
                       hint="@T["For a partial payment, enter less than the balance. The balance is checked again when you save."].Value" />
            <app-field asp-for="PaymentMethod" label="@T["Payment method"].Value" type="select" asp-items="methods" />
            <app-field asp-for="ReferenceNumber" label="@T["Reference number"].Value" />
            <app-field asp-for="Notes" label="@T["Notes"].Value" type="textarea" rows="2" />

            <div class="form-actions">
                <button type="submit" class="btn btn-success">@T["Collect Payment"]</button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="payments" class="btn btn-outline-secondary">@T["Back to payments"]</a>
                @* P6b: not paying? Excuse the balance instead, with a reason. *@
                @if (Model.ReservationId.HasValue && await Can.HasAsync(Permissions.Payments.WriteOff))
                {
                    <a asp-action="WriteOff" asp-route-patientId="@Model.PatientId" asp-route-reservationId="@Model.ReservationId" class="btn btn-outline-warning">@T["Write off instead"]</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
