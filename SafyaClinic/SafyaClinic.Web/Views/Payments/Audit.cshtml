@model PaymentAuditDto
@{
    Layout = null;
    var payment = Model.Payment;
    var history = Model.Adjustments;
}

<div class="mb-3">
    <h5 class="mb-1">Payment #@payment.Id</h5>
    <div class="text-muted">@payment.PatientName</div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card bg-primary-soft">
            <div class="small">Original Amount</div>
            <div class="fs-3 fw-bold">
                @(payment.OriginalAmount?.ToString("C") ?? "Not recorded")
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-teal-soft">
            <div class="small">Current Recorded Amount</div>
            <div class="fs-3 fw-bold">@payment.Amount.ToString("C")</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-amber-soft">
            <div class="small">Payment Status</div>
            <div class="fs-3 fw-bold">@payment.Status</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between gap-2">
        <span>
            <i class="bi bi-journal-text me-2"></i>
            Adjustment History (@history.TotalCount)
        </span>
        <small class="text-muted">Newest first · Timestamps in UTC</small>
    </div>

    @if (!history.Items.Any())
    {
        <div class="card-body text-center py-5">
            <i class="bi bi-check-circle text-success fs-1"></i>
            <h5 class="mt-3">No adjustments recorded</h5>
            <p class="text-muted mb-0">
                No amount changes or cancellations are recorded for this payment.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date / Time (UTC)</th>
                        <th>Action</th>
                        <th>Previous Amount</th>
                        <th>New Amount</th>
                        <th>Reason</th>
                        <th>Performed By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var adjustment in history.Items)
                    {
                        var actionLabel = adjustment.ActionType switch
                        {
                            "AmountChanged" => "Amount changed",
                            "Cancelled" => "Cancelled",
                            _ => adjustment.ActionType
                        };

                        <tr>
                            <td class="text-nowrap">
                                @adjustment.PerformedAt.ToString("dd MMM yyyy HH:mm")
                            </td>
                            <td>
                                <span class="badge @(adjustment.ActionType == "Cancelled" ? "bg-danger" : "bg-primary")">
                                    @actionLabel
                                </span>
                            </td>
                            <td>@(adjustment.OldAmount?.ToString("C") ?? "—")</td>
                            <td>@(adjustment.NewAmount?.ToString("C") ?? "—")</td>
                            <td style="min-width:180px; white-space:pre-wrap; overflow-wrap:anywhere;">@(string.IsNullOrWhiteSpace(adjustment.Reason) ? "—" : adjustment.Reason)</td>
                            <td>
                                <div>@adjustment.PerformedByName</div>
                                <small class="text-muted">User #@adjustment.PerformedBy</small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (history.TotalPages > 1)
{
    <nav aria-label="Audit history pages"
         class="d-flex justify-content-between align-items-center mt-4">
        <div>
            @if (history.HasPrev)
            {
                <a asp-action="Audit"
                   asp-route-paymentId="@payment.Id"
                   asp-route-page="@(history.Page - 1)"
                   asp-route-pageSize="@history.PageSize"
                   class="btn btn-sm btn-outline-primary">
                    Previous
                </a>
            }
        </div>

        <span class="small text-muted">
            Page @history.Page of @history.TotalPages
        </span>

        <div>
            @if (history.HasNext)
            {
                <a asp-action="Audit"
                   asp-route-paymentId="@payment.Id"
                   asp-route-page="@(history.Page + 1)"
                   asp-route-pageSize="@history.PageSize"
                   class="btn btn-sm btn-outline-primary">
                    Next
                </a>
            }
        </div>
    </nav>
}