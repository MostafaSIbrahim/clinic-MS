@model PaymentAuditDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M2c: the payment's history, shown in the dialog on the Payments tab. In English and Arabic.
    Layout = null;
    var payment = Model.Payment;
    var history = Model.Adjustments;
}
<div class="mb-3">
    <h3 class="h6 mb-1">@T["Payment #{0}", payment.Id]</h3>
    <div class="text-muted" dir="auto">@payment.PatientName</div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card bg-primary-soft">
            <div class="small">@T["Original amount"]</div>
            <div class="fs-3 fw-bold">@(payment.OriginalAmount?.ToMoney() ?? T["Not recorded"].Value)</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-teal-soft">
            <div class="small">@T["Current amount"]</div>
            <div class="fs-3 fw-bold">@payment.Amount.ToMoney()</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-amber-soft">
            <div class="small">@T["Status"]</div>
            <div class="fs-3 fw-bold">@T[payment.Status == "WrittenOff" ? "Written off" : payment.Status == "Cancelled" ? "Cancelled (void)" : "Active"]</div>
        </div>
    </div>
</div>

<h3 class="h6">@T["Changes ({0}), newest first", history.TotalCount]</h3>
@if (!history.Items.Any())
{
    <p class="text-muted">@T["No amount changes, cancellations or write-offs are recorded for this payment."]</p>
}
else
{
    <div class="app-table-wrap">
        <table class="app-table">
            <caption class="visually-hidden">@T["Changes to this payment"]</caption>
            <thead>
                <tr>
                    <th scope="col">@T["Date and time"]</th>
                    <th scope="col">@T["Action"]</th>
                    <th scope="col" class="app-table__num">@T["Previous amount"]</th>
                    <th scope="col" class="app-table__num">@T["New amount"]</th>
                    <th scope="col">@T["Reason"]</th>
                    <th scope="col">@T["By"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adjustment in history.Items)
                {
                    var actionLabel = adjustment.ActionType switch
                    {
                        "AmountChanged" => T["Amount changed"].Value,
                        "Cancelled" => T["Cancelled (void)"].Value,
                        "WrittenOff" => T["Written off"].Value,              // P6b
                        "WriteOffCancelled" => T["Write-off undone"].Value,  // P6b
                        _ => adjustment.ActionType
                    };
                    <tr>
                        <td class="text-nowrap">@Clock.ToClinicTime(adjustment.PerformedAt).ToString("dd MMM yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@actionLabel</td>
                        <td class="app-table__num">@(adjustment.OldAmount?.ToMoney() ?? "—")</td>
                        <td class="app-table__num">@(adjustment.NewAmount?.ToMoney() ?? "—")</td>
                        <td class="audit-reason" dir="auto">@(string.IsNullOrWhiteSpace(adjustment.Reason) ? "—" : adjustment.Reason)</td>
                        <td dir="auto">@adjustment.PerformedByName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (history.TotalPages > 1)
{
    @* payment-audit.js loads these links inside the dialog. *@
    <nav aria-label="@T["Results pages"]" class="d-flex justify-content-between align-items-center mt-3">
        <div>
            @if (history.HasPrev)
            {
                <a asp-action="Audit" asp-route-paymentId="@payment.Id" asp-route-page="@(history.Page - 1)" asp-route-pageSize="@history.PageSize"
                   class="btn btn-sm btn-outline-primary">@T["Previous"]</a>
            }
        </div>
        <span class="small text-muted">@T["Page {0} of {1}", history.Page, history.TotalPages]</span>
        <div>
            @if (history.HasNext)
            {
                <a asp-action="Audit" asp-route-paymentId="@payment.Id" asp-route-page="@(history.Page + 1)" asp-route-pageSize="@history.PageSize"
                   class="btn btn-sm btn-outline-primary">@T["Next"]</a>
            }
        </div>
    </nav>
}
