@model PaymentDashboardDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Web.Components
@{
    ViewData["Title"] = T["Payment Dashboard"].Value;
    var from = ViewBag.From as DateTime?;
    var to = ViewBag.To as DateTime?;
    var allTime = ViewBag.All == true;
    string Iso(DateTime? d) => d?.ToString("yyyy-MM-dd") ?? "";
    string D(DateTime d) => d.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    var period = allTime ? T["All time"].Value
        : from is DateTime f && to is DateTime t ? T["{0} to {1}", D(f), D(t)].Value
        : from is DateTime f2 ? T["From {0}", D(f2)].Value
        : to is DateTime t2 ? T["Until {0}", D(t2)].Value
        : T["All time"].Value;
    var noData = new EmptyStateModel(T["No payments in this period."].Value, Icon: "bi-inbox");
    var noWriteOffs = new EmptyStateModel(T["No write-offs in this period."].Value, Icon: "bi-inbox");
}
@* M2b: the full payment dashboard (clinic managers and admin). Collected and written-off figures are for the
   chosen period (this month by default); unpaid lists cover every balance owed, a page at a time. *@
<div class="page-toolbar">
    <div>
        <h1>@T["Payment Dashboard"]</h1>
        <p class="text-muted mb-0">@T["Period: {0}", period]</p>
    </div>
</div>

<app-filter-bar label="@T["Payment period"].Value" submit-text="@T["Show"].Value" clear-url="@Url.Action("Dashboard")">
    <div class="app-filter-bar__field">
        <label for="filterFrom" class="form-label">@T["From"]</label>
        <input type="date" id="filterFrom" name="from" value="@Iso(from)" class="form-control" />
    </div>
    <div class="app-filter-bar__field">
        <label for="filterTo" class="form-label">@T["To"]</label>
        <input type="date" id="filterTo" name="to" value="@Iso(to)" class="form-control" />
    </div>
</app-filter-bar>
<p class="small text-muted">
    @T["The period applies to collected and written-off amounts. Unpaid lists show every balance still owed."]
    <a asp-action="Dashboard" asp-route-all="true">@T["Show all time"]</a>
</p>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card bg-rose-soft">
            <div class="small opacity-75">@T["Unpaid: finished visits"]</div>
            <div class="fs-3 fw-bold">@Model.TotalUnpaidCompleted.ToMoney()</div>
            <div class="small">@T["{0} visit(s)", Model.UnpaidCompletedCount]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card bg-primary-soft">
            <div class="small opacity-75">@T["Unpaid: in consultation"]</div>
            <div class="fs-3 fw-bold">@Model.TotalUnpaidPending.ToMoney()</div>
            <div class="small">@T["{0} visit(s)", Model.UnpaidPendingCount]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card bg-teal-soft">
            <div class="small opacity-75">@T["Fully paid"]</div>
            <div class="fs-3 fw-bold">@Model.TotalFullyPaid.ToMoney()</div>
            <div class="small">@T["{0} payment(s)", Model.FullyPaidPaymentCount]</div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="stat-card bg-amber-soft">
            <div class="small opacity-75">@T["Written off (not revenue)"]</div>
            <div class="fs-3 fw-bold">@Model.TotalWrittenOff.ToMoney()</div>
        </div>
    </div>
</div>

<partial name="_UnpaidSections" model="Model" />

<div class="row g-3">
    <div class="col-lg-6">
        <app-card id="by-source" title="@T["Amount by patient source"].Value" level="2" icon="bi-diagram-3">
            @if (!Model.AmountBySource.Any())
            {
                <partial name="_AppEmpty" model="noData" />
            }
            else
            {
                <app-table caption="@T["Amount by patient source"].Value" caption-hidden="true" stack="true">
                    <thead>
                        <tr>
                            <th scope="col">@T["Source"]</th>
                            <th scope="col" class="app-table__num">@T["Payments"]</th>
                            <th scope="col" class="app-table__num">@T["Collected"]</th>
                            <th scope="col" class="app-table__num">@T["Source deduction"]</th>
                            <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.AmountBySource)
                        {
                            var label = s.PatientSourceId is null ? T["No source"].Value : s.PatientSourceName;
                            <tr>
                                <th scope="row" data-label="@T["Source"]" dir="auto">@label</th>
                                <td data-label="@T["Payments"]" class="app-table__num">@s.PaymentCount</td>
                                <td data-label="@T["Collected"]" class="app-table__num fw-semibold">@s.TotalCollected.ToMoney()</td>
                                <td data-label="@T["Source deduction"]" class="app-table__num">@s.TotalSourceDeduction.ToMoney()</td>
                                <td class="app-table__actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-drilldown"
                                            data-group-type="source" data-group-id="@(s.PatientSourceId?.ToString() ?? "")" data-group-label="@label">
                                        @T["Details"]<span class="visually-hidden"> @label</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </app-table>
            }
        </app-card>
    </div>

    <div class="col-lg-6">
        <app-card id="by-clinic" title="@T["Amount by clinic"].Value" level="2" icon="bi-hospital">
            @if (!Model.AmountByClinic.Any())
            {
                <partial name="_AppEmpty" model="noData" />
            }
            else
            {
                <app-table caption="@T["Amount by clinic"].Value" caption-hidden="true" stack="true">
                    <thead>
                        <tr>
                            <th scope="col">@T["Clinic"]</th>
                            <th scope="col" class="app-table__num">@T["Payments"]</th>
                            <th scope="col" class="app-table__num">@T["Collected"]</th>
                            <th scope="col" class="app-table__num">@T["Clinic net"]</th>
                            <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.AmountByClinic)
                        {
                            var label = c.ClinicId is null ? T["No clinic"].Value : c.ClinicName;
                            <tr>
                                <th scope="row" data-label="@T["Clinic"]" dir="auto">@label</th>
                                <td data-label="@T["Payments"]" class="app-table__num">@c.PaymentCount</td>
                                <td data-label="@T["Collected"]" class="app-table__num fw-semibold">@c.TotalCollected.ToMoney()</td>
                                <td data-label="@T["Clinic net"]" class="app-table__num">@c.TotalClinicNet.ToMoney()</td>
                                <td class="app-table__actions">
                                    <button type="button" class="btn btn-sm btn-outline-primary js-drilldown"
                                            data-group-type="clinic" data-group-id="@(c.ClinicId?.ToString() ?? "")" data-group-label="@label">
                                        @T["Details"]<span class="visually-hidden"> @label</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </app-table>
            }
        </app-card>
    </div>
</div>

@* P6b: write-offs in the period, by reason. Never counted as collected money. *@
<app-card id="written-off" title="@T["Written off by reason"].Value" level="2" icon="bi-slash-circle">
    @if (!Model.WrittenOffByReason.Any())
    {
        <partial name="_AppEmpty" model="noWriteOffs" />
    }
    else
    {
        <app-table caption="@T["Written off by reason"].Value" caption-hidden="true" stack="true">
            <thead>
                <tr>
                    <th scope="col">@T["Reason"]</th>
                    <th scope="col" class="app-table__num">@T["Write-offs"]</th>
                    <th scope="col" class="app-table__num">@T["Amount"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.WrittenOffByReason)
                {
                    <tr>
                        <th scope="row" data-label="@T["Reason"]">@T[Labels.Humanize(r.Reason)]</th>
                        <td data-label="@T["Write-offs"]" class="app-table__num">@r.Count</td>
                        <td data-label="@T["Amount"]" class="app-table__num fw-semibold">@r.Amount.ToMoney()</td>
                    </tr>
                }
            </tbody>
        </app-table>
    }
</app-card>

@* Line details: choose dates, then the report loads inside the dialog (Payments/DashboardLineDetails). *@
<div class="modal fade" id="drilldownModal" tabindex="-1" aria-labelledby="drilldownModalTitle" aria-hidden="true"
     data-url="@Url.Action("DashboardLineDetails", "Payments")"
     data-from="@Iso(from)" data-to="@Iso(to)"
     data-title="@T["Payment details: {0}", "{0}"]"
     data-error-order="@T["The start date must be on or before the end date."]"
     data-error-load="@T["Could not load the details. Please try again."]">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="drilldownModalTitle">@T["Payment details"]</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@T["Close"]"></button>
            </div>
            <div class="modal-body">
                <div id="drilldownStepDuration">
                    <p class="text-muted">@T["Choose the dates for these details, or leave a date empty for no limit on that side."]</p>
                    <form id="drilldownDurationForm" class="d-flex flex-wrap align-items-end gap-2">
                        <div>
                            <label for="drilldownFrom" class="form-label">@T["From"]</label>
                            <input type="date" id="drilldownFrom" class="form-control" />
                        </div>
                        <div>
                            <label for="drilldownTo" class="form-label">@T["To"]</label>
                            <input type="date" id="drilldownTo" class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary">@T["Show"]</button>
                        <button type="button" id="drilldownAllTimeBtn" class="btn btn-outline-secondary">@T["All time"]</button>
                    </form>
                </div>
                <div id="drilldownStepLoading" class="text-center text-muted py-4 d-none" role="status">
                    <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@T["Loading…"]
                </div>
                <div id="drilldownStepError" class="alert alert-danger d-none" role="alert"></div>
                <div id="drilldownStepReport" class="d-none" aria-live="polite"></div>
            </div>
            <div class="modal-footer">
                <button type="button" id="drilldownBackBtn" class="btn btn-outline-secondary d-none">@T["Change dates"]</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@T["Close"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/payment-dashboard.js" asp-append-version="true"></script>
}
