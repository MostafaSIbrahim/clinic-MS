@model PatientFinancialSummaryDto
@{
    ViewData["Title"] = "Payment Summary";
}

<div class="page-toolbar">
    <div>
        <h1>@Model.PatientName</h1>
        <p class="text-muted mb-0">Payment summary</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Patients" asp-action="Details"
           asp-route-id="@Model.PatientId" class="btn btn-outline-secondary">Patient workspace</a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Payment dashboard</a>
    </div>
</div>


<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card bg-primary-soft">
            <div class="small opacity-75">Total Charged</div>
            <div class="fs-3 fw-bold">@Model.TotalCharged.ToString("C")</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card bg-teal-soft">
            <div class="small opacity-75">Total Paid</div>
            <div class="fs-3 fw-bold">@Model.TotalPaid.ToString("C")</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card bg-amber-soft">
            <div class="small opacity-75">Written Off (Cancelled)</div>
            <div class="fs-3 fw-bold">@Model.TotalWrittenOff.ToString("C")</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card @(Model.CollectibleBalance > 0 ? "bg-rose-soft" : "bg-teal-soft")">
            <div class="small opacity-75">Collectible Balance</div>

            @if (Model.UnallocatedCoverage > 0)
            {
                <div class="fw-semibold mt-2">Needs reconciliation</div>
                <div class="small mt-1">
                    Existing payments need to be linked before collecting more.
                </div>
            }
            else
            {
                <div class="fs-3 fw-bold">
                    @Model.CollectibleBalance.ToString("C")
                </div>
            }
        </div>
    </div>
</div>
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-cash-coin me-2"></i>Ready for collection
    </div>

    <div class="card-body">
        <p class="small text-muted">Balances currently eligible for collection.</p>
        @if (Model.UnallocatedCoverage > 0)
        {
            <div class="alert alert-warning mb-0">
                This patient has
                <strong>@Model.UnallocatedCoverage.ToString("C")</strong>
                in payments or write-offs that are not linked to a reservation
                or nutrition enrollment. Reconcile these records before
                collecting additional payment.
            </div>
        }
        else if (Model.PendingPayments.Count == 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted">No collectible balance at this time.</span>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        disabled>
                    <i class="bi bi-check-circle me-1"></i>No Payment Due
                </button>
            </div>
        }
        else
        {
            @* Review fix: distinguish the collectible balances table from payment history. *@
            <div class="table-responsive" tabindex="0" role="region" aria-label="Ready for collection">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col">Service</th>
                            <th scope="col">Clinic</th>
                            <th scope="col">Remaining Amount</th>
                            @* Review fix: name the action column for assistive technology. *@
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PendingPayments)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    @item.Date.ToString("dd MMM yyyy")
                                </td>
                                <td>@item.Description</td>
                                <td>@(item.ClinicName ?? "Select during collection")</td>
                                <td class="fw-semibold text-danger">
                                    @item.AmountDue.ToString("C")
                                </td>
                                <td class="text-end">
                                    <a asp-action="Collect"
                                       asp-route-patientId="@Model.PatientId"
                                       asp-route-reservationId="@item.ReservationId"
                                       asp-route-enrollmentId="@item.EnrollmentId"
                                       class="btn btn-sm btn-success">
                                        <i class="bi bi-cash-coin me-1"></i>Collect
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div class="card">
    <div class="card-header">
        <span><i class="bi bi-receipt me-2"></i>Payment History</span>
    </div>
    
    <div class="card-body p-0">
        @if (!Model.Payments.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-receipt-cutoff fs-1 d-block mb-2 opacity-50"></i>
                No payments recorded.
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Payment history">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Date</th><th scope="col">Amount</th><th scope="col">Method</th><th scope="col">Clinic</th><th scope="col">Source</th>
                            <th scope="col">Deduction</th><th scope="col">Clinic Net</th><th scope="col">Status</th><th scope="col">Collected By</th>
                            <th scope="col"><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var p in Model.Payments)
                    {
                        <tr class="@(p.Status == "Cancelled" ? "text-muted text-decoration-line-through" : "")">
                            <td>@p.PaymentDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td class="fw-semibold">
                                @p.Amount.ToString("C")
                                @if (p.OriginalAmount.HasValue && p.OriginalAmount.Value != p.Amount)
                                {
                                    <br /><small class="text-muted">was @p.OriginalAmount.Value.ToString("C")</small>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                            <td>@(p.ClinicName ?? "—")</td>
                            <td>@(p.PatientSourceName ?? "—")</td>
                            <td>
                                @if (p.IsFirstVisitDeduction)
                                {
                                    <span class="badge bg-warning text-dark">@p.DeductionPercentage%  (@p.SourceDeductionAmount.ToString("C"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>@p.ClinicNetAmount.ToString("C")</td>
                            <td>
                                @if (p.Status == "Active")
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary" title="@p.CancellationReason">Cancelled</span>
                                }
                            </td>
                            <td>@p.CollectorName</td>
                            <td class="text-nowrap">
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary js-payment-audit"
                                        data-audit-url="@Url.Action("Audit", "Payments", new { paymentId = p.Id })">
                                    <i class="bi bi-clock-history me-1"></i>Audit History
                                </button>
                                
                                @if (p.Status == "Active")
                                {
                                    <a asp-action="ChangeAmount" asp-route-paymentId="@p.Id" class="btn btn-sm btn-outline-primary" title="Change amount">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Cancel" asp-route-paymentId="@p.Id" class="btn btn-sm btn-outline-danger" title="Cancel payment">
                                        <i class="bi bi-x-lg"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<div class="modal fade"
     id="paymentAuditModal"
     tabindex="-1"
     aria-labelledby="paymentAuditTitle"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentAuditTitle">
                    <i class="bi bi-clock-history me-2"></i>Payment Audit History
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body" id="paymentAuditBody" aria-live="polite"></div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modalElement = document.getElementById('paymentAuditModal');
            const body = document.getElementById('paymentAuditBody');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            let activeRequest = null;

            async function loadAudit(url) {
                activeRequest?.abort();
                const request = new AbortController();
                activeRequest = request;

                body.innerHTML = `
                            <div class="text-center text-muted py-5" role="status">
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true"></span>
                                Loading audit history…
                            </div>`;

                try {
                    const response = await fetch(url, {
                        credentials: 'same-origin',
                        signal: request.signal
                    });

                    if (response.redirected ||
                        response.status === 401 ||
                        response.status === 403) {
                        throw new Error(
                            'Your session expired or you do not have access. Refresh the page and sign in again.');
                    }

                    if (!response.ok) {
                        throw new Error('Could not load payment audit history.');
                    }

                    const html = await response.text();

                    if (activeRequest !== request) return;

                    body.innerHTML = html;
                    body.scrollTop = 0;
                } catch (error) {
                    if (request.signal.aborted || activeRequest !== request) return;

                    body.replaceChildren();
                    const alert = document.createElement('div');
                    alert.className = 'alert alert-danger mb-0';
                    alert.setAttribute('role', 'alert');
                    alert.textContent = error.message ||
                        'Could not load payment audit history.';
                    body.appendChild(alert);
                }
            }

            document.querySelectorAll('.js-payment-audit').forEach(button => {
                button.addEventListener('click', () => {
                    modal.show();
                    loadAudit(button.dataset.auditUrl);
                });
            });

            body.addEventListener('click', event => {
                const link = event.target.closest('nav a');

                if (!link || !body.contains(link)) return;

                event.preventDefault();
                loadAudit(link.href);
            });

            modalElement.addEventListener('hidden.bs.modal', () => {
                activeRequest?.abort();
                activeRequest = null;
                body.replaceChildren();
            });
        })();
    </script>
}
