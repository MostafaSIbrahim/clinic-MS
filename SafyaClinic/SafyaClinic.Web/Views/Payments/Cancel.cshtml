@model CancelPaymentRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // P6a, M2c: cancel (void) a payment, with a reason. In English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Cancel payment"].Value;
    var payment = ViewBag.Payment as PaymentDto;
}
<div class="page-toolbar">
    <div>
        <h1>@T["Cancel payment"]</h1>
        @if (payment is not null)
        {
            <p class="text-muted mb-0">@T["Payment #{0}: {1}", payment.Id, payment.Amount.ToMoney()]</p>
        }
    </div>
</div>

@if (payment is not null)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId = payment.PatientId })
}

<div class="card payment-form-card">
    <div class="card-body">
        <div class="alert alert-warning">
            @T["Cancelling voids this payment, as if it was never collected: it stops counting as revenue and the amount becomes due again on the visit. Use it for a payment entered by mistake. This is recorded in the payment's history and cannot be undone from here."]
        </div>
        <form asp-action="Cancel" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="PaymentId" />

            <app-field asp-for="Reason" label="@T["Reason for cancelling"].Value" type="textarea" rows="3" required="true" />

            <div class="form-actions">
                <button type="submit" class="btn btn-danger">@T["Cancel this payment"]</button>
                @if (payment is not null)
                {
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@payment.PatientId" asp-route-tab="payments" class="btn btn-outline-secondary">@T["Back to payments"]</a>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
