@model IEnumerable<PaymentDto>
@{
    ViewData["Title"] = "Payment Report";
}

<div class="page-toolbar">
    <h1 class="mb-0"><i class="bi bi-bar-chart me-2"></i>Payment Report</h1>
    @* Payment access: doctors have report access without collection dashboard access. *@
    @if (User.IsInRole("Admin") || User.IsInRole("Reception") || User.IsInRole("ReceptionAdmin"))
    {
    <a asp-action="Dashboard" class="btn btn-sm btn-outline-primary"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
    }
</div>

<div class="card">
    <div class="card-body pb-0">
        <div class="filter-panel mb-3">
            @* Search-first: leave dates empty initially and require an explicit report range. *@
            <form asp-action="Report" method="get" class="row g-2 align-items-end">
                @* Payment access: reception cannot choose a historical period. *@
                <input type="hidden" name="run" value="true" />
                @if (ViewBag.TodayOnly == true)
                {
                    <div class="col-auto"><span class="form-label">Today — @(((DateTime)ViewBag.From).ToString("dd MMM yyyy")) (Cairo)</span></div>
                }
                else
                {
                <div class="col-md-3">
                    <label for="filterFrom" class="form-label small mb-1">From</label>
                    <input type="date" id="filterFrom" name="from" value="@(((DateTime?)ViewBag.From)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-3">
                    <label for="filterTo" class="form-label small mb-1">To</label>
                    <input type="date" id="filterTo" name="to" value="@(((DateTime?)ViewBag.To)?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" required />
                </div>
                }
                <div class="col-auto">
                    <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
                    <a asp-action="Report" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>

        @* Search-first: only show totals after a successful report request, never before searching. *@
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        @if (ViewBag.HasSearch == true && ViewData.ModelState.IsValid)
        {
            <div class="alert alert-info d-flex justify-content-between">
                <span>Total for period (active payments)</span>
                <strong>@(((decimal)ViewBag.Total).ToString("C"))</strong>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <p class="text-muted py-3">Check the date range above and try again.</p>
        }
        else if (ViewBag.HasSearch != true)
        {
            <div class="empty-state" role="status">@(ViewBag.TodayOnly == true ? "Select Filter to load today’s payments." : "Choose a start and end date, then select Filter to load the payment report. Dates and times use Cairo time.")</div>
        }
        else if (!Model.Any())
        {
            <div class="text-center text-muted py-5">No payments found for the selected date range.</div>
        }
        else
        {
            @* Review fix: make the horizontally scrolling results keyboard-accessible. *@
            <div class="table-responsive" tabindex="0" role="region" aria-label="Payment report results">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr><th scope="col">Date</th><th scope="col">Patient</th><th scope="col">Amount</th><th scope="col">Method</th><th scope="col">Clinic</th><th scope="col">Source</th><th scope="col">Status</th><th scope="col">Collected By</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr class="@(p.Status == "Cancelled" ? "text-muted text-decoration-line-through" : "")">
                                <td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(p.PaymentDate, DateTimeKind.Utc), (TimeZoneInfo)ViewBag.ReportTimeZone).ToString("dd MMM yyyy HH:mm")</td>
                                <td>@p.PatientName</td>
                                <td class="fw-semibold">@p.Amount.ToString("C")</td>
                                <td><span class="badge bg-light text-dark border">@p.PaymentMethod</span></td>
                                <td>@(p.ClinicName ?? "â€”")</td>
                                <td>@(p.PatientSourceName ?? "â€”")</td>
                                <td>
                                    @if (p.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </td>
                                <td>@p.CollectorName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
