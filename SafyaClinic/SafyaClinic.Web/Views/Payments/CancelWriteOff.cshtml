@model CancelWriteOffRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // P6b, M2c: undo a write-off, with a reason. In English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Undo write-off"].Value;
    var payment = ViewBag.Payment as PaymentDto;
}
<div class="page-toolbar">
    <div><h1>@T["Undo write-off"]</h1></div>
</div>

@if (payment is not null)
{
    @await Component.InvokeAsync("PatientHeader", new { patientId = payment.PatientId })
}

<div class="card payment-form-card">
    <div class="card-body">
        @if (payment is not null)
        {
            var reason = T[Labels.Humanize(payment.WriteOffReason ?? "Before P6")].Value;
            <div class="alert alert-warning">
                @(payment.ReservationId.HasValue
                    ? T["Write-off of {0} on reservation #{1} ({2}). Undoing it makes this amount due again. This is recorded in the audit log.", payment.Amount.ToMoney(), payment.ReservationId, reason]
                    : T["Write-off of {0} ({1}). Undoing it makes this amount due again. This is recorded in the audit log.", payment.Amount.ToMoney(), reason])
            </div>
        }
        <form asp-action="CancelWriteOff" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="PaymentId" />
            <app-field asp-for="Reason" label="@T["Reason"].Value" type="textarea" rows="3" required="true" />
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">@T["Undo write-off"]</button>
                @if (payment is not null)
                {
                    <a asp-controller="Patients" asp-action="Details" asp-route-id="@payment.PatientId" asp-route-tab="payments" class="btn btn-outline-secondary">@T["Back to payments"]</a>
                }
            </div>
        </form>
    </div>
</div>
