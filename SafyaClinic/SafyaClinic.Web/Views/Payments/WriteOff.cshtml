@model WriteOffRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    // P6b, M2c: excuse a visit's balance with a reason. In English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Write off balance"].Value;
    var due = ViewBag.Due as decimal? ?? 0m;
    var reasons = new[] { "Discount", "Hardship", "StaffOrFamily", "BillingError", "Other" }
        .Select(r => new SelectListItem(T[Labels.Humanize(r)].Value, r, r == Model.Reason)).ToList();
}
<div class="page-toolbar">
    <div>
        <h1>@T["Write off balance"]</h1>
        <p class="text-muted mb-0">@T["For reservation #{0}", Model.ReservationId]</p>
    </div>
</div>

@await Component.InvokeAsync("PatientHeader", new { patientId = Model.PatientId })

<div class="card payment-form-card">
    <div class="card-body">
        <div class="alert alert-warning">
            @T["Remaining balance: {0}. A write-off excuses this amount: the visit counts as covered, but it is not revenue and is reported separately. It is recorded with your name and reason in the audit log, and can be undone.", due.ToMoney()]
        </div>
        <form asp-action="WriteOff" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="ReservationId" />

            <app-field asp-for="Amount" label="@T["Amount to write off"].Value" type="number" required="true"
                       hint="@T["Up to the remaining balance. Write off part of it to leave the rest to collect."].Value" />
            <app-field asp-for="Reason" label="@T["Reason"].Value" type="select" asp-items="reasons" option-label="@T["Choose…"].Value" required="true" />
            <app-field asp-for="Note" label="@T["Note"].Value" type="textarea" rows="2" hint="@T["Required when the reason is Other."].Value" />

            <div class="form-actions">
                <button type="submit" class="btn btn-warning">@T["Write off"]</button>
                <a asp-controller="Patients" asp-action="Details" asp-route-id="@Model.PatientId" asp-route-tab="payments" class="btn btn-outline-secondary">@T["Back to payments"]</a>
            </div>
        </form>
    </div>
</div>
