@model IEnumerable<SafyaClinic.Domain.Entities.MedicalRecord.TreatmentType>

@{
    ViewData["Title"] = "أنواع العلاج والجلسات";
}

<div class="container-fluid py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-bandaid text-primary me-2"></i>أنواع العلاج والجلسات
            </h3>
            <p class="text-muted mb-0">إدارة وتحديد أنواع الجلسات والعلاجات والأسعار الافتراضية</p>
        </div>
        <div>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#treatmentTypeModal" onclick="openCreateModal()">
                <i class="bi bi-plus-lg me-1"></i> إضافة نوع علاج جديد
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-1">
                <i class="bi bi-arrow-right me-1"></i> رجوع للقوائم
            </a>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>اسم العلاج / الجلسة</th>
                            <th>التصنيف</th>
                            <th>السعر الافتراضي</th>
                            <th>الوصف</th>
                            <th>الحالة</th>
                            <th class="text-end pe-4">الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@index</td>
                                    <td class="fw-semibold">@item.TypeName</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.Category</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">@item.DefaultCost ج.م</span>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 250px;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">غير نشط</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="تعديل"
                                                    onclick="openEditModal(@item.Id, '@item.TypeName', '@((int)item.Category)', @item.DefaultCost, '@(item.Description ?? "")', @item.IsActive.ToString().ToLower())">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    title="حذف"
                                                    onclick="confirmDelete(@item.Id, '@item.TypeName')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    لا توجد بيانات مسجلة لأنواع العلاجات حتى الآن.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create / Edit Modal -->
<div class="modal fade" id="treatmentTypeModal" tabindex="-1" aria-labelledby="treatmentTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="treatmentTypeForm" method="post" asp-action="SaveTreatmentType">
                @Html.AntiForgeryToken()
                <input type="hidden" id="treatmentTypeId" name="Id" value="0" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="treatmentTypeModalLabel">إضافة نوع علاج جديد</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="treatmentName" class="form-label required">اسم العلاج / الجلسة</label>
                        <input type="text" class="form-control" id="treatmentName" name="Name" required placeholder="مثال: جلسة علاج طبيعي، كشف تخصصي..." />
                    </div>

                    <div class="mb-3">
                        <label for="treatmentCategory" class="form-label required">التصنيف</label>
                        <select class="form-select" id="treatmentCategory" name="Category" required asp-items="Html.GetEnumSelectList<SafyaClinic.Domain.Enums.TreatmentCategory>()">
                            <option value="">-- اختر التصنيف --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="treatmentPrice" class="form-label required">السعر الافتراضي (ج.م)</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="treatmentPrice" name="Price" required placeholder="0.00" />
                    </div>

                    <div class="mb-3">
                        <label for="treatmentDescription" class="form-label">الوصف / ملاحظات</label>
                        <textarea class="form-control" id="treatmentDescription" name="Description" rows="3" placeholder="ملاحظات تفصيلية حول الجلسة..."></textarea>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="treatmentIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label" for="treatmentIsActive">تفعيل نوع العلاج</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i> حفظ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="deleteForm" method="post" asp-action="DeleteTreatmentType">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteTreatmentTypeId" name="id" value="" />
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-circle text-danger display-4 mb-3 d-block"></i>
                    <h6 class="fw-bold mb-2">تأكيد الحذف</h6>
                    <p class="text-muted small mb-0">هل أنت متأكد من حذف "<span id="deleteTreatmentTypeName" class="fw-bold text-dark"></span>"؟</p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-sm btn-danger px-3">حذف</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openCreateModal() {
            document.getElementById('treatmentTypeModalLabel').innerText = 'إضافة نوع علاج جديد';
            document.getElementById('treatmentTypeId').value = '0';
            document.getElementById('treatmentName').value = '';
            document.getElementById('treatmentCategory').value = '';
            document.getElementById('treatmentPrice').value = '';
            document.getElementById('treatmentDescription').value = '';
            document.getElementById('treatmentIsActive').checked = true;
        }

        function openEditModal(id, name, category, price, description, isActive) {
            document.getElementById('treatmentTypeModalLabel').innerText = 'تعديل نوع العلاج';
            document.getElementById('treatmentTypeId').value = id;
            document.getElementById('treatmentName').value = name;
            document.getElementById('treatmentCategory').value = category;
            document.getElementById('treatmentPrice').value = price;
            document.getElementById('treatmentDescription').value = description;
            document.getElementById('treatmentIsActive').checked = isActive;

            const modal = new bootstrap.Modal(document.getElementById('treatmentTypeModal'));
            modal.show();
        }

        function confirmDelete(id, name) {
            document.getElementById('deleteTreatmentTypeId').value = id;
            document.getElementById('deleteTreatmentTypeName').innerText = name;

            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}