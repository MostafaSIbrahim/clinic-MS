@model IEnumerable<SafyaClinic.Domain.Entities.MedicalRecord.TreatmentType>
@using SafyaClinic.Domain.Enums

@{
    ViewData["Title"] = "Treatment Types";
}

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-bandaid-fill text-primary me-2"></i>أنواع الزيارات            </h1>
            <p class="text-muted small mb-0">Manage clinic procedures, services, and default pricing</p>
        </div>
        <button type="button" class="btn btn-primary shadow-sm" onclick="openCreateModal()">
            <i class="bi bi-plus-lg me-1"></i> Add Treatment Type
        </button>
    </div>

    <!-- Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show border-0 shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Name</th>
                            <th>Category</th>
                            <th>Default Cost</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2 opacity-50"></i>
                                    No treatment types found. Click <strong>Add Treatment Type</strong> to create one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-semibold">
                                        @(string.IsNullOrWhiteSpace(item.TypeName) ? "(Unnamed Treatment)" : item.TypeName)
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            @item.Category
                                        </span>
                                    </td>
                                    <td class="fw-bold text-primary">
                                        @item.DefaultCost<span class="text-muted small fw-normal">EGP</span>
                                    </td>
                                    <td class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1 small"></i>Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                <i class="bi bi-x-circle-fill me-1 small"></i>Inactive
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-1">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary btn-edit-treatment"
                                                    data-id="@item.Id"
                                                    data-typename="@(item.TypeName ?? "")"
                                                    data-category="@((int)item.Category)"
                                                    data-defaultcost="@item.DefaultCost"
                                                    data-description="@(item.Description ?? "")"
                                                    data-active="@item.IsActive.ToString().ToLower()">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </button>
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="confirmDelete(@item.Id, '@(item.TypeName ?? "Unnamed")')">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create / Edit Modal -->
<div class="modal fade" id="treatmentTypeModal" tabindex="-1" aria-labelledby="treatmentTypeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="SaveTreatmentType" asp-controller="Lookups" method="post" id="treatmentTypeForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="treatmentTypeId" name="Id" value="0" />

                <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold" id="treatmentTypeModalLabel">
                        <i class="bi bi-plus-circle me-2 text-primary"></i><span>Add Treatment Type</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="treatmentTypeName" class="form-label fw-semibold">
                            Treatment Name <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control" id="treatmentTypeName" name="TypeName" required placeholder="e.g. Clinical Examination, Dental Scaling" />
                    </div>

                    <div class="mb-3">
                        <label for="treatmentTypeCategory" class="form-label fw-semibold">Category</label>
                        <select class="form-select" id="treatmentTypeCategory" name="Category" asp-items="Html.GetEnumSelectList<SafyaClinic.Domain.Enums.TreatmentCategory>()">
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="treatmentTypeDefaultCost" class="form-label fw-semibold">
                            Default Cost <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">EGP</span>
                            <input type="number" step="0.01" min="0" class="form-control" id="treatmentTypeDefaultCost" name="DefaultCost" required placeholder="0.00" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="treatmentTypeDescription" class="form-label fw-semibold">Description</label>
                        <textarea class="form-control" id="treatmentTypeDescription" name="Description" rows="3" placeholder="Optional treatment notes or details..."></textarea>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="treatmentTypeIsActive" name="IsActive" value="true" checked />
                        <label class="form-check-label fw-semibold" for="treatmentTypeIsActive">Active Status</label>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <form id="deleteForm" asp-action="DeleteTreatmentType" asp-controller="Lookups" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteTreatmentTypeId" name="id" value="" />
                <div class="modal-body text-center p-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger display-5 mb-3 d-block"></i>
                    <h6 class="fw-bold mb-2">Confirm Deletion</h6>
                    <p class="text-muted small mb-0">
                        Are you sure you want to delete <span id="deleteTreatmentTypeName" class="fw-bold text-dark"></span>?
                    </p>
                </div>
                <div class="modal-footer justify-content-center border-0 pt-0 pb-4">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function openCreateModal() {
            $('#treatmentTypeModalLabel span').text('Add Treatment Type');
            $('#treatmentTypeModalLabel i').attr('class', 'bi bi-plus-circle me-2 text-primary');

            $('#treatmentTypeId').val(0);
            $('#treatmentTypeName').val('');
            $('#treatmentTypeCategory').prop('selectedIndex', 0);
            $('#treatmentTypeDefaultCost').val('');
            $('#treatmentTypeDescription').val('');
            $('#treatmentTypeIsActive').prop('checked', true);

            var modal = new bootstrap.Modal(document.getElementById('treatmentTypeModal'));
            modal.show();
        }

        $(document).on('click', '.btn-edit-treatment', function() {
            var btn = $(this);
            var id = btn.data('id');
            var typeName = btn.data('typename');
            var category = btn.data('category');
            var defaultCost = btn.data('defaultcost');
            var description = btn.data('description');
            var isActive = btn.data('active');

            $('#treatmentTypeModalLabel span').text('Edit Treatment Type');
            $('#treatmentTypeModalLabel i').attr('class', 'bi bi-pencil-square me-2 text-primary');

            $('#treatmentTypeId').val(id);
            $('#treatmentTypeName').val(typeName);
            $('#treatmentTypeCategory').val(category);
            $('#treatmentTypeDefaultCost').val(defaultCost);
            $('#treatmentTypeDescription').val(description);
            $('#treatmentTypeIsActive').prop('checked', isActive === true || isActive === 'true');

            var modal = new bootstrap.Modal(document.getElementById('treatmentTypeModal'));
            modal.show();
        });

        function confirmDelete(id, name) {
            document.getElementById('deleteTreatmentTypeId').value = id;
            document.getElementById('deleteTreatmentTypeName').innerText = name;
            var modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();
        }
    </script>
}