@model IEnumerable<PatientSourceDto>
@{
    ViewData["Title"] = "Patient Sources";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-signpost-split me-2"></i>Patient Sources</span>
        <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>New Source</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">No patient sources defined yet.</div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr><th>Name</th><th>Description</th><th>Default Deduction %</th><th>Patients</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@s.Name</td>
                            <td>@(s.Description ?? "—")</td>
                            <td>@s.DefaultDeductionPercentage.ToString("0.##")%</td>
                            <td>@s.PatientCount</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete or deactivate this source?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
