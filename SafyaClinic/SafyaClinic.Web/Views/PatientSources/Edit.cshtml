@model UpdatePatientSourceRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M5c: edit patient source. Shared fields, English and Arabic. Rules unchanged.
    ViewData["Title"] = T["Edit patient source"].Value;
}
<div class="page-toolbar">
    <div><h1>@T["Edit patient source"]</h1></div>
</div>

<div class="card record-form-card">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>
            <app-field asp-for="Name" label="@T["Name"].Value" required="true" hint="@T["For example a booking website, social media or a campaign."].Value" />
            <app-field asp-for="Description" label="@T["Description"].Value" type="textarea" rows="2" />
            <app-field asp-for="DefaultDeductionPercentage" label="@T["Default deduction %"].Value" type="number" required="true"
                       hint="@T["Taken from a patient's first-visit payment when the clinic has no agreement of its own."].Value" />
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">@T["Active (offered when registering patients)"]</label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Save changes"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
