@model CreatePatientSourceRequest
@{
    ViewData["Title"] = "New Patient Source";
}

<div class="card" style="max-width:600px;">
    <div class="card-header"><i class="bi bi-signpost-split me-2"></i>New Patient Source</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Name *</label>
                <input asp-for="Name" class="form-control" required placeholder="e.g. Vezeeta, Instagram, Marketing Campaign" />
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="DefaultDeductionPercentage" class="form-label">Default Deduction % *</label>
                <input asp-for="DefaultDeductionPercentage" type="number" step="0.01" min="0" max="100" class="form-control" required />
                <small class="text-muted">
                    Applied to the patient's first-visit payment when no clinic-specific agreement exists.
                </small>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
