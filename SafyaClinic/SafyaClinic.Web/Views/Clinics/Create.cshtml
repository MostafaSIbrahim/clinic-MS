@model CreateClinicRequest
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@{
    // M5c: new clinic. Shared fields, English and Arabic. Rules unchanged.
    ViewData["Title"] = T["New clinic"].Value;
}
<div class="page-toolbar">
    <div><h1>@T["New clinic"]</h1></div>
</div>

<div class="card record-form-card">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert" tabindex="-1"></div>
            <app-field asp-for="Name" label="@T["Name"].Value" required="true" />
            <app-field asp-for="Address" label="@T["Address"].Value" />
            <app-field asp-for="Phone" label="@T["Phone"].Value" type="tel" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["Create clinic"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
