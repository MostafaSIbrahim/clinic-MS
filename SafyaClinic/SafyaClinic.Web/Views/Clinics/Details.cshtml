@model ClinicDto
@inject Microsoft.Extensions.Localization.IStringLocalizer<SafyaClinic.Web.SharedResource> T
@using SafyaClinic.Application.Scheduling
@{
    // M5c: one clinic: opening hours (P1) and patient source agreements. Shared layout, English and Arabic.
    ViewData["Title"] = Model.Name;
    var sources = ViewBag.Sources as IEnumerable<PatientSourceDto> ?? Enumerable.Empty<PatientSourceDto>();
    var agreedSourceIds = Model.Agreements.Select(a => a.PatientSourceId).ToHashSet();
    var openingHours = (ViewBag.OpeningHours as IEnumerable<OpeningPeriodDto> ?? Enumerable.Empty<OpeningPeriodDto>()).ToLookup(p => p.Day);
}

<div class="page-toolbar">
    <div>
        <h1 dir="auto">@Model.Name</h1>
        <p class="text-muted mb-0">
            <span dir="auto">@(Model.Address ?? T["No address on file"].Value)</span>
            @if (Model.Phone != null)
            {
                <span> · </span><span dir="ltr">@Model.Phone</span>
            }
            @if (!Model.IsActive)
            {
                <span class="app-status app-status--cancelled ms-1">@T["Inactive"]</span>
            }
        </p>
    </div>
    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">@T["Edit clinic"]</a>
        <a asp-action="Index" class="btn btn-outline-secondary">@T["All clinics"]</a>
    </div>
</div>

@* P1: opening hours. Bookable times come from these in the pilot's appointments screen. *@
<app-card id="opening-hours" title="@T["Opening hours"].Value" level="2" icon="bi-clock">
    <app-card-actions>
        <a asp-action="Hours" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">@T["Edit opening hours"]</a>
    </app-card-actions>
    @if (!openingHours.Any())
    {
        <p class="text-muted mb-0">@T["No opening hours set yet."]</p>
    }
    else
    {
        <dl class="app-hours mb-0">
            @foreach (var day in ClinicWeek.Days)
            {
                <div class="app-hours__day">
                    <dt>@T[day.ToString()]</dt>
                    <dd>@(openingHours[day].Any() ? string.Join(", ", openingHours[day].Select(p => p.Period.ToString())) : T["Closed"].Value)</dd>
                </div>
            }
        </dl>
    }
</app-card>

<app-card id="source-agreements" title="@T["Patient source agreements"].Value" level="2" icon="bi-percent">
    <p class="text-muted small">@T["How much is deducted from a patient's payment on their first visit when they came from that source and were treated at this clinic. A source without a row here uses its default deduction."]</p>

    @if (!Model.Agreements.Any())
    {
        <p class="text-muted">@T["No agreements yet: every source uses its default deduction."]</p>
    }
    else
    {
        <app-table caption="@T["Patient source agreements"].Value" caption-hidden="true" stack="true">
            <thead>
                <tr>
                    <th scope="col">@T["Source"]</th>
                    <th scope="col" class="app-table__num">@T["Deduction %"]</th>
                    <th scope="col">@T["Notes"]</th>
                    <th scope="col" class="app-table__actions"><span class="visually-hidden">@T["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.Agreements)
                {
                    <tr>
                        <th scope="row" data-label="@T["Source"]" dir="auto">@a.PatientSourceName</th>
                        <td data-label="@T["Deduction %"]" class="app-table__num fw-semibold">@a.DeductionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%</td>
                        <td data-label="@T["Notes"]" dir="auto">@(a.Notes ?? "—")</td>
                        <td class="app-table__actions">
                            <form asp-action="RemoveAgreement" method="post" class="d-inline"
                                  data-confirm="@T["Remove the agreement with {0}? The source's default deduction will apply instead.", a.PatientSourceName]">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="agreementId" value="@a.Id" />
                                <input type="hidden" name="clinicId" value="@Model.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">@T["Remove the agreement with {0}", a.PatientSourceName]</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </app-table>
    }

    <h3 class="h6 mt-3">@T["Add or change an agreement"]</h3>
    <form asp-action="SaveAgreement" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ClinicId" value="@Model.Id" />
        <div class="col-md-4">
            <label for="agreement-source" class="form-label">@T["Patient source"]</label>
            <select id="agreement-source" name="PatientSourceId" class="form-select" required>
                <option value="">@T["Choose a source"]</option>
                @foreach (var s in sources)
                {
                    <option value="@s.Id">@T["{0} (default {1}%)", s.Name, s.DefaultDeductionPercentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)]</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label for="agreement-percent" class="form-label">@T["Deduction %"]</label>
            <input type="number" id="agreement-percent" name="DeductionPercentage" step="0.01" min="0" max="100" class="form-control" required />
        </div>
        <div class="col-6 col-md-3">
            <label for="agreement-notes" class="form-label">@T["Notes"]</label>
            <input type="text" id="agreement-notes" name="Notes" class="form-control" dir="auto" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">@T["Save"]</button>
        </div>
    </form>
</app-card>
