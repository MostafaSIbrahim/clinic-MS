<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Safya Clinic</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" id="wrapper">

        <!-- ── Sidebar ── -->
        <nav id="sidebar" class="bg-dark text-white d-flex flex-column p-0" style="min-width:220px;min-height:100vh">
            <div class="px-3 py-4 border-bottom border-secondary">
                <span class="fs-5 fw-bold"><i class="bi bi-hospital me-2 text-info"></i>Safya Clinic</span>
            </div>

            <ul class="nav flex-column mt-2 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active bg-info bg-opacity-25" : "")"
                       href="/Dashboard">
                        <i class="bi bi-speedometer2 me-2"></i>Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("Nutritionist") || User.IsInRole("Reception"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "active bg-info bg-opacity-25" : "")"
                           href="/Patients">
                            <i class="bi bi-people me-2"></i>Patients
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active bg-info bg-opacity-25" : "")"
                           href="/Reservations">
                            <i class="bi bi-calendar2-week me-2"></i>Reservations
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalRecords" ? "active bg-info bg-opacity-25" : "")"
                           href="/MedicalRecords">
                            <i class="bi bi-file-medical me-2"></i>Medical Records
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" ? "active bg-info bg-opacity-25" : "")"
                           href="/Analysis">
                            <i class="bi bi-clipboard2-pulse me-2"></i>Analysis
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Nutritionist"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Nutrition" ? "active bg-info bg-opacity-25" : "")"
                           href="/Nutrition/Packages">
                            <i class="bi bi-capsule me-2"></i>Nutrition
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Reception"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active bg-info bg-opacity-25" : "")"
                           asp-controller="Payments" asp-action="Report">
                            <i class="bi bi-cash-coin me-2"></i>Payments
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-white @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active bg-info bg-opacity-25" : "")"
                           href="/Users">
                            <i class="bi bi-person-gear me-2"></i>Users
                        </a>
                    </li>
                }
            </ul>

            <div class="border-top border-secondary p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-person-circle fs-5"></i>
                    <span class="small">@User.Identity!.Name</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light w-100">
                        <i class="bi bi-box-arrow-left me-1"></i>Logout
                    </button>
                </form>
            </div>
        </nav>

        <!-- ── Main content ── -->
        <div class="flex-grow-1 d-flex flex-column">

            <!-- Top bar -->
            <header class="bg-white border-bottom px-4 py-2 d-flex align-items-center justify-content-between">
                <h6 class="mb-0 text-muted">@ViewData["Title"]</h6>
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMM yyyy")</small>
            </header>

            <main class="flex-grow-1 p-4">

                <!-- Alert toasts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
