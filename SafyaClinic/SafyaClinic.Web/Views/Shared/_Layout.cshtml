<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Safya Clinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="d-flex" id="wrapper">

        <!-- ── Sidebar ── -->
        <nav id="sidebar" class="d-flex flex-column p-0">
            <div class="px-3 py-4 d-flex align-items-center gap-2">
                <span class="brand-mark"><i class="bi bi-heart-pulse-fill"></i></span>
                <span class="brand-title fs-5">Safya Clinic</span>
            </div>

            <ul class="nav flex-column mt-1 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       href="/Dashboard">
                        <i class="bi bi-speedometer2"></i>Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("Nutritionist") || User.IsInRole("Reception"))
                {
                    <div class="nav-section-label">Care</div>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "active" : "")"
                           href="/Patients">
                            <i class="bi bi-people"></i>Patients
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reservations" ? "active" : "")"
                           href="/Reservations">
                            <i class="bi bi-calendar2-week"></i>Reservations
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                {
                    @* <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MedicalRecords" ? "active" : "")"
                           href="/MedicalRecords">
                            <i class="bi bi-file-medical"></i>Medical Records
                        </a>
                    </li> *@
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" ? "active" : "")"
                           href="/Analysis">
                            <i class="bi bi-clipboard2-pulse"></i>Analysis
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Nutritionist"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Nutrition" ? "active" : "")"
                           href="/Nutrition/Packages">
                            <i class="bi bi-capsule"></i>Nutrition
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Reception"))
                {
                    <div class="nav-section-label">Billing</div>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")"
                           asp-controller="Payments" asp-action="Report">
                            <i class="bi bi-cash-coin"></i>Payments
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="nav-section-label">Administration</div>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clinics" ? "active" : "")"
                           asp-controller="Clinics" asp-action="Index">
                            <i class="bi bi-hospital"></i>Clinics
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PatientSources" ? "active" : "")"
                           asp-controller="PatientSources" asp-action="Index">
                            <i class="bi bi-signpost-split"></i>Patient Sources
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"
                           href="/Users">
                            <i class="bi bi-person-gear"></i>Users
                        </a>
                    </li>
                }
            </ul>

            <div class="sidebar-footer p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="brand-mark" style="width:30px;height:30px;font-size:0.8rem;">
                        @(User.Identity!.Name?.Trim().FirstOrDefault().ToString().ToUpper())
                    </span>
                    <span class="small fw-semibold text-truncate">@User.Identity!.Name</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-left me-1"></i>Logout
                    </button>
                </form>
            </div>
        </nav>

        <!-- ── Main content ── -->
        <div class="flex-grow-1 d-flex flex-column">

            <!-- Top bar -->
            <header class="topbar px-4 py-3 d-flex align-items-center justify-content-between">
                <h6 class="mb-0">@ViewData["Title"]</h6>
                <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMM yyyy")</small>
            </header>

            <main class="flex-grow-1 p-4">

                <!-- Alert toasts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
