@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var isAppointmentBoard =
        currentController == "Reservations" && currentAction == "Board";

    var isDoctorQueue =
        currentController == "Reservations" && currentAction == "Queue";

    var isReservationPage =
        currentController == "Reservations" &&
        !isAppointmentBoard &&
        !isDoctorQueue;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Safya Clinic</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Branding: shared logo styles also used by standalone clinic documents. *@
    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <a href="#mainContent" class="app-skip-link">
        Skip to main content
    </a>
    <div class="d-flex" id="wrapper">

        <!-- ── Sidebar ── -->
        <nav id="sidebar"
             class="offcanvas-lg offcanvas-start d-flex flex-column p-0"
             tabindex="-1"
             aria-labelledby="sidebarTitle">
            <div class="px-3 py-4 d-flex align-items-center gap-2">
                @* Branding: the approved logo replaces the placeholder heart on all application pages. *@
                <span id="sidebarTitle" class="visually-hidden">Safya Clinic navigation</span>
                <a asp-controller="Dashboard" asp-action="Index" class="clinic-brand-link">
                    @await Html.PartialAsync("_ClinicLogo", "clinic-logo--sidebar")
                </a>
               <button type="button"
                        class="btn-close d-lg-none ms-auto"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#sidebar"
                        aria-label="Close navigation"></button>
            </div>

            <ul class="nav flex-column mt-1 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"
                       href="/Dashboard">
                        <i class="bi bi-speedometer2"></i>Dashboard
                    </a>
                </li>

                @if (User.IsInRole("Admin") || User.IsInRole("Doctor") || User.IsInRole("Nutritionist") || User.IsInRole("Reception"))
                {
                    <li class="nav-section-label" role="presentation">Care</li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Patients" ? "active" : "")"
                           href="/Patients">
                            <i class="bi bi-people"></i>Patients
                        </a>
                    </li>
                    <li class="nav-item">
                    <a class="nav-link @(isAppointmentBoard ? "active" : "")"
                       asp-controller="Reservations"
                       asp-action="Board"
                       aria-current="@(isAppointmentBoard ? "page" : null)">
                        <i class="bi bi-calendar3"></i>Appointment Board
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link @(isReservationPage ? "active" : "")"
                       asp-controller="Reservations"
                       asp-action="Index"
                       aria-current="@(isReservationPage ? "page" : null)">
                        <i class="bi bi-calendar2-week"></i>Reservations
                    </a>
                </li>
                }

                    @if (User.IsInRole("Admin") ||
                             User.IsInRole("Reception") ||
                             User.IsInRole("Doctor"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isDoctorQueue ? "active" : "")"
                               asp-controller="Reservations"
                               asp-action="Queue"
                               aria-current="@(isDoctorQueue ? "page" : null)">
                                <i class="bi bi-people"></i>
                                @(User.IsInRole("Admin") || User.IsInRole("Reception")
                                    ? "Doctor Queues"
                                    : "My Queue")
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "FollowUps" ? "active" : "")"
                               asp-controller="FollowUps"
                               asp-action="Index">
                                <i class="bi bi-calendar-check"></i>Follow-ups
                            </a>
                        </li>
                    }
                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Analysis" ? "active" : "")"
                           href="/Analysis">
                            <i class="bi bi-clipboard2-pulse"></i>Analysis
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin") || User.IsInRole("Nutritionist"))
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Nutrition" ? "active" : "")"
                           href="/Nutrition/Packages">
                            <i class="bi bi-capsule"></i>Nutrition
                        </a>
                    </li>
                }

                @* Payment access: keep menus aligned with the server-side billing policies. *@
                @if (User.IsInRole("Admin") || User.IsInRole("Reception") || User.IsInRole("ReceptionAdmin") || User.IsInRole("Doctor"))
                {
                    <li class="nav-section-label" role="presentation">Billing</li>
                    @if (User.IsInRole("Admin") || User.IsInRole("Reception") || User.IsInRole("ReceptionAdmin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Payments" && currentAction != "Report" ? "active" : "")" asp-controller="Payments" asp-action="Dashboard">
                                <i class="bi bi-cash-coin"></i>@(User.IsInRole("Admin") ? "Payment Dashboard" : "Unpaid Payments")
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "Payments" && currentAction == "Report" ? "active" : "")" asp-controller="Payments" asp-action="Report">
                            <i class="bi bi-file-earmark-bar-graph"></i>Payment Reports
                        </a>
                    </li>
                }

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-section-label" role="presentation">Administration</li>
       
                    @* Role lookup: Users now lives alongside Roles under System Lookups below. *@
                }
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            @* Role lookup: retain active navigation while managing users or roles. *@
                            <a class="nav-link dropdown-toggle @(currentController is "Lookups" or "Users" or "Roles" or "PatientSources" or "Clinics" ? "active" : "")" href="#" id="lookupsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-sliders me-1"></i>System Lookups
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="lookupsDropdown">
                                <li><a class="dropdown-item" asp-controller="Lookups" asp-action="Index"><i class="bi bi-grid-fill me-2"></i>All Lookups</a></li>
                                @* Role lookup: both destinations enforce AdminOnly independently of this menu. *@
                                <li><a class="dropdown-item @(currentController == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear me-2"></i>Users</a></li>
                                <li><a class="dropdown-item @(currentController == "Roles" ? "active" : "")" asp-controller="Roles" asp-action="Index"><i class="bi bi-shield-lock me-2"></i>Roles</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Lookups" asp-action="AnalysisTypes"><i class="bi bi-journal-medical me-2"></i>Analysis Types</a></li>
                                <li><a class="dropdown-item" asp-controller="Lookups" asp-action="TreatmentTypes"><i class="bi bi-bandaid me-2"></i>Treatment Types</a></li>
                                <li><a class="dropdown-item" asp-controller="Lookups" asp-action="InjectionTypes"><i class="fa-solid fa-syringe fa-lg text-warning me-2"></i>Injection Types</a></li>
                                <li><a class="dropdown-item" asp-controller="Lookups" asp-action="VitaminTypes"><i class="bi bi-capsule me-2"></i>Vitamin Types</a></li>
                                <li><a class="dropdown-item" asp-controller="PatientSources" asp-action="Index"><i class="bi bi-diagram-3 me-2"></i>Patient Sources</a></li>
                                <li><a class="dropdown-item" asp-controller="Clinics" asp-action="Index"><i class="bi bi-hospital me-2"></i>Clinics</a></li>
                            </ul>
                        </li>
                    }
            </ul>

            <div class="sidebar-footer p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="brand-mark" style="width:30px;height:30px;font-size:0.8rem;">
                        @(User.Identity!.Name?.Trim().FirstOrDefault().ToString().ToUpper())
                    </span>
                    <span class="small fw-semibold text-truncate">@User.Identity!.Name</span>
                </div>
                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        <i class="bi bi-box-arrow-left me-1"></i>Logout
                    </button>
                </form>
            </div>
        </nav>

        <!-- ── Main content ── -->
        <div class="app-content flex-grow-1 d-flex flex-column">

            <!-- Top bar -->
            <header class="topbar app-topbar d-flex align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3 min-width-0">
                    <button type="button"
                            class="btn btn-outline-secondary app-menu-toggle d-lg-none"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebar"
                            aria-controls="sidebar"
                            aria-label="Open navigation">
                        <i class="bi bi-list fs-5" aria-hidden="true"></i>
                    </button>

                    <h6 class="mb-0 text-truncate">@ViewData["Title"]</h6>
                </div>

                <small class="text-muted text-nowrap d-none d-md-block">
                    @DateTime.Now.ToString("dddd, dd MMM yyyy")
                </small>
            </header>

            <main id="mainContent" class="app-main flex-grow-1" tabindex="-1">

                <!-- Alert toasts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
