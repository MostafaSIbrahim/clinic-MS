<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Safya Clinic</title>
    @* F6: every asset is served by the app (wwwroot/lib), so screens work without internet access. *@
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    @* F6: design tokens, then the bridge that feeds them into Bootstrap, then the app styles. *@
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* Branding: shared logo styles also used by standalone clinic documents. *@
    <link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" />
    
</head>
<body>

@if (User.Identity?.IsAuthenticated == true)
{
    <a href="#mainContent" class="app-skip-link">
        Skip to main content
    </a>
    <div class="d-flex" id="wrapper">

        <!-- ── Sidebar ── -->
        <nav id="sidebar"
             class="offcanvas-lg offcanvas-start d-flex flex-column p-0"
             tabindex="-1"
             aria-labelledby="sidebarTitle">
            <div class="px-3 py-4 d-flex align-items-center gap-2">
                @* Branding: the approved logo replaces the placeholder heart on all application pages. *@
                <span id="sidebarTitle" class="visually-hidden">Safya Clinic navigation</span>
                <a asp-controller="Dashboard" asp-action="Index" class="clinic-brand-link">
                    @await Html.PartialAsync("_ClinicLogo", "clinic-logo--sidebar")
                </a>
               <button type="button"
                        class="btn-close d-lg-none ms-auto"
                        data-bs-dismiss="offcanvas"
                        data-bs-target="#sidebar"
                        aria-label="Close navigation"></button>
            </div>

            @* F7: the menu is built from the navigation catalogue and the user's permissions. *@
            <div class="app-nav mt-1 flex-grow-1">
                @await Component.InvokeAsync("SidebarNav")
            </div>

        </nav>

        <!-- ── Main content ── -->
        <div class="app-content flex-grow-1 d-flex flex-column">

            <!-- Top bar (F7b): menu toggle, page title, patient search, account menu -->
            @{
                var displayName = User.Identity!.Name ?? "Account";
                var initial = displayName.Trim().FirstOrDefault().ToString().ToUpperInvariant();
            }
            <header class="topbar app-topbar d-flex align-items-center gap-3">
                <button type="button"
                        class="btn btn-outline-secondary app-menu-toggle d-lg-none"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#sidebar"
                        aria-controls="sidebar"
                        aria-label="Open navigation">
                    <i class="bi bi-list fs-5" aria-hidden="true"></i>
                </button>

                <span class="app-topbar-title text-truncate d-none d-sm-inline">@ViewData["Title"]</span>

                @if (await Can.HasAsync(Permissions.Patients.View))
                {
                    <form class="app-topbar-search ms-auto" role="search" method="get" asp-controller="Patients" asp-action="Index">
                        <label for="topbarPatientSearch" class="visually-hidden">Find a patient by name or phone</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text" aria-hidden="true"><i class="bi bi-search"></i></span>
                            <input id="topbarPatientSearch" type="search" name="search" class="form-control"
                                   placeholder="Find patient: name or phone" autocomplete="off" />
                        </div>
                    </form>
                }
                else
                {
                    <span class="ms-auto"></span>
                }

                <small class="text-muted text-nowrap d-none d-xl-inline">@Clock.Now.ToString("ddd, dd MMM yyyy")</small>

                <div class="dropdown">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="brand-mark app-avatar" aria-hidden="true">@initial</span>
                        <span class="d-none d-md-inline text-truncate app-user-name">@displayName</span>
                        <span class="visually-hidden">Account menu</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><span class="dropdown-item-text small text-muted">Signed in as <strong class="d-block text-body">@displayName</strong></span></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword">
                                <i class="bi bi-key me-2" aria-hidden="true"></i>Change password
                            </a>
                        </li>
                        <li>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-box-arrow-left me-2" aria-hidden="true"></i>Sign out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>

            <main id="mainContent" class="app-main flex-grow-1" tabindex="-1">

                <!-- Alert toasts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Warning"]
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    @RenderBody()
}

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
