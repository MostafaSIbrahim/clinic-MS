@model SafyaClinic.Application.DTOs.Payment.PaymentLineDetailReportDto

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <div class="fw-semibold fs-5">@Model.GroupLabel</div>
        <div class="text-muted small">
            @(Model.From.HasValue ? Model.From.Value.ToString("dd MMM yyyy") : "Earliest record")
            &ndash;
            @(Model.To.HasValue ? Model.To.Value.ToString("dd MMM yyyy") : "Today")
        </div>
    </div>
    <div class="text-end">
        <div class="small text-muted">Total Paid</div>
        <div class="fw-bold text-success">@Model.TotalAmountPaid.ToString("C")</div>
    </div>
    <div class="text-end">
        <div class="small text-muted">Total Deducted</div>
        <div class="fw-bold text-warning">@Model.TotalDeducted.ToString("C")</div>
    </div>
</div>

@if (!Model.Lines.Any())
{
    @if (Model.TotalPaymentsAllTime > 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i>
            No payments for <strong>@Model.GroupLabel</strong> fall in the selected date range, but this group
            has <strong>@Model.TotalPaymentsAllTime</strong> payment(s) on record overall, dated between
            <strong>@Model.EarliestPaymentDate?.ToString("dd MMM yyyy")</strong> and
            <strong>@Model.LatestPaymentDate?.ToString("dd MMM yyyy")</strong>.
            Try widening the date range, or
            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" onclick="window.paymentDrilldown && window.paymentDrilldown.viewAllTime()">
                view all time
            </button>.
        </div>
    }
    else
    {
        <div class="text-center text-muted py-4">No payments found for this group at all.</div>
    }
}
else
{
    <div style="max-height:420px; overflow:auto;">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light" style="position:sticky; top:0;">
                <tr>
                    <th>Patient</th>
                    <th>Date</th>
                    <th>Method</th>
                    <th>Reference</th>
                    <th class="text-end">Amount Paid</th>
                    <th class="text-end">Deducted</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.PatientName</td>
                        <td>@line.PaymentDate.ToString("dd MMM yyyy")</td>
                        <td>@line.PaymentMethod</td>
                        <td class="text-muted">@(string.IsNullOrWhiteSpace(line.ReferenceNumber) ? "—" : line.ReferenceNumber)</td>
                        <td class="text-end fw-semibold">@line.AmountPaid.ToString("C")</td>
                        <td class="text-end text-warning">@(line.DeductedAmount > 0 ? line.DeductedAmount.ToString("C") : "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
