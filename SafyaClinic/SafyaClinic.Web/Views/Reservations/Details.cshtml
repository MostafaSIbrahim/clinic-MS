@using System.Security.Claims
@model ReservationDto
@using SafyaClinic.Domain.Enums
@{
    ViewData["Title"] = "Reservation Details";
    var canCheckIn =
    (User.IsInRole("Reception") || User.IsInRole("Admin")) &&
    Model.ReservationDate.Date == DateTime.Today &&
   (Model.StatusName == "Pending" || Model.StatusName == "Confirmed") &&
    Model.QueueStatus == PatientQueueStatus.NotCheckedIn &&
    Model.CheckedInAtUtc is null;

    var queueLabel = Model.QueueStatus switch
    {
        PatientQueueStatus.NotCheckedIn => "Not checked in",
        PatientQueueStatus.Waiting => "Waiting",
        PatientQueueStatus.InConsultation => "In consultation",
        PatientQueueStatus.Finished => "Finished",
        PatientQueueStatus.Left => "Left",
        _ => "Unknown"
    };
    var hasUserId = int.TryParse(
        User.FindFirst(ClaimTypes.NameIdentifier)?.Value,
        out var currentUserId);

    var canStartConsultation =
        hasUserId &&
        (User.IsInRole("Admin") ||
         (User.IsInRole("Doctor") && Model.DoctorId == currentUserId)) &&
        (Model.StatusName == "Confirmed") &&
        Model.QueueStatus == PatientQueueStatus.Waiting &&
        Model.CheckedInAtUtc.HasValue &&
        Model.ConsultationStartedAtUtc is null;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="mb-0">Reservation #@Model.Id</h4>
        <small class="text-muted">@Model.ReservationDate.ToString("dd MMM yyyy") at @Model.ReservationTime.ToString(@"hh\:mm")</small>
    </div>
    <div class="d-flex gap-2">
        @if (Model.StatusName == "Completed")
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    disabled
                    title="Completed reservations cannot be edited.">
                <i class="bi bi-pencil me-1"></i>Edit
            </button>
        }
        else
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        }
        @if (Model.StatusName != "Cancelled" && Model.StatusName != "Completed")
        {
            <form asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('Cancel this reservation?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </button>
            </form>
        }
    </div>
</div>
<!-- Queue Status -->
<div class="card mb-3">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="small text-muted mb-1">Patient Queue</div>
            <div class="fw-semibold">
                <i class="bi bi-person-check me-1"></i>@queueLabel
            </div>

            @if (Model.CheckedInAtUtc.HasValue)
            {
                <div class="small text-muted mt-1">
                    Checked in:
                    @Model.CheckedInAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC
                </div>
            }
        </div>

        @if (canCheckIn)
        {
            <form asp-action="CheckIn"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-person-check me-1"></i>Check In
                </button>
            </form>
        }
        @if (canStartConsultation)
        {
            <form asp-action="StartConsultation"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-play-circle me-1"></i>Start Consultation
                </button>
            </form>
        }
        @if (Model.ConsultationStartedAtUtc.HasValue)
        {
            <div class="small text-muted mt-1">
                Consultation started:
                @Model.ConsultationStartedAtUtc.Value.ToString("dd MMM yyyy HH:mm") UTC
            </div>
        }
    </div>
</div>
<!-- Details and Actions -->
<div class="row g-3">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header"><i class="bi bi-info-circle me-2"></i>Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-4 text-muted">Patient</dt>
                    <dd class="col-8">@Model.PatientName</dd>
                    <dt class="col-4 text-muted">Doctor</dt>
                    <dd class="col-8">@Model.DoctorName</dd>
                    <dt class="col-4 text-muted">Treatment Type</dt>
                    <dd class="col-8">@Model.TreatmentTypeName</dd>
                    <dt class="col-4 text-muted">Category</dt>
                    <dd class="col-8"><span class="badge bg-secondary">@Model.Category</span></dd>
                    <dt class="col-4 text-muted">Status</dt>
                    <dd class="col-8"><span class="badge" style="background-color:@Model.StatusColor;color:#fff;">@Model.StatusName</span></dd>
                    <dt class="col-4 text-muted">Duration</dt>
                    <dd class="col-8">@Model.DurationMinutes minutes</dd>
                    <dt class="col-4 text-muted">Reason</dt>
                    <dd class="col-8">@(Model.Reason ?? "—")</dd>
                    <dt class="col-4 text-muted">Notes</dt>
                    <dd class="col-8">@(Model.Notes ?? "—")</dd>
                    <dt class="col-4 text-muted">Amount</dt>
                    <dd class="col-8">@(Model.TotalAmount?.ToString("C") ?? "—")</dd>
                    <dt class="col-4 text-muted">Paid</dt>
                    <dd class="col-8">@await Html.PartialAsync("_PaymentStatusToggle", (Model.Id, Model.PatientId, Model.IsPaid))</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-arrow-repeat me-2"></i>Update Status</div>
            <div class="card-body">
                @{ var isCompleted = Model.StatusName == "Completed"; }
                <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <select name="statusId" class="form-select form-select-sm" disabled="@isCompleted">
                        <option value="1" selected="@(Model.StatusName == "Pending")">Pending</option>
                        <option value="2" selected="@(Model.StatusName == "Confirmed")">Confirmed</option>
                        <option value="3" selected="@(Model.StatusName == "Completed")">Completed</option>
                        <option value="4" selected="@(Model.StatusName == "Cancelled")">Cancelled</option>
                        <option value="5" selected="@(Model.StatusName == "NoShow")">NoShow</option>
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary" disabled="@isCompleted">Update</button>
                </form>
                @if (isCompleted)
                {
                    <small class="text-muted d-block mt-2">This reservation is completed and its status can no longer be changed.</small>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header"><i class="bi bi-cash-coin me-2"></i>Payment</div>
            <div class="card-body d-flex gap-2">
                @if (!Model.IsPaid)
                {
                    <a asp-controller="Payments" asp-action="Collect" asp-route-patientId="@Model.PatientId"
                       asp-route-reservationId="@Model.Id" class="btn btn-sm btn-success w-100">
                        <i class="bi bi-cash me-1"></i>Collect Payment
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary w-100" disabled title="No payment required">
                        <i class="bi bi-check-circle me-1"></i>Fully Paid — No Payment Required
                    </button>
                }
            </div>
        </div>

        @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
        {
            <div class="card">
                <div class="card-header"><i class="bi bi-file-medical me-2"></i>Clinical</div>
                <div class="card-body">
                    <a asp-controller="MedicalRecords" asp-action="Create"
                       asp-route-patientId="@Model.PatientId" asp-route-reservationId="@Model.Id"
                       class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-plus-lg me-1"></i>Create Medical Record
                    </a>
                </div>
            </div>
        }
    </div>
</div>
