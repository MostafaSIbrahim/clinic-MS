@model ReservationSummaryDto

<div class="card shadow-sm mb-2">
    <div class="card-body p-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="text-primary">
                @Model.ReservationTime.ToString(@"hh\:mm")
            </strong>
            <span class="badge @(Model.IsPaid ? "bg-success" : "bg-warning text-dark")">
                @(Model.IsPaid ? "Paid" : "Unpaid")
            </span>
        </div>

        <a asp-controller="Patients"
           asp-action="Details"
           asp-route-id="@Model.PatientId"
           class="fw-semibold text-decoration-none">
            @Model.PatientName
        </a>

        <div class="small text-muted mt-2">
            <div><i class="bi bi-person me-1"></i>@Model.DoctorName</div>
            <div><i class="bi bi-hospital me-1"></i>@Model.ClinicName</div>
            <div class="mt-1">@Model.TreatmentTypeName</div>
            <div class="mt-1">Status: @Model.StatusName</div>
        </div>

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-sm btn-outline-primary w-100 mt-3">
            View Reservation
        </a>
    </div>
</div>