@model CreateReservationRequest
@using SafyaClinic.Application.DTOs.Patient
@using SafyaClinic.Application.DTOs.Settings
@using SafyaClinic.Application.DTOs.MedicalRecord
@{
    ViewData["Title"] = "New Reservation";
    var doctors = ViewBag.Doctors as IEnumerable<UserDto> ?? Enumerable.Empty<UserDto>();
    var clinics = ViewBag.Clinics as IEnumerable<ClinicDto> ?? Enumerable.Empty<ClinicDto>();
    var treatmentTypes = ViewBag.TreatmentTypes as IEnumerable<TreatmentTypeDto> ?? Enumerable.Empty<TreatmentTypeDto>();
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-calendar-plus me-2"></i>Book New Reservation</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="PatientId" class="form-label">Patient ID *</label>
                    <input asp-for="PatientId" type="number" class="form-control" required />
                    <small class="text-muted">Enter the patient ID (found on their profile page).</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="DoctorId" class="form-label">Doctor *</label>
                    <select asp-for="DoctorId" class="form-select" required>
                        <option value="">— Select Doctor —</option>
                        @foreach (var d in doctors)
                        {
                            <option value="@d.Id">@d.FullName @(d.Specialization != null ? $"({d.Specialization})" : "")</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="ClinicId" class="form-label">Clinic *</label>
                    <select asp-for="ClinicId" class="form-select" required>
                        <option value="">— Select Clinic —</option>
                        @foreach (var c in clinics)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="TreatmentTypeId" class="form-label">Treatment Type *</label>
                    <select asp-for="TreatmentTypeId" id="treatmentTypeSelect" class="form-select" required>
                        <option value="">— Select Treatment Type —</option>
                        @foreach (var t in treatmentTypes)
                        {
                            <option value="@t.Id"
                                    data-cost="@(t.DefaultCost?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                    data-duration="@t.DurationMinutes">
                                @t.TypeName @(t.DefaultCost != null ? $"— {t.DefaultCost:C}" : "")
                            </option>
                        }
                    </select>
                    <small class="text-muted">Sets the price for this reservation automatically.</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label">Category *</label>
                    <select asp-for="Category" class="form-select">
                        <option value="InternalMedicine">Internal Medicine</option>
                        <option value="Nutritional">Nutritional</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
                    <input asp-for="DurationMinutes" id="durationInput" type="number" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="ReservationDate" class="form-label">Date *</label>
                    <input asp-for="ReservationDate" type="date" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="ReservationTime" class="form-label">Time *</label>
                    <input asp-for="ReservationTime" type="time" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="TotalAmount" class="form-label">Amount</label>
                    <input asp-for="TotalAmount" id="totalAmountInput" type="number" step="0.01" class="form-control" />
                    <small class="text-muted">Auto-filled from the treatment type's price — adjust if needed.</small>
                </div>

                <div class="col-12">
                    <label asp-for="Reason" class="form-label">Reason</label>
                    <input asp-for="Reason" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Book Reservation</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        document.getElementById('treatmentTypeSelect').addEventListener('change', function () {
            var opt = this.options[this.selectedIndex];
            var cost = opt.getAttribute('data-cost');
            var duration = opt.getAttribute('data-duration');
            if (cost) document.getElementById('totalAmountInput').value = cost;
            if (duration) document.getElementById('durationInput').value = duration;
        });
    </script>
}
