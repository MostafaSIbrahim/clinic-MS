@model CreateReservationRequest
@using SafyaClinic.Application.DTOs.Patient
@using SafyaClinic.Application.DTOs.Settings
@using SafyaClinic.Application.DTOs.MedicalRecord
@{
    ViewData["Title"] = "New Reservation";
    var doctors = ViewBag.Doctors as IEnumerable<UserDto> ?? Enumerable.Empty<UserDto>();
    var clinics = ViewBag.Clinics as IEnumerable<ClinicDto> ?? Enumerable.Empty<ClinicDto>();
    var treatmentTypes = ViewBag.TreatmentTypes as IEnumerable<TreatmentTypeDto> ?? Enumerable.Empty<TreatmentTypeDto>();
}

<div class="card" style="max-width:700px;">
    <div class="card-header"><i class="bi bi-calendar-plus me-2"></i>Book New Reservation</div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            <div class="row g-3">
                <!-- Patient Search (hidden ID + visible search) -->
                <div class="col-md-6">
                    <label class="form-label">Patient *</label>
                    <input type="hidden" asp-for="PatientId" id="patientIdHidden" />
                    <div class="position-relative">
                        <input type="text" id="patientSearchInput" class="form-control"
                               placeholder="Search by name or mobile number..."
                               value="@(ViewBag.SelectedPatientName ?? "")"
                               autocomplete="off" required />
                    </div>
                    <small class="text-muted">Type at least 2 characters to search.</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="DoctorId" class="form-label">Doctor *</label>
                    <select asp-for="DoctorId" class="form-select" required>
                        <option value="">— Select Doctor —</option>
                        @foreach (var d in doctors)
                        {
                            <option value="@d.Id">@d.FullName @(d.Specialization != null ? $"({d.Specialization})" : "")</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="ClinicId" class="form-label">Clinic *</label>
                    <select asp-for="ClinicId" class="form-select" required>
                        <option value="">— Select Clinic —</option>
                        @foreach (var c in clinics)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="TreatmentTypeId" class="form-label">Treatment Type *</label>
                    <select asp-for="TreatmentTypeId" id="treatmentTypeSelect" class="form-select" required>
                        <option value="">— Select Treatment Type —</option>
                        @foreach (var t in treatmentTypes)
                        {
                            <option value="@t.Id"
                                    data-cost="@(t.DefaultCost?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                    data-duration="@t.DurationMinutes">
                                @t.TypeName @(t.DefaultCost != null ? $"— {t.DefaultCost:C}" : "")
                            </option>
                        }
                    </select>
                    <small class="text-muted">Sets the price for this reservation automatically.</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="Category" class="form-label">Category *</label>
                    <select asp-for="Category" class="form-select">
                        <option value="InternalMedicine">Internal Medicine</option>
                        <option value="Nutritional">Nutritional</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="DurationMinutes" class="form-label">Duration (minutes)</label>
                    <input asp-for="DurationMinutes" id="durationInput" type="number" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="ReservationDate" class="form-label">Date *</label>
                    <input asp-for="ReservationDate" type="date" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="ReservationTime" class="form-label">Time *</label>
                    <input asp-for="ReservationTime" type="time" class="form-control" required />
                </div>

                <div class="col-md-6">
                    <label asp-for="TotalAmount" class="form-label">Amount</label>
                    <input asp-for="TotalAmount" id="totalAmountInput" type="number" step="0.01" class="form-control" />
                    <small class="text-muted">Auto-filled from the treatment type's price — adjust if needed.</small>
                </div>

                <div class="col-12">
                    <button type="button" class="btn btn-outline-success btn-sm" onclick="openNewPatientWindow()">
                        <i class="bi bi-person-plus me-1"></i>Register New Patient
                    </button>
                </div>

                <div class="col-12">
                    <label asp-for="Reason" class="form-label">Reason</label>
                    <input asp-for="Reason" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Book Reservation</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // ── Patient Autocomplete ─────────────────────────────────
        (function() {
            const searchInput = document.getElementById('patientSearchInput');
            const hiddenInput = document.getElementById('patientIdHidden');

            function debounce(fn, delayMs) {
                let timer = null;
                return function(...args) {
                    clearTimeout(timer);
                    timer = setTimeout(() => fn.apply(this, args), delayMs);
                };
            }

            function escapeHtml(s) {
                if (s == null) return '';
                return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            const list = document.createElement('div');
            list.className = 'list-group shadow-sm';
            list.style.cssText = 'position:absolute;z-index:1050;top:100%;left:0;right:0;max-height:260px;overflow-y:auto;display:none;';
            searchInput.parentElement.style.position = 'relative';
            searchInput.parentElement.appendChild(list);
            searchInput.setAttribute('autocomplete', 'off');

            let activeItems = [];
            let activeIndex = -1;

            function hide() {
                list.style.display = 'none';
                list.innerHTML = '';
                activeItems = [];
                activeIndex = -1;
            }

            function highlight(index) {
                Array.from(list.children).forEach((c, i) => c.classList.toggle('active', i === index));
                activeIndex = index;
            }

            function render(items) {
                activeItems = items;
                if (!items.length) { hide(); return; }
                list.innerHTML = '';
                items.forEach((patient, i) => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'list-group-item list-group-item-action py-2';
                    item.innerHTML =
                        '<div class="d-flex justify-content-between">' +
                        '<span><strong>' + escapeHtml(patient.fullName) + '</strong>' +
                        ' <span class="text-muted small">#' + patient.id + '</span></span>' +
                        '<span class="text-muted small">' + escapeHtml(patient.primaryPhone) + '</span>' +
                        '</div>' +
                        '<div class="small text-muted">' +
                        (patient.nationalId ? 'ID: ' + escapeHtml(patient.nationalId) + ' • ' : '') +
                        (patient.age ? patient.age + ' yrs' : '') +
                        '</div>';
                    item.addEventListener('mousedown', function(e) {
                        e.preventDefault();
                        searchInput.value = patient.fullName + (patient.primaryPhone ? ' — ' + patient.primaryPhone : '');
                        hiddenInput.value = patient.id;
                        hide();
                    });
                    list.appendChild(item);
                });
                list.style.display = 'block';
                activeIndex = -1;
            }

            const doSearch = debounce(function(term) {
                fetch('/api/patients/search?query=' + encodeURIComponent(term), { credentials: 'same-origin' })
                    .then(r => r.ok ? r.json() : [])
                    .then(render)
                    .catch(() => hide());
            }, 300);

            searchInput.addEventListener('input', function() {
                const term = searchInput.value.trim();
                if (term.length < 2) { hide(); return; }
                doSearch(term);
            });

            searchInput.addEventListener('keydown', function(e) {
                if (list.style.display === 'none') return;
                if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(activeIndex + 1, activeItems.length - 1)); }
                else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(activeIndex - 1, 0)); }
                else if (e.key === 'Enter') {
                    if (activeIndex >= 0 && activeItems[activeIndex]) {
                        e.preventDefault();
                        const p = activeItems[activeIndex];
                        searchInput.value = p.fullName + (p.primaryPhone ? ' — ' + p.primaryPhone : '');
                        hiddenInput.value = p.id;
                        hide();
                    }
                } else if (e.key === 'Escape') {
                    hide();
                }
            });

            searchInput.addEventListener('blur', function() {
                setTimeout(hide, 150);
            });
        })();

        // ── Treatment Type Auto-fill ─────────────────────────────
        document.getElementById('treatmentTypeSelect').addEventListener('change', function() {
            var opt = this.options[this.selectedIndex];
            var cost = opt.getAttribute('data-cost');
            var duration = opt.getAttribute('data-duration');
            if (cost) document.getElementById('totalAmountInput').value = cost;
            if (duration) document.getElementById('durationInput').value = duration;
        });

        // ── New Patient Popup ────────────────────────────────────
        function openNewPatientWindow() {
            var w = window.open('/Patients/Create?popup=true', 'NewPatient', 'width=900,height=700,scrollbars=yes,resizable=yes');
            if (!w) {
                alert('Please allow popups to register a new patient.');
            }
        }

        window.addEventListener('message', function(e) {
            if (e.data && e.data.type === 'NEW_PATIENT_CREATED') {
                var patient = e.data.patient;
                document.getElementById('patientIdHidden').value = patient.id;
                document.getElementById('patientSearchInput').value = patient.fullName + (patient.primaryPhone ? ' — ' + patient.primaryPhone : '');
            }
        });
    </script>
}