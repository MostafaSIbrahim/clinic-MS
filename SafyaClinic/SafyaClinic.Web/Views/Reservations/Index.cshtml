@model PagedResult<ReservationSummaryDto>
@{
    ViewData["Title"] = "Reservations";
    var filter = ViewBag.Filter as ReservationFilterRequest;
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar2-week me-2"></i>Reservations</span>
        <div class="d-flex gap-2">
            <a asp-action="Today" class="btn btn-sm btn-outline-secondary"><i class="bi bi-calendar-day me-1"></i>Today</a>
            <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>New Reservation</a>
        </div>
    </div>
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-md-2">
                <input type="date" name="DateFrom" value="@filter?.DateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <input type="date" name="DateTo" value="@filter?.DateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <select name="Category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    <option value="InternalMedicine" selected="@(filter?.Category == "InternalMedicine")">Internal Medicine</option>
                    <option value="Nutritional" selected="@(filter?.Category == "Nutritional")">Nutritional</option>
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>

        @if (Model == null || !Model.Items.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>
                No reservations found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Patient</th>
                            <th>Doctor</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Paid</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items)
                        {
                            <tr>
                                <td>@r.ReservationDate.ToString("dd MMM yyyy")</td>
                                <td>@r.ReservationTime.ToString(@"hh\:mm")</td>
                                <td>@r.PatientName</td>
                                <td>@r.DoctorName</td>
                                <td><span class="badge bg-secondary">@r.Category</span></td>
                                <td><span class="badge" style="background-color:@r.StatusColor;color:#fff;">@r.StatusName</span></td>
                                <td>
                                    @if (r.IsPaid)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (Model != null && Model.TotalPages > 1)
        {
            ViewData["PaginationAction"] = "Index";
            var paginationModel = new PagedResult<object>
            {
                TotalCount = Model.TotalCount,
                Page = Model.Page,
                PageSize = Model.PageSize
            };
            @await Html.PartialAsync("_Pagination", paginationModel)
        }
    </div>
</div>