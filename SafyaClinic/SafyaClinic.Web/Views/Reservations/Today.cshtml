@model IEnumerable<ReservationSummaryDto>
@{
    ViewData["Title"] = "Today's Reservations";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-day me-2"></i>Today — @DateTime.Today.ToString("dd MMM yyyy")</span>
        <a asp-action="Create" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg me-1"></i>New Reservation</a>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>
                No reservations today.
            </div>
        }
        else
        {
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr><th>Time</th><th>Patient</th><th>Doctor</th><th>Category</th><th>Status</th><th>Paid</th></tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.OrderBy(r => r.ReservationTime))
                    {
                        <tr>
                            <td>@r.ReservationTime.ToString(@"hh\:mm")</td>
                            <td>@r.PatientName</td>
                            <td>@r.DoctorName</td>
                            <td><span class="badge bg-secondary">@r.Category</span></td>
                            <td><span class="badge" style="background-color:@r.StatusColor;color:#fff;">@r.StatusName</span></td>
                            <td>@(r.IsPaid ? "✅" : "❌")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
