<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafyaClinic.Application\SafyaClinic.Application.csproj" />
    <ProjectReference Include="..\SafyaClinic.Domain\SafyaClinic.Domain.csproj" />
    <ProjectReference Include="..\SafyaClinic.Infrastructure\SafyaClinic.Infrastructure.csproj" />
  </ItemGroup>
	<ItemGroup>
		<Content Remove="wwwroot\uploads\desktop.ini" />
	</ItemGroup>
  <!-- Deployment protection: server-owned settings and patient uploads are never published. Local builds still use local settings. -->
  <ItemGroup>
    <Content Update="appsettings*.json;wwwroot/uploads/**/*" CopyToPublishDirectory="Never" />
    <MsDeploySkipRules Include="PreserveServerSettings">
      <ObjectName>filePath</ObjectName>
      <AbsolutePath>(?i)(^|[\\/])appsettings([^\\/]*)\.json$</AbsolutePath>
    </MsDeploySkipRules>
    <MsDeploySkipRules Include="PreservePatientUploads">
      <ObjectName>dirPath</ObjectName>
      <AbsolutePath>(?i)(^|[\\/])wwwroot[\\/]uploads($|[\\/])</AbsolutePath>
    </MsDeploySkipRules>
  </ItemGroup>
</Project>
