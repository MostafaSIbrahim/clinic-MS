@{
    ViewData["Title"] = "Dashboard";
    var todayReservations = ViewBag.TodayReservations as IEnumerable<ReservationSummaryDto> ?? Enumerable.Empty<ReservationSummaryDto>();
    var todayRevenue = ViewBag.TodayRevenue as decimal? ?? 0m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-primary">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard
    </h2>
    <span class="text-muted">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</span>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Today's Appointments</p>
                        <h3 class="fw-bold mb-0">@todayReservations.Count()</h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-calendar-check text-primary fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Completed</p>
                        <h3 class="fw-bold mb-0 text-success">@todayReservations.Count(r => r.StatusName == "Completed")</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-check-circle text-success fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Pending</p>
                        <h3 class="fw-bold mb-0 text-warning">@todayReservations.Count(r => r.StatusName == "Pending" || r.StatusName == "Confirmed")</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-clock-history text-warning fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0dcaf0 !important;">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <p class="text-muted mb-1 small text-uppercase fw-bold">Today's Revenue</p>
                        <h3 class="fw-bold mb-0">@todayRevenue.ToString("C")</h3>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-3 p-2">
                        <i class="bi bi-cash-stack text-info fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom-0 pt-3">
                <h5 class="fw-bold mb-0"><i class="bi bi-lightning-charge me-2"></i>Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <a href="/Patients/Create" class="btn btn-outline-primary w-100 py-3">
                            <i class="bi bi-person-plus fs-3 d-block mb-2"></i>
                            New Patient
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/Reservations/Create" class="btn btn-outline-success w-100 py-3">
                            <i class="bi bi-calendar-plus fs-3 d-block mb-2"></i>
                            Book Appointment
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/Payments/Collect" class="btn btn-outline-info w-100 py-3">
                            <i class="bi bi-cash-coin fs-3 d-block mb-2"></i>
                            Collect Payment
                        </a>
                    </div>
                    <div class="col-md-3">
                        <a href="/Reservations/Today" class="btn btn-outline-warning w-100 py-3">
                            <i class="bi bi-list-check fs-3 d-block mb-2"></i>
                            Today's Schedule
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Today's Appointments -->
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0"><i class="bi bi-calendar-day me-2"></i>Today's Appointments</h5>
                <a href="/Reservations/Today" class="btn btn-sm btn-primary">
                    <i class="bi bi-eye me-1"></i>View All
                </a>
            </div>
            <div class="card-body p-0">
                @if (!todayReservations.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 mb-3 d-block"></i>
                        <p>No appointments scheduled for today.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Time</th>
                                    <th>Patient</th>
                                    <th>Doctor</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Paid</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in todayReservations.OrderBy(r => r.ReservationTime))
                                {
                                    <tr>
                                        <td class="fw-bold">@r.ReservationTime.ToString("hh\\:mm")</td>
                                        <td>
                                            <a href="/Patients/Details/@r.Id" class="text-decoration-none fw-semibold">
                                                @r.PatientName
                                            </a>
                                        </td>
                                        <td>@r.DoctorName</td>
                                        <td>
                                            <span class="badge @(r.Category == "Nutritional" ? "bg-info" : "bg-secondary")">
                                                @r.Category
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge" style="background-color: @r.StatusColor">
                                                @r.StatusName
                                            </span>
                                        </td>
                                        <td>
                                            @if (r.IsPaid)
                                            {
                                                <span class="badge bg-success"><i class="bi bi-check"></i></span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger"><i class="bi bi-x"></i></span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="/Reservations/Details/@r.Id" class="btn btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                @if (r.StatusName == "Confirmed" || r.StatusName == "Pending")
                                                {
                                                    <a href="/MedicalRecords/Create?patientId=@r.Id&reservationId=@r.Id"
                                                       class="btn btn-outline-success" title="Start Visit">
                                                        <i class="bi bi-file-medical"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh every 5 minutes
        setTimeout(function() {
            location.reload();
        }, 300000);
    </script>
}