@{
    ViewData["Title"] = "Error";
    var message = ViewBag.ErrorMessage as string ?? "An unexpected error occurred.";
}

<div class="container py-5 text-center">
    <div class="mb-4">
        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 5rem;"></i>
    </div>
    <h1 class="display-4 fw-bold text-danger mb-3">Oops!</h1>
    <h3 class="mb-4">Something went wrong</h3>
    <p class="lead text-muted mb-4">@message</p>
    <a href="/Dashboard" class="btn btn-primary btn-lg">
        <i class="bi bi-house-door me-2"></i>Back to Dashboard
    </a>
</div>